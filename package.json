{
  "name": "perfectacle-blog",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-post-links.ts && node scripts/copy-post-assets.ts && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro sync && tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "verify:urls": "node scripts/check-legacy-urls.ts",
    "verify:dist": "node scripts/check-dist.ts",
    "test:e2e": "playwright test",
    "audit": "pnpm audit --prod --audit-level high"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "astro": "7.3.8",
    "pagefind": "1.5.2",
    "pretendard": "1.3.9",
    "rehype-external-links": "3.0.0",
    "remark-breaks": "4.0.0",
    "sharp": "0.35.5",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "fast-xml-parser": "5.11.2",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "rehype-stringify": "10.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.1",
    "unified": "11.0.5",
    "vfile": "6.0.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.12.1+sha512.b7f98934c0b1f29a65f5da52f2d7f994e7faad573ffdddea1497fb4dcb5aec051590ee7c7d95a38172b4bfae103a5b83edf2ee866e11731c2cafa96063610ac5"
}
