{
  "name": "perfectacle-blog",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-post-links.ts && node scripts/check-series.ts && node scripts/copy-post-assets.ts && node scripts/minify-assets.ts && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro sync && tsc",
    "lint": "eslint .",
    "lint:images": "node scripts/check-images.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "verify:urls": "node scripts/check-published-urls.ts",
    "verify:dist": "node scripts/check-dist.ts",
    "test:e2e": "playwright test --project desktop --project mobile",
    "audit": "pnpm audit --prod --audit-level high",
    "test:lighthouse": "playwright test --project lighthouse --workers 1",
    "images": "node scripts/convert-images.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.3",
    "@waline/client": "3.16.1",
    "astro": "7.4.1",
    "github-slugger": "2.0.0",
    "hast-util-from-html": "2.0.3",
    "hast-util-to-html": "9.0.5",
    "mdast-util-to-string": "4.0.0",
    "mermaid": "12.2.0",
    "pagefind": "1.5.2",
    "photoswipe": "5.4.4",
    "rehype-external-links": "3.0.0",
    "remark-breaks": "4.0.0",
    "remark-parse": "11.0.0",
    "sharp": "0.35.5",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/hast": "3.0.5",
    "@types/html-minifier-terser": "7.0.2",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "fast-xml-validator": "1.4.2",
    "globals": "17.13.0",
    "html-minifier-terser": "7.2.0",
    "jiti": "2.7.0",
    "lighthouse": "13.5.0",
    "lightningcss": "1.33.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "rehype-stringify": "10.0.1",
    "remark-rehype": "11.1.2",
    "svgo": "4.1.0",
    "terser": "5.51.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.0",
    "vfile": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "24.22.1"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
