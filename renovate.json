{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigestsToSemver"],
  "timezone": "Asia/Seoul",
  "labels": ["dependencies"],
  "ignorePaths": ["public/**", "drafts/**"],
  "rangeStrategy": "pin",
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "automergeStrategy": "merge-commit",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "labels": ["dependencies", "security"]
  },
  "packageRules": [
    {
      "matchPackageNames": ["astro", "@astrojs/**"],
      "groupName": "astro"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "zizmor runs via pipx in the workflow",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["pipx run 'zizmor==(?<currentValue>[^']+)'"],
      "depNameTemplate": "zizmor",
      "datasourceTemplate": "pypi"
    }
  ]
}
