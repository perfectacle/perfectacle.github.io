---
import { SITE } from '../lib/posts.ts';

interface Props {
  /** Post path such as `/2022/06/06/slug/`. */
  path: string;
  title: string;
}
const { path, title } = Astro.props;
// The Hexo/NexT era registered threads with identifier = path without the leading slash;
// changing it would detach every existing Disqus thread.
const config = { url: new URL(path, SITE.url).href, identifier: path.slice(1), title };
---

<section class="comments" data-pagefind-ignore>
  <div id="disqus_thread" data-config={JSON.stringify(config)}>
    <button type="button" class="load">
      댓글 보기
    </button>
  </div>
</section>

<script>
  interface DisqusPage {
    url: string;
    identifier: string;
    title: string;
  }
  // Globals read by Disqus' embed.js.
  const w = window as Window & { disqus_config?: (this: { page: DisqusPage }) => void; __disqusLoaded?: boolean };

  const thread = document.getElementById('disqus_thread');
  if (thread?.dataset.config) {
    const config = JSON.parse(thread.dataset.config) as DisqusPage;
    const load = () => {
      if (w.__disqusLoaded) return;
      w.__disqusLoaded = true;
      w.disqus_config = function () {
        this.page.url = config.url;
        this.page.identifier = config.identifier;
        this.page.title = config.title;
      };
      const s = document.createElement('script');
      s.src = 'https://exobud.disqus.com/embed.js';
      s.dataset.timestamp = String(Date.now());
      document.head.appendChild(s);
    };
    thread.querySelector('.load')?.addEventListener('click', load);
    new IntersectionObserver(
      (entries, obs) => {
        if (entries.some(e => e.isIntersecting)) {
          obs.disconnect();
          load();
        }
      },
      { rootMargin: '400px' },
    ).observe(thread);
  }
</script>

<style>
  .comments {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .load {
    font: inherit;
    padding: 8px 16px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-soft);
    color: var(--fg);
    cursor: pointer;
  }
</style>
