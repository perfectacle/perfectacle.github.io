---
import { SITE } from '../lib/posts.ts';

interface Props {
  /** Post path such as `/2022/06/06/slug/`. */
  path: string;
  title: string;
}
const { path, title } = Astro.props;
// The Hexo/NexT era registered threads with identifier = path without the leading slash;
// changing it would detach every existing Disqus thread.
const config = { url: new URL(path, SITE.url).href, identifier: path.slice(1), title };
---

<section id="comments" class="comments" aria-labelledby="comments-title" data-pagefind-ignore>
  <h2 id="comments-title" class="section-label">
    댓글
  </h2>
  <div id="disqus_thread" data-config={JSON.stringify(config)}>
    <button type="button" class="load">
      댓글 보기
    </button>
  </div>
</section>

<script>
  interface DisqusPage {
    url: string;
    identifier: string;
    title: string;
  }
  // Globals read by Disqus' embed.js.
  const w = window as Window & { disqus_config?: (this: { page: DisqusPage }) => void; __disqusLoaded?: boolean };

  // Disqus injects ad iframes, its "Also on" recommendations and an ad-tracking script next to the comments.
  // Stopping them at insertion keeps the ad networks from loading at all; hiding them would still load them.
  const UNWANTED = [
    /\/\/tempest\.services\.disqus\.com\/ads-iframe\//,
    /\/recommendations\.js(?:$|\?)/,
    /\.liadm\.com\//,
  ];
  const isUnwanted = (node: Node) =>
    (node instanceof HTMLScriptElement || node instanceof HTMLIFrameElement) &&
    UNWANTED.some(re => re.test(node.getAttribute('src') ?? ''));
  const blockUnwanted = () => {
    const { appendChild, insertBefore } = Node.prototype;
    Node.prototype.appendChild = function <T extends Node>(this: Node, node: T): T {
      return isUnwanted(node) ? node : (appendChild.call(this, node) as T);
    };
    Node.prototype.insertBefore = function <T extends Node>(this: Node, node: T, child: Node | null): T {
      return isUnwanted(node) ? node : (insertBefore.call(this, node, child) as T);
    };
  };

  const thread = document.getElementById('disqus_thread');
  if (thread?.dataset.config) {
    const config = JSON.parse(thread.dataset.config) as DisqusPage;
    const load = () => {
      if (w.__disqusLoaded) return;
      w.__disqusLoaded = true;
      w.disqus_config = function () {
        this.page.url = config.url;
        this.page.identifier = config.identifier;
        this.page.title = config.title;
      };
      blockUnwanted();
      const s = document.createElement('script');
      s.src = 'https://exobud.disqus.com/embed.js';
      s.dataset.timestamp = String(Date.now());
      document.head.appendChild(s);
    };
    thread.querySelector('.load')?.addEventListener('click', load);
    new IntersectionObserver(
      (entries, obs) => {
        if (entries.some(e => e.isIntersecting)) {
          obs.disconnect();
          load();
        }
      },
      { rootMargin: '400px' },
    ).observe(thread);
  }
</script>

<style>
  .comments {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .load {
    font: inherit;
    padding: 8px 16px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-soft);
    color: var(--fg);
    cursor: pointer;
    min-height: 44px;
  }
  .load:hover {
    border-color: var(--accent);
  }
  /* Fallback in case Disqus inserts these another way than the guarded DOM methods. */
  .comments :global(#disqus_recommendations),
  .comments :global(#disqus_thread iframe[src*='/ads-iframe/']) {
    display: none !important;
  }
</style>
