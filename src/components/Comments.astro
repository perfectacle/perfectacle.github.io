---
interface Props {
  /** Post path such as `/2022/06/06/slug/`. */
  path: string;
}
const { path } = Astro.props;
---

<section id="comments" class="comments" aria-labelledby="comments-title" data-pagefind-ignore>
  <h2 id="comments-title" class="section-label">
    댓글
  </h2>
  <!-- Waline keys threads by this path, and comments imported from Disqus were stored under it.
       Changing it detaches every existing thread. -->
  <div id="waline" data-path={path}>
    <button type="button" class="load">
      댓글 보기
    </button>
  </div>
</section>

<script>
  const SERVER_URL = 'https://blog-comments-perfectacle.vercel.app';
  // reCAPTCHA v3 site key (public). The server checks each comment's token with the matching secret.
  const RECAPTCHA_V3_KEY = '6Ldj-PktAAAAANaZoskgwtGwP73TtTKAPgJTO5EW';

  const el = document.getElementById('waline');
  if (el?.dataset.path) {
    const path = el.dataset.path;
    let loaded = false;
    const load = async () => {
      if (loaded) return;
      loaded = true;
      const [{ init }, { WALINE_KO }] = await Promise.all([
        import('@waline/client'),
        import('../lib/waline-locale.ts'),
        import('@waline/client/waline.css'),
      ]);
      init({
        el,
        serverURL: SERVER_URL,
        path,
        lang: 'ko',
        locale: WALINE_KO,
        login: 'enable',
        meta: ['nick', 'mail', 'link'],
        requiredMeta: ['nick'],
        // The defaults reach third-party services: emoji packs from a CDN, Giphy for GIF search, and images
        // inlined as base64 into the database.
        emoji: false,
        search: false,
        imageUploader: false,
        reaction: false,
        pageview: false,
        comment: false,
        recaptchaV3Key: RECAPTCHA_V3_KEY,
      });
    };
    el.querySelector('.load')?.addEventListener('click', () => void load());
    new IntersectionObserver(
      (entries, obs) => {
        if (entries.some(e => e.isIntersecting)) {
          obs.disconnect();
          void load();
        }
      },
      { rootMargin: '400px' },
    ).observe(el);
  }
</script>

<style>
  .comments {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    /* Waline reads these; pointing them at the site tokens makes it follow the light/dark theme. */
    --waline-font-size: 1rem;
    --waline-theme-color: var(--accent);
    --waline-active-color: var(--accent);
    --waline-color: var(--fg);
    --waline-bg-color: var(--bg);
    --waline-bg-color-light: var(--bg-soft);
    --waline-bg-color-hover: var(--bg-soft);
    --waline-border-color: var(--border);
    /* Waline composes this from the border color on :root, so it has to be restated here to pick up --border. */
    --waline-border: 1px solid var(--border);
    --waline-disable-bg-color: var(--bg-soft);
    --waline-disable-color: var(--fg-muted);
    --waline-bq-color: var(--border);
    --waline-info-bg-color: var(--bg-soft);
    --waline-info-color: var(--fg-muted);
    --waline-light-grey: var(--fg-muted);
    --waline-dark-grey: var(--fg-muted);
    --waline-white: var(--accent-fg);
    --waline-badge-color: var(--accent);
  }
  .load {
    font: inherit;
    padding: 8px 16px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-soft);
    color: var(--fg);
    cursor: pointer;
    min-height: 44px;
  }
  .load:hover {
    border-color: var(--accent);
  }
  .comments :global(.wl-content pre) {
    font-family: var(--font-mono);
  }
  .comments :global(.wl-editor) {
    font-family: var(--font-sans);
  }
  /* Waline prints the count before the label ("2 댓글"); Korean reads "댓글 2". */
  .comments :global(.wl-count) {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
    gap: 0.3em;
  }
</style>
