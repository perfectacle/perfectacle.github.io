---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
  categoryPath,
  coverImage,
  excerpt,
  formatDate,
  postPath,
  readingMinutes,
  tagPath,
  type Post,
} from '../lib/posts.ts';

interface Props {
  posts: Post[];
  summary?: boolean;
}
const { posts, summary = true } = Astro.props;

// Thumbnails go through Astro's image pipeline at list size (a few KB each) rather than reusing the post's
// full-width copies. They must stay out of post pages: scripts/copy-post-assets.ts moves every /_astro/ image a
// post page references into that post's folder, which would break the same file on list pages.
const postImages = import.meta.glob<{ default: ImageMetadata }>('../content/posts/**/*.webp');
const safeDecode = (s: string) => {
  try {
    return decodeURI(s);
  } catch {
    // A literal `%` in a file name is not an escape sequence.
    return s;
  }
};
async function thumbnail(post: Post): Promise<ImageMetadata | undefined> {
  const file = coverImage(post);
  const dir = post.filePath?.replace(/^src\//, '../').replace(/index\.md$/, '');
  if (!file || !dir) return undefined;
  const load = postImages[`${dir}${file}`] ?? postImages[`${dir}${safeDecode(file)}`];
  return (await load?.())?.default;
}
const items = await Promise.all(
  posts.map(async post => ({ post, thumb: summary ? await thumbnail(post) : undefined })),
);
---

<ol class="post-list">
  {items.map(({ post, thumb }, i) => {
    const cats = post.data.categories;
    return (
      <li>
        <article>
          <div class="body">
            <div class="meta">
              <time class="mono" datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
              {cats.length > 0 && (
                <>
                  <span aria-hidden="true">·</span>
                  <a class="cat" href={categoryPath(cats)}>
                    {cats.at(-1)}
                  </a>
                </>
              )}
              {summary && (
                <>
                  <span aria-hidden="true">·</span>
                  <span>읽는 데 {readingMinutes(post)}분</span>
                </>
              )}
            </div>
            <h2>
              <a href={postPath(post)}>{post.data.title}</a>
            </h2>
            {summary && <p class="excerpt">{excerpt(post)}</p>}
            {summary && post.data.tags.length > 0 && (
              <ul class="chips">
                {post.data.tags.slice(0, 4).map(t => (
                  <li>
                    <a class="chip" href={tagPath(t)}>
                      #{t}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
          {thumb && (
            <Image
              class="thumb"
              src={thumb}
              alt=""
              width={168}
              height={112}
              fit="cover"
              layout="fixed"
              loading={i < 2 ? 'eager' : 'lazy'}
            />
          )}
        </article>
      </li>
    );
  })}
</ol>

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .post-list > li + li {
    border-top: 1px solid var(--border);
  }
  article {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 24px;
    padding: 22px 0;
  }
  .body {
    flex: 1;
    min-width: 0;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 6px;
    font-size: 0.85rem;
    color: var(--fg-muted);
  }
  .meta .mono {
    font-size: 0.8rem;
  }
  .cat {
    color: inherit;
  }
  h2 {
    margin: 4px 0 6px;
    font-size: 1.25rem;
    line-height: 1.4;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  h2 a {
    color: var(--fg);
  }
  h2 a:hover,
  article:hover h2 a {
    color: var(--accent);
    text-decoration: none;
  }
  .excerpt {
    margin: 0 0 12px;
    color: var(--fg-muted);
    font-size: 0.95rem;
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .thumb {
    flex: none;
    width: 168px;
    height: 112px;
    margin-top: 6px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg-soft);
  }
  :global([data-theme='dark']) .thumb {
    filter: brightness(0.9);
  }
  /* The title link covers the card so the whole item is a tap target; category and tags stay clickable above it. */
  h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .cat,
  .chips {
    position: relative;
    z-index: 1;
  }
  @media (max-width: 640px) {
    article {
      gap: 14px;
      padding: 18px 0;
    }
    .post-list > li:first-child article {
      padding-top: 4px;
    }
    h2 {
      font-size: 1.1rem;
      margin: 4px 0;
    }
    .excerpt {
      font-size: 0.9rem;
      line-height: 1.55;
      margin-bottom: 10px;
    }
    .thumb {
      width: 88px;
      height: 64px;
      /* Beside the title rather than the date line. */
      margin-top: 30px;
    }
    .chips li:nth-child(n + 4) {
      display: none;
    }
  }
</style>
