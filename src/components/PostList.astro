---
import { getImage, Image } from 'astro:assets';
import { posix } from 'node:path';
import { AVIF_OPTIONS, imageFormat, localPostImage, originalImageUrl } from '../lib/image-format.ts';
import type { ImageMetadata } from 'astro';
import { cardSpans, thumbSizes } from '../lib/card-grid.ts';
import PostCover from './PostCover.astro';
import {
  categoryPath,
  coverImage,
  excerpt,
  formatDate,
  postPath,
  postSlug,
  readingMinutes,
  tagPath,
  type Post,
} from '../lib/posts.ts';

interface Props {
  posts: Post[];
  summary?: boolean;
}
const { posts, summary = true } = Astro.props;

// Thumbnails go through Astro's image pipeline at list size (a few KB each) rather than reusing the post's
// full-width copies. They must stay out of post pages: scripts/copy-post-assets.ts moves every /_astro/ image a
// post page references into that post's folder, which would break the same file on list pages.
const postImages = import.meta.glob<{ default: ImageMetadata }>('../content/posts/**/*.webp');
const safeDecode = (s: string) => {
  try {
    return decodeURI(s);
  } catch {
    // A literal `%` in a file name is not an escape sequence.
    return s;
  }
};
async function thumbnail(post: Post, sizes: string) {
  const file = coverImage(post);
  const dir = post.filePath?.replace(/^src\//, '../').replace(/index\.md$/, '');
  if (!file || !dir) return undefined;
  const load = postImages[posix.normalize(`${dir}${file}`)] ?? postImages[posix.normalize(`${dir}${safeDecode(file)}`)];
  const image = (await load?.())?.default;
  const source = localPostImage(file, post.filePath);
  if (!image || !source) return undefined;
  const choice = await imageFormat(source, { width: 720, height: 405, fit: 'cover' });
  const avif =
    choice.format === 'avif'
      ? await getImage({
          src: image,
          width: 1280,
          height: 720,
          widths: [176, 352, 480, 720, 960, 1280],
          sizes,
          fit: 'cover',
          format: 'avif',
          quality: AVIF_OPTIONS.quality,
          layout: 'constrained',
        })
      : undefined;
  return { image, avif, original: originalImageUrl(source) };
}
// Each card's span in the 12-track grid at 2, 3 and 4 columns, worked out here so no row is left with one card.
const spans = { 2: cardSpans(posts.length, 2), 3: cardSpans(posts.length, 3), 4: cardSpans(posts.length, 4) };
const layoutOf = (i: number) => {
  const at = { 2: spans[2][i] ?? 6, 3: spans[3][i] ?? 4, 4: spans[4][i] ?? 3 };
  return {
    style: `--s2:${at[2]};--s3:${at[3]};--s4:${at[4]}`,
    // Half-width cards at 3 or 4 columns are the featured ones; at 2 columns every card is half width.
    wide: ([3, 4] as const).filter(c => at[c] >= 6).join(' ') || undefined,
    sizes: thumbSizes(at),
  };
};
const items = await Promise.all(
  posts.map(async (post, i) => ({ post, thumb: summary ? await thumbnail(post, layoutOf(i).sizes) : undefined })),
);
---

<ol class:list={['post-list', { cards: summary }]}>
  {items.map(({ post, thumb }, i) => {
    const cats = post.data.categories;
    const layout = layoutOf(i);
    return (
      <li style={summary ? layout.style : undefined} data-wide={summary ? layout.wide : undefined}>
        <article>
          <div class="body">
            <div class="meta">
              <time class="mono" datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
              {cats.length > 0 && (
                <>
                  <span aria-hidden="true">·</span>
                  <a class="cat" href={categoryPath(cats)}>
                    {cats.at(-1)}
                  </a>
                </>
              )}
              {summary && (
                <>
                  <span aria-hidden="true">·</span>
                  <span>읽는 데 {readingMinutes(post)}분</span>
                </>
              )}
            </div>
            <h2>
              <a href={postPath(post)}>{post.data.title}</a>
            </h2>
            {summary && <p class="excerpt">{excerpt(post)}</p>}
            {summary && post.data.tags.length > 0 && (
              <ul class="chips">
                {post.data.tags.slice(0, 4).map(t => (
                  <li>
                    <a class="chip" href={tagPath(t)}>
                      #{t}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
          {thumb ? (
            thumb.avif ? (
              <picture class="thumb-picture">
                <source type="image/avif" srcset={thumb.avif.srcSet.attribute || thumb.avif.src} sizes={layout.sizes} />
                <img
                  {...thumb.avif.attributes}
                  class="thumb"
                  src={thumb.original}
                  alt=""
                  sizes={layout.sizes}
                  loading={i < 3 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                />
              </picture>
            ) : (
              <Image
                class="thumb"
                src={thumb.image}
                alt=""
                width={1280}
                height={720}
                widths={[176, 352, 480, 720, 960, 1280]}
                sizes={layout.sizes}
                fit="cover"
                loading={i < 3 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
              />
            )
          ) : (
            summary && (
              <div class="thumb thumb-cover">
                <PostCover
                  title={post.data.title}
                  slug={postSlug(post)}
                  label={cats.length > 0 ? cats.join(' / ') : undefined}
                />
              </div>
            )
          )}
        </article>
      </li>
    );
  })}
</ol>

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .post-list > li + li {
    border-top: 1px solid var(--border);
  }
  article {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 24px;
    padding: 22px 0;
  }
  .body {
    flex: 1;
    min-width: 0;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 6px;
    font-size: 0.85rem;
    color: var(--fg-muted);
  }
  .meta .mono {
    font-size: 0.8rem;
  }
  .cat {
    color: inherit;
  }
  h2 {
    margin: 4px 0 6px;
    font-size: 1.25rem;
    line-height: 1.4;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  h2 a {
    color: var(--fg);
  }
  h2 a:hover,
  article:hover h2 a {
    color: var(--accent);
    text-decoration: none;
  }
  .excerpt {
    margin: 0 0 12px;
    color: var(--fg-muted);
    font-size: 0.95rem;
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .thumb-picture {
    display: contents;
  }
  .thumb {
    flex: none;
    width: 168px;
    height: 112px;
    margin-top: 6px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg-soft);
  }
  /* The cover's container query makes it a stacking context painted above the card's full-card link overlay;
     letting pointers pass through keeps a tap on the cover opening the post, like a tap on an image does. */
  .thumb-cover {
    overflow: hidden;
    pointer-events: none;
  }
  :global([data-theme='dark']) img.thumb {
    filter: brightness(0.9);
  }
  /* The title link covers the card so the whole item is a tap target; category and tags stay clickable above it. */
  h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .cat,
  .chips {
    position: relative;
    z-index: 1;
  }
  /* Wide screens: a grid of cards (image on top) instead of long single rows. */
  /* 12 tracks so rows of 2, 3 or 4 cards can sit on one page; each card's span comes from cardSpans() as
     --s2/--s3/--s4. The breakpoints and gap must change together with card-grid.ts, which builds `sizes`. */
  @media (min-width: 900px) {
    .cards {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 40px 28px;
      padding-top: 16px;
    }
    .cards > li {
      grid-column: span var(--s2, 6);
    }
    .cards > li + li {
      border-top: 0;
    }
    .cards article {
      flex-direction: column;
      gap: 14px;
      height: 100%;
      padding: 0;
    }
    .cards .thumb {
      order: -1;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      margin: 0;
    }
    .cards .excerpt {
      -webkit-line-clamp: 3;
    }
  }
  @media (min-width: 1148px) {
    .cards > li {
      grid-column: span var(--s3, 4);
    }
  }
  @media (min-width: 1700px) {
    .cards > li {
      grid-column: span var(--s4, 3);
    }
  }
  /* The bigger cards on top get type to match their size. */
  @media (min-width: 1148px) and (max-width: 1699px) {
    .cards > li[data-wide~='3'] h2 {
      font-size: 1.5rem;
    }
    .cards > li[data-wide~='3'] .excerpt {
      font-size: 1rem;
    }
  }
  @media (min-width: 1700px) {
    .cards > li[data-wide~='4'] h2 {
      font-size: 1.5rem;
    }
    .cards > li[data-wide~='4'] .excerpt {
      font-size: 1rem;
    }
  }
  @media (max-width: 640px) {
    article {
      gap: 14px;
      padding: 18px 0;
    }
    .post-list > li:first-child article {
      padding-top: 4px;
    }
    h2 {
      font-size: 1.1rem;
      margin: 4px 0;
    }
    .excerpt {
      font-size: 0.9rem;
      line-height: 1.55;
      margin-bottom: 10px;
    }
    .thumb {
      width: 88px;
      height: 64px;
      /* Beside the title rather than the date line. */
      margin-top: 30px;
    }
    .chips li:nth-child(n + 4) {
      display: none;
    }
  }
</style>
