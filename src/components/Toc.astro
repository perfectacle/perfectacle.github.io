---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}
const { headings } = Astro.props;
---

<ol class="toc">
  {headings.map(h => (
    <li class={`d${h.depth}`}>
      <a href={`#${h.slug}`}>{h.text}</a>
    </li>
  ))}
</ol>

<style>
  .toc {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
  }
  li {
    padding: 3px 0;
    line-height: 1.45;
  }
  .d3 {
    padding-left: 14px;
  }
  a {
    color: var(--fg-muted);
  }
  a:hover,
  a.active {
    color: var(--accent);
    text-decoration: none;
  }
</style>

<script>
  const links = new Map<string, HTMLAnchorElement[]>();
  document.querySelectorAll<HTMLAnchorElement>('.toc a').forEach(a => {
    const id = decodeURIComponent(a.hash.slice(1));
    links.set(id, [...(links.get(id) ?? []), a]);
  });
  const observer = new IntersectionObserver(
    entries => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        document.querySelectorAll('.toc a.active').forEach(a => a.classList.remove('active'));
        links.get(e.target.id)?.forEach(a => a.classList.add('active'));
      }
    },
    { rootMargin: '-80px 0px -70% 0px' },
  );
  links.forEach((_, id) => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });
</script>
