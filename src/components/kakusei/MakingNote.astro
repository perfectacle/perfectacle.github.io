---
import ZoomImage from '../kr-patch/ZoomImage.astro';
import MakingIntro from './MakingIntro.astro';
import NoteRelated from '../romhacking/NoteRelated.astro';
import Deeper from '../romhacking/Deeper.astro';
import Figure from '../romhacking/Figure.astro';
import LzssStep from '../romhacking/LzssStep.astro';
import ToolFiles from '../kr-patch/ToolFiles.astro';
import MakingSources from '../kr-patch/MakingSources.astro';
import { sourceFileUrl, sourceUrl, TOTSUGEKI_PATCH, type KrPatch } from '../../lib/kr-patches';
import { GLOSSARY_PATH } from '../romhacking/glossary';
import { notePath } from '../romhacking/chapters';
import SourceFile from '../kr-patch/SourceFile.astro';

interface Props {
  patch: KrPatch;
}

const { patch } = Astro.props;
const base = patch.path;
const img = (name: string) => `${base}/images/making/${name}`;
const source = sourceUrl(patch);
const totsugeki = notePath(TOTSUGEKI_PATCH);
const ch = (slug: string, hash = '') => `/games/romhacking/snes/${slug}/${hash && `#${hash}`}`;
const common = (slug: string, hash = '') => `/games/romhacking/${slug}/${hash && `#${hash}`}`;

