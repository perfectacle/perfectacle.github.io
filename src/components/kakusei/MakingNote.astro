          rx="5"
        />
        <text class="dg-text" x="224" y={30 + i * 38} text-anchor="middle">
          {label}
        </text>
      </>
    ))}
    {[
      ['0x800', '요약 A', ['', '0x13바이트', '']],
      ['0x860', '요약 B', ['', 'Gokuden2nd', '']],
    ].map(([at, name, cells], row) => (
      <>
        <text class="dg-mono" x="8" y={162 + row * 44}>
          {at}
        </text>
        <text class="dg-small" x="8" y={178 + row * 44}>
          {name}, 0x20씩
        </text>
        {(cells as string[]).map((c, i) => (
          <>
            <rect
              class:list={[i === 1 ? 'dg-accent' : 'dg-cell', i !== 1 && 'dg-dash']}
              x={96 + i * 88}
              y={144 + row * 44}
              width="80"
              height="30"
              rx="5"
            />
            <text class="dg-small" x={136 + i * 88} y={164 + row * 44} text-anchor="middle">
              {c || `${i + 1}칸`}
            </text>
          </>
        ))}
      </>
    ))}
    <text class="dg-small" x="96" y="134">
      요약은 칸마다 두 곳
    </text>
  </svg>
</Figure>
<p>
  요약 B는 문자열 <code>Gokuden2nd</code>(<code>47 6F 6B 75 64 65 6E 32 6E 64</code>)에 체크값 2바이트가 붙은
  12바이트입니다. 그래서 깨진 칸을 지울 때는 본체만 0x60으로 채우면 안 되고, 요약 두 곳도 같이 지워야 했습니다. v1.2와
  v1.3 모두 세이브 구조는 건드리지 않아 v1.1 세이브를 그대로 쓸 수 있습니다.
</p>

<h3 id="making-password">돌격편에서 넘어오는 암호</h3>
<NoteRelated patch={patch} id="making-password" />
<p>
  돌격편 엔딩에 나오는 50자 암호를 각성편의 새 게임 → 암호 화면에 넣으면 돌격편에서 정한 이름과 기록을 이어받습니다.
  검사 코드(<code>$83:A1F8</code>)는 빈칸을 뺀 글자를 두 자씩 끊어, <code>$83:A60E</code>의 256쌍 표에서 같은 쌍을 찾아
  그 순번을 1바이트로 바꿉니다. 앞 23쌍이 23바이트이고, 그 합(16비트)이 마지막 두 쌍이 나타내는 값과 같으면 통과입니다.
  v1.3의 쌍 표에서 순번 0은 「가녕」, 순번 1은 「성너」입니다.
</p>
<Figure caption="암호 글자 두 자가 1바이트가 됩니다. 마지막 두 쌍은 앞 23바이트의 합입니다" max={560}>
  <svg viewBox="0 0 360 176" role="img" aria-labelledby="kk-pw-t kk-pw-d">
    <title id="kk-pw-t">암호 쌍 표 읽기</title>
    <desc id="kk-pw-d">
      입력한 암호를 두 자씩 끊는다. 가녕은 쌍 표의 순번 00, 성너는 순번 01이다. 이렇게 23바이트를 만들고, 24·25번째 쌍이
      나타내는 합계와 23바이트의 합이 같으면 통과한다.
    </desc>
    <text class="dg-small" x="8" y="16">
      입력한 암호(빈칸 뺌), 두 자씩
    </text>
    <rect class="dg-warm" x="8" y="24" width="80" height="36" rx="5"></rect>
    <text class="dg-text dg-bold" x="48" y="47" text-anchor="middle">
