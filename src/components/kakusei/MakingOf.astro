                  <a href={`#making-${t.section}`}>{sectionTitles[t.section]}</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>압축을 푼 폴더에 일본판 원본을 넣고 빌드 스크립트를 돌리면 아래 순서로 v1.2와 같은 롬이 나옵니다.</p>
