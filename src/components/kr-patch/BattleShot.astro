---
import ZoomImage from './ZoomImage.astro';

interface Props {
  src: string;
  alt: string;
  caption: string;
  /** Captures with the overscan line are 239 tall; plain screens are 224. */
  height?: number;
}

const { src, alt, caption, height = 224 } = Astro.props;
---

<figure class="battle-shot">
  <div class="screen">
    <ZoomImage src={src} alt={alt} width="256" height={height} loading="lazy" decoding="async" />
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .battle-shot {
    width: 100%;
    max-width: 512px;
    margin: 1.5rem auto;
  }

  figcaption {
    margin-top: 0.8rem;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
</style>
