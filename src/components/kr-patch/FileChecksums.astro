---
import { formatBytes } from '../../lib/kr-patches';
import { patchedSize, type RomSpec } from '../../lib/rom-patch';

interface Props {
  spec: RomSpec;
  version: string;
}

const { spec, version } = Astro.props;
const files = [
  { name: '일본판 원본', size: spec.size, fingerprint: spec.original },
  { name: `한글판 v${version}`, size: patchedSize(spec), fingerprint: spec.patched },
];
---

<details class="file-checksums">
  <summary>롬파일 크기·해시 보기</summary>
  <div class="file-checksums-body">
    <p class="file-checksums-note">
      일본판 원본 롬파일에만 패치할 수 있습니다. 파일을 고르면 이 페이지가 아래 값과 맞는지 확인합니다.
    </p>
    <div class="file-checksums-files">
      {files.map(file => (
        <section class="file-checksums-file" aria-label={file.name}>
          <h3>{file.name}</h3>
          <dl>
            <div>
              <dt>크기</dt>
              <dd>{formatBytes(file.size)}</dd>
            </div>
            <div>
              <dt>CRC32</dt>
              <dd>
                <code>{file.fingerprint.crc32}</code>
              </dd>
            </div>
            <div>
              <dt>MD5</dt>
              <dd>
                <code>
                  {file.fingerprint.md5.slice(0, 16)}
                  <wbr />
                  {file.fingerprint.md5.slice(16)}
                </code>
              </dd>
            </div>
          </dl>
        </section>
      ))}
    </div>
  </div>
</details>
