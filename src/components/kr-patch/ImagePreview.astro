<dialog id="patch-image-preview" aria-labelledby="patch-image-preview-title">
  <div class="preview-header">
    <h2 id="patch-image-preview-title">스크린샷 미리 보기</h2>
    <div class="preview-nav" hidden>
      <span class="preview-count" aria-live="polite"></span>
      <button type="button" class="preview-step" data-step="-1" aria-label="이전 스크린샷">
        ‹
      </button>
      <button type="button" class="preview-step" data-step="1" aria-label="다음 스크린샷">
        ›
      </button>
    </div>
    <button type="button" class="preview-close" autofocus aria-label="미리 보기 닫기">
      닫기
    </button>
  </div>
  <div class="preview-content"></div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#patch-image-preview');
  const content = dialog?.querySelector('.preview-content');
  const close = dialog?.querySelector<HTMLButtonElement>('.preview-close');
  const nav = dialog?.querySelector<HTMLElement>('.preview-nav');
  const count = dialog?.querySelector('.preview-count');
  /** The screenshot the preview was opened from, and the one it shows now. */
  let opener: HTMLButtonElement | null = null;
  let trigger: HTMLButtonElement | null = null;
  let group: HTMLButtonElement[] = [];
  let overflow = '';
  const rendered = (node: Element) => node.getClientRects().length > 0;

  // Screenshots of one page section step through together; note pages without sections are one group.
  // Folded ones (inside a closed <details>) count, but those hidden in other ways (another layout's copy) do not.
  const groupOf = (button: HTMLButtonElement) => {
    const scope = button.closest('section.section') ?? document.querySelector('main') ?? document.body;
    return [...scope.querySelectorAll<HTMLButtonElement>('[data-patch-preview]')].filter(
      node => node === button || rendered(node) || node.closest('details:not([open])') !== null,
    );
  };

  if (dialog && content && close && nav && count) {
    const show = (button: HTMLButtonElement) => {
      const picture = button.querySelector('.patch-picture');
      if (!picture) return;
      trigger = button;
      content.replaceChildren(picture.cloneNode(true));
      count.textContent = `${group.indexOf(button) + 1} / ${group.length}`;
    };
    const step = (by: number) => {
      if (!trigger || group.length < 2) return;
      const next = group[(group.indexOf(trigger) + by + group.length) % group.length];
      if (next) show(next);
    };
    const finishClose = () => {
      if (dialog.open || !opener) return;
      document.documentElement.style.overflow = overflow;
      content.replaceChildren();
      // A screenshot reached by stepping may sit in a folded section; focus then returns to the one opened.
      const target = trigger && rendered(trigger) ? trigger : opener;
      opener = trigger = null;
      group = [];
      target.scrollIntoView({ block: 'nearest' });
      target.focus({ preventScroll: true });
    };
    const closePreview = () => {
      dialog.close();
      finishClose();
    };
    document.addEventListener('click', event => {
      const button =
        event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-patch-preview]') : null;
      if (!button?.querySelector('.patch-picture') || dialog.open) return;
      opener = button;
      group = groupOf(button);
      nav.hidden = group.length < 2;
      show(button);
      dialog.showModal();
      overflow = document.documentElement.style.overflow;
      document.documentElement.style.overflow = 'hidden';
    });
    close.addEventListener('click', closePreview);
    dialog.addEventListener('cancel', event => {
      event.preventDefault();
      closePreview();
    });
    nav.addEventListener('click', event => {
      const button = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-step]') : null;
      if (button) step(Number(button.dataset.step));
    });
    dialog.addEventListener('keydown', event => {
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault();
        step(event.key === 'ArrowLeft' ? -1 : 1);
      } else if (event.key === 'Tab') {
        // Focus stays on the dialog's own buttons.
        event.preventDefault();
        const buttons = [...dialog.querySelectorAll<HTMLButtonElement>('button')].filter(node => rendered(node));
        const at = buttons.indexOf(document.activeElement as HTMLButtonElement);
        const by = event.shiftKey ? -1 : 1;
        buttons[(at + by + buttons.length) % buttons.length]?.focus();
      }
    });
    dialog.addEventListener('click', event => {
      if (event.target === dialog) closePreview();
    });
    dialog.addEventListener('close', finishClose);
  }
</script>

<style>
  dialog {
    width: fit-content;
    max-width: calc(100vw - 24px);
    max-height: calc(100dvh - 24px);
    margin: auto;
    padding: 12px;
    overflow: auto;
    border: 1px solid var(--accent);
    border-radius: 6px;
    background: #17191e;
    color: #fff;
  }

  dialog::backdrop {
    background: rgb(0 0 0 / 85%);
  }

  .preview-header {
    position: sticky;
    top: -12px;
    z-index: 1;
    margin-top: -12px;
    padding-top: 12px;
    background: #17191e;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 12px;
  }

  h2 {
    margin: 0;
    font-size: 1rem;
  }

  .preview-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-inline-start: auto;
  }

  .preview-nav[hidden] {
    display: none;
  }

  .preview-count {
    min-width: 4.5em;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .preview-step {
    min-width: 44px;
    font-size: 1.25rem;
    line-height: 1;
  }

  /* On a phone the counter and buttons need the row; the title stays as the dialog's accessible name. */
  @media (max-width: 480px) {
    h2:has(+ .preview-nav:not([hidden])) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  button {
    flex-shrink: 0;
    min-height: 44px;
    padding: 8px 12px;
    border: 1px solid currentColor;
    border-radius: 4px;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .preview-content :global(.patch-picture) {
    /* Small game screens grow up to 3x; large diagrams open at least at their own size. */
    width: min(
      max(min(calc(var(--patch-image-width) * 3), 1100px), var(--patch-image-width)),
      calc(100vw - 50px),
      calc((100dvh - 120px) * var(--patch-image-ratio))
    );
    margin-inline: auto;
  }

  /* Large diagrams would shrink below their page size if fitted to the height, so they scroll instead. */
  .preview-content :global(.patch-picture.smooth) {
    width: min(max(min(calc(var(--patch-image-width) * 3), 1100px), var(--patch-image-width)), calc(100vw - 50px));
  }
</style>
