---
import { downloads, formatBytes, type KrPatch } from '../../lib/kr-patches';
import { megabytes, patchedSize } from '../../lib/rom-patch';

interface Props {
  patch: KrPatch;
}

const { patch } = Astro.props;
const { spec } = patch;
const { ips } = downloads(patch);
const korean = patchedSize(spec);
const tools = [
  { name: 'Floating IPS', href: 'https://github.com/Alcaro/Flips', note: 'Windows·Linux' },
  { name: 'Lunar IPS', href: 'https://fusoya.eludevisibility.org/lips/', note: 'Windows' },
  { name: 'ROM Patcher JS', href: 'https://www.marcrobledo.com/RomPatcher.js/', note: '웹 브라우저, 폰에서도 됨' },
];
---

<details class="manual">
  <summary>패치 도구로 직접 하기</summary>
  <div class="manual-body">
    <p>
      <a href={ips} download>
        IPS 파일
      </a>
      을 받아 아래 패치 도구로 일본판 원본 롬파일 {formatBytes(spec.size)}에 적용하세요.
      {korean !== spec.size && ` 패치하면 파일이 ${megabytes(spec, korean)}로 늘어납니다.`}
    </p>
    <ul class="downloads">
      {tools.map(tool => (
        <li>
          <a href={tool.href} rel="noopener">
            {tool.name}
          </a>
          <span>({tool.note})</span>
        </li>
      ))}
    </ul>
    <p class="manual-note">
      롬파일 크기가 {formatBytes(spec.size)}가 아니면 이 IPS로는 제대로 패치되지 않습니다. 그럴 때는 위 버튼으로 파일을
      고르면 알아서 맞춰 패치합니다.
    </p>
  </div>
</details>
