---
interface Props {
  /** Label art: the original card label with its title swapped for the patched ROM's Korean logo. */
  label: string;
  /** Title screens the boot scene lights on the console's top and bottom screens. */
  top: string;
  bottom: string;
  eager?: boolean;
}

const { label, top, bottom, eager = false } = Astro.props;
// Front of a Nintendo DS game card, traced from a photo of the real shell: a near-square charcoal body with a
// larger round on the top-left corner, the small step on the lower right edge, the label recess and the plain
// strip under the label.
---

<div class="ds-cartridge" data-top={top} data-bottom={bottom}>
  <svg class="ds-cartridge-shell" viewBox="0 0 340 336" aria-hidden="true">
    <defs>
      <linearGradient id="ds-card-body" x1="0" y1="0" x2="0.35" y2="1">
        <stop offset="0" stop-color="#3a3b40"></stop>
        <stop offset="0.55" stop-color="#2a2b2f"></stop>
        <stop offset="1" stop-color="#1c1d20"></stop>
      </linearGradient>
    </defs>
    <path
      d="M18 0H327C330.5 0 333 2.5 333 6V302L338 308V328C338 332.5 334.5 336 330 336H8C3.5 336 0 332.5 0 328V18C0 8 8 0 18 0Z"
      fill="url(#ds-card-body)"
      stroke="#121214"
      stroke-width="1.5"
    ></path>
    <path d="M18 1.5H327" stroke="#55565c" stroke-width="1"></path>
    <rect x="24" y="9" width="285" height="294" rx="5" fill="#202124" stroke="#4a4b51" stroke-width="1"></rect>
    <path d="M24 318H309" stroke="#151518" stroke-width="1.2"></path>
    <path d="M24 319.5H309" stroke="#3f4045" stroke-width="0.8"></path>
  </svg>
  <div class="ds-cartridge-label">
    {eager ? (
      <img src={label} width="900" height="945" alt="" fetchpriority="high" />
    ) : (
      <img src={label} width="900" height="945" alt="" loading="lazy" decoding="async" />
    )}
  </div>
</div>

<style is:global>
  .ds-cartridge {
    position: relative;
    aspect-ratio: 340 / 336;
    filter: drop-shadow(0 10px 14px rgb(0 0 0 / 45%));
    transition: transform 0.15s;
  }

  .ds-cartridge-shell {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ds-cartridge-label {
    position: absolute;
    left: 8.53%;
    top: 4.17%;
    width: 79.71%;
    height: 84.52%;
    overflow: hidden;
    border-radius: 3.5% 1.5% 1.5% 1.5%;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 35%);
  }

  .ds-cartridge-label img {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Light from the upper left, like the photo the label comes from. */
  .ds-cartridge-label::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgb(255 255 255 / 10%), transparent 40%, rgb(0 0 0 / 12%));
    pointer-events: none;
  }
</style>
