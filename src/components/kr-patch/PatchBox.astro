---
import type { RomSpec } from '../../lib/rom-patch';
import type { NdsSpec } from '../../lib/nds-patch';
import { PLATFORMS } from '../../lib/kr-patches';
import FileChecksums from './FileChecksums.astro';

type Props = {
  /** Patch file: IPS for the Super Famicom, xdelta for the Nintendo DS. */
  ips: string;
  version: string;
  /** File name of the saved Korean ROM, without the extension. */
  output: string;
  /** Character who speaks the box's messages, shown as the game's `<name>` tag. */
  speaker?: string;
} & ({ platform?: 'sfc'; spec: RomSpec } | { platform: 'nds'; spec: NdsSpec });

const { ips, spec, version, output, speaker, platform = 'sfc' } = Astro.props;
const { romExt } = PLATFORMS[platform];
const accept = platform === 'nds' ? '.nds,.zip' : '.sfc,.smc,.fig,.swc,.zip';
const extensions = platform === 'nds' ? '.nds · .zip' : '.sfc · .smc · .zip';
---

<div
  id="patch"
  class="patch-box frame"
  data-ips={ips}
  data-spec={JSON.stringify(spec)}
  data-output={output}
  data-platform={platform}
>
  <div class="patch-intro">
    <h2 class="patch-heading">여기서 바로 한글패치</h2>
    <p>따로 프로그램을 설치하지 않아도 됩니다.</p>
    <slot name="intro" />
  </div>
  <ol class="patch-steps" aria-label="한글패치 방법">
    <li>
      <strong>파일 준비</strong>
      <span>패치하지 않은 이 게임의 일본판 롬파일을 준비합니다.</span>
    </li>
    <li>
      <strong>선택하면 자동 패치</strong>
      <span>아래에서 파일을 고르면 확인 후 한글패치를 적용해 저장합니다.</span>
    </li>
    <li>
      <strong>저장한 파일로 실행</strong>
      <span>저장된 .{romExt} 파일을 에뮬레이터에서 엽니다.</span>
    </li>
  </ol>
  <p class="inapp-warning dialog" hidden>
    {speaker && (
      <span class="speaker">
        <span aria-hidden="true">&lt;</span>
        {speaker}
        <span aria-hidden="true">&gt;</span>
      </span>
    )}
    메신저 앱 안에서 열린 화면이라 파일을 고르거나 저장하지 못할 수 있습니다. 메뉴에서 "다른 브라우저로 열기"를 눌러
    크롬이나 사파리로 열어 주세요.
  </p>
  <label class="drop-zone">
    <input class="sr-only" type="file" accept={accept} aria-label="일본판 롬파일 고르기" />
    <span class="drop-title">일본판 롬파일 고르기</span>
    <span class="drop-hint">또는 파일을 여기에 끌어다 놓으세요 ({extensions})</span>
  </label>
  <div class="patch-status dialog" role="status" aria-live="polite" hidden>
    <p>
      {speaker && (
        <span class="speaker">
          <span aria-hidden="true">&lt;</span>
          {speaker}
          <span aria-hidden="true">&gt;</span>
        </span>
      )}
      <span class="status-text"></span>
    </p>
    <div class="status-actions"></div>
  </div>
  <p class="privacy">파일은 이 기기 안에서만 바꾸고 어디에도 보내지 않습니다.</p>
  <FileChecksums spec={spec} version={version} />
  <slot />
</div>

<script>
  const need = <T extends Element>(root: ParentNode, selector: string) => {
    const element = root.querySelector<T>(selector);
    if (!element) throw new Error(`Missing ${selector}`);
    return element;
  };

  for (const box of document.querySelectorAll<HTMLElement>('.patch-box')) {
    const input = need<HTMLInputElement>(box, 'input[type=file]');
    const zone = need<HTMLElement>(box, '.drop-zone');
    const status = need<HTMLElement>(box, '.patch-status');
    const text = need<HTMLElement>(status, '.status-text');
    const actions = need<HTMLElement>(status, '.status-actions');
    const output = box.dataset['output'] ?? '';
    let download: string | undefined;

    if (/KAKAOTALK|NAVER\(inapp|Instagram|FBAN|FBAV|Line\//.test(navigator.userAgent)) {
      need<HTMLElement>(box, '.inapp-warning').hidden = false;
    }

    const show = (message: string, buttons: { label: string; run: () => void }[] = []) => {
      status.hidden = false;
      text.textContent = message;
      actions.replaceChildren(
        ...buttons.map(({ label, run }) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'pointer';
          button.textContent = label;
          button.addEventListener('click', run);
          return button;
        }),
      );
    };

    const save = (bytes: Uint8Array, name: string) => {
      if (download) URL.revokeObjectURL(download);
      download = URL.createObjectURL(new Blob([bytes.slice()], { type: 'application/octet-stream' }));
      const link = document.createElement('a');
      link.href = download;
      link.download = name;
      link.click();
    };

    const handle = async (file: File) => {
      show('파일을 살펴보는 중입니다.');
      const flow =
        box.dataset['platform'] === 'nds' ? import('../../lib/nds-patch-box') : import('../../lib/sfc-patch-box');
      let bytes: Uint8Array;
      try {
        bytes = new Uint8Array(await file.arrayBuffer());
      } catch {
        show('파일을 읽지 못했습니다. 클라우드에 있는 파일이면 먼저 이 기기에 내려받은 뒤 다시 골라 주세요.');
        return;
      }
      const ui = { spec: box.dataset['spec'] ?? '', patch: box.dataset['ips'] ?? '', output, show, save };
      await (await flow).handleFile(ui, file.name, bytes);
    };

    input.addEventListener('change', () => {
      const [file] = input.files ?? [];
      if (file) void handle(file);
      input.value = '';
    });
    zone.addEventListener('dragover', event => {
      event.preventDefault();
      zone.classList.add('dragging');
    });
    zone.addEventListener('dragleave', () => zone.classList.remove('dragging'));
    zone.addEventListener('drop', event => {
      event.preventDefault();
      zone.classList.remove('dragging');
      const [file, ...rest] = event.dataTransfer?.files ?? [];
      if (!file) return;
      if (rest.length) show('파일은 한 번에 하나만 골라 주세요.');
      else void handle(file);
    });
  }
</script>
