---
import type { RomSpec } from '../../lib/rom-patch';

interface Props {
  ips: string;
  spec: RomSpec;
  /** File name of the saved Korean ROM, without the extension. */
  output: string;
}

const { ips, spec, output } = Astro.props;
---

<div class="patch-box frame" data-ips={ips} data-spec={JSON.stringify(spec)} data-output={output}>
  <p class="inapp-warning dialog" hidden>
    메신저 앱 안에서 열린 화면이라 파일을 고르거나 저장하지 못할 수 있습니다. 메뉴에서 "다른 브라우저로 열기"를 눌러
    크롬이나 사파리로 열어 주세요.
  </p>
  <label class="drop-zone">
    <input class="sr-only" type="file" accept=".sfc,.smc,.fig,.swc,.zip" />
    <span class="drop-title pointer">일본판 게임 파일 고르기</span>
    <span class="drop-hint">.sfc · .smc · .zip 파일을 고르거나 여기로 끌어다 놓으세요</span>
  </label>
  <div class="patch-status dialog" role="status" aria-live="polite" hidden>
    <p class="status-text"></p>
    <div class="status-actions"></div>
  </div>
  <p class="privacy">파일은 이 기기 안에서만 바꾸고 어디에도 보내지 않습니다.</p>
</div>

<script>
  import type { RomSpec } from '../../lib/rom-patch';

  type Patch = typeof import('../../lib/rom-patch');

  const need = <T extends Element>(root: ParentNode, selector: string) => {
    const element = root.querySelector<T>(selector);
    if (!element) throw new Error(`Missing ${selector}`);
    return element;
  };

  for (const box of document.querySelectorAll<HTMLElement>('.patch-box')) {
    const input = need<HTMLInputElement>(box, 'input[type=file]');
    const zone = need<HTMLElement>(box, '.drop-zone');
    const status = need<HTMLElement>(box, '.patch-status');
    const text = need<HTMLElement>(status, '.status-text');
    const actions = need<HTMLElement>(status, '.status-actions');
    const spec = JSON.parse(box.dataset['spec'] ?? '') as RomSpec;
    const output = box.dataset['output'] ?? '';
    let download: string | undefined;

    if (/KAKAOTALK|NAVER\(inapp|Instagram|FBAN|FBAV|Line\//.test(navigator.userAgent)) {
      need<HTMLElement>(box, '.inapp-warning').hidden = false;
    }

    const show = (message: string, buttons: { label: string; run: () => void }[] = []) => {
      status.hidden = false;
      text.textContent = message;
      actions.replaceChildren(
        ...buttons.map(({ label, run }) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'pointer';
          button.textContent = label;
          button.addEventListener('click', run);
          return button;
        }),
      );
    };

    const save = (bytes: Uint8Array, name: string) => {
      if (download) URL.revokeObjectURL(download);
      download = URL.createObjectURL(new Blob([bytes.slice()], { type: 'application/octet-stream' }));
      const link = document.createElement('a');
      link.href = download;
      link.download = name;
      link.click();
    };

    const make = async (patch: Patch, source: Uint8Array, allowUnverified: boolean) => {
      show('한글판을 만드는 중입니다. 잠시만 기다려 주세요.');
      let ipsBytes: Uint8Array;
      try {
        const response = await fetch(box.dataset['ips'] ?? '');
        if (!response.ok) throw new Error(String(response.status));
        ipsBytes = new Uint8Array(await response.arrayBuffer());
      } catch {
        show('한글패치 파일을 받지 못했습니다. 인터넷 연결을 확인한 뒤 다시 시도해 주세요.', [
          { label: '다시 시도', run: () => void make(patch, source, allowUnverified) },
        ]);
        return;
      }
      try {
        const rom = patch.createPatchedRom(spec, source, ipsBytes, { allowUnverified });
        const name = `${output}${allowUnverified ? '_Unverified' : ''}.sfc`;
        save(rom, name);
        show(
          `${name} 파일을 저장했습니다. 평소 쓰는 에뮬레이터나 기기에서 이 파일을 열면 한글판으로 시작합니다.` +
            (allowUnverified ? ' 원본이 달랐으니 이상하면 수정되지 않은 일본판 원본으로 다시 만들어 주세요.' : ''),
          [{ label: '다시 저장', run: () => save(rom, name) }],
        );
      } catch (error) {
        show(
          error instanceof Error
            ? error.message
            : '한글판을 만들지 못했습니다. 페이지를 새로 고친 뒤 다시 시도해 주세요.',
        );
      }
    };

    const handle = async (file: File) => {
      show('파일을 살펴보는 중입니다.');
      const patch = await import('../../lib/rom-patch');
      let name = file.name;
      let bytes: Uint8Array;
      try {
        bytes = new Uint8Array(await file.arrayBuffer());
      } catch {
        show('파일을 읽지 못했습니다. 클라우드에 있는 파일이면 먼저 이 기기에 내려받은 뒤 다시 골라 주세요.');
        return;
      }
      if (patch.isZip(bytes, name)) {
        const found = await patch.extractRomFromZip(spec, bytes);
        if (!found) {
          show('이 압축 파일은 열지 못했습니다. 압축을 직접 푼 뒤 안에 있는 .sfc 또는 .smc 파일 하나를 골라 주세요.');
          return;
        }
        ({ name, bytes } = found);
      } else if (patch.isOtherArchive(bytes, name)) {
        show('.7z·.rar 같은 압축 파일은 열지 못합니다. 압축을 직접 푼 뒤 .sfc 또는 .smc 파일을 골라 주세요.');
        return;
      }
      const verdict = patch.classifyRom(spec, bytes);
      switch (verdict.kind) {
        case 'too-small':
          show(`${name} 파일은 게임 파일이라기엔 너무 작습니다. 사진이나 문서를 고르지 않았는지 확인해 주세요.`);
          return;
        case 'truncated':
          show('필요한 크기보다 조금 작습니다. 옮기다가 덜 받아졌을 수 있으니 원래 파일을 다시 옮겨 와서 골라 주세요.');
          return;
        case 'wrong-size':
          show(
            `크기가 ${patch.megabytes(spec)}인 파일이 필요합니다. 다른 게임이거나 여러 파일이 묶인 파일일 수 있습니다.`,
          );
          return;
        case 'wrong-game':
          show(`다른 게임 파일 같습니다. 이 파일로는 ${spec.name} 한글판을 만들 수 없습니다.`);
          return;
        case 'other-region':
          show(
            `${spec.name} 파일이지만 일본판이 아닙니다. 미국판 등 다른 나라 판에는 이 한글패치를 적용할 수 없습니다.`,
          );
          return;
        case 'old-korean':
          show(
            `${verdict.version ? `이전 버전(${verdict.version})` : '예전에 나온'} 한글판 파일입니다. 새 버전은 수정하지 않은 일본판 원본에 적용해야 하니 일본판 파일을 골라 주세요.`,
          );
          return;
        case 'already-korean':
          show('이미 한글패치를 적용한 파일입니다. 그대로 즐기면 됩니다.');
          return;
        case 'original':
          await make(patch, bytes, false);
          return;
        case 'different':
          show(
            `${spec.name} 일본판은 맞지만 알려진 원본과 조금 다릅니다. 이대로 만들면 게임이 제대로 돌아가지 않을 수 있어 다른 파일을 고르는 것을 권합니다.`,
            [{ label: '그래도 만들기', run: () => void make(patch, bytes, true) }],
          );
      }
    };

    input.addEventListener('change', () => {
      const [file] = input.files ?? [];
      if (file) void handle(file);
      input.value = '';
    });
    zone.addEventListener('dragover', event => {
      event.preventDefault();
      zone.classList.add('dragging');
    });
    zone.addEventListener('dragleave', () => zone.classList.remove('dragging'));
    zone.addEventListener('drop', event => {
      event.preventDefault();
      zone.classList.remove('dragging');
      const [file, ...rest] = event.dataTransfer?.files ?? [];
      if (!file) return;
      if (rest.length) show('파일은 한 번에 하나만 골라 주세요.');
      else void handle(file);
    });
  }
</script>
