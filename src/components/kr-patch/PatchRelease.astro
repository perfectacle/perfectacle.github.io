---
import { statSync } from 'node:fs';
import { PLATFORMS, releaseOf, type KrPatch } from '../../lib/kr-patches';
import FileChecksums from './FileChecksums.astro';

interface Props {
  patch: KrPatch;
  version: string;
}

const { patch, version } = Astro.props;
const release = releaseOf(patch, version);
const kb = Math.ceil(statSync(`public${release.ips}`).size / 1024);
const kind = PLATFORMS[patch.platform].patchExt === 'ips' ? 'IPS' : 'xdelta';
---

<article class="patch-release" aria-labelledby={release.id} data-release={release.id}>
  <div class="release-head">
    <h3 id={release.id} class="pixel">
      <a class="heading-link" href={`#${release.id}`}>
        v{release.version}
        {release.latest && ' · 최신 버전'}
      </a>
    </h3>
    <time class="section-note" datetime={release.date}>
      {release.dateText}
    </time>
  </div>
  <a class="release-download" href={release.ips} download>
    <svg class="floppy" viewBox="0 0 16 16" width="32" height="32" aria-hidden="true" shape-rendering="crispEdges">
      <path fill="currentColor" d="M1 1h12l2 2v12H1z" />
      <path fill="#10131c" d="M4 1h7v5H4zM3 9h10v6H3z" />
      <path fill="currentColor" d="M8 2h2v3H8z" />
      <path fill="currentColor" opacity="0.5" d="M4 10h8v1H4zm0 2h8v1H4z" />
    </svg>
    <span class="release-download-text">
      <strong>v{release.version} 패치 파일 받기</strong>
      <small>
        {kind} 파일 · {kb.toLocaleString('ko-KR')}KB
      </small>
    </span>
  </a>
  <FileChecksums spec={patch.spec} version={release.version} rom={release.rom} />
  <slot />
</article>

<script>
  const releases = [...document.querySelectorAll<HTMLElement>('.patch-release[data-release]')];

  // A link to a version, or to anything inside its notes, opens those notes so the shared view matches.
  const reveal = (settle = false) => {
    const id = decodeURIComponent(location.hash.slice(1));
    const target = id ? document.getElementById(id) : null;
    if (!target) return;
    const details = target.closest('.patch-release')?.querySelector<HTMLDetailsElement>('.release-details');
    const hidden = !!details && !details.open && details.contains(target);
    if (details) details.open = true;
    if (hidden || settle) target.scrollIntoView({ behavior: settle ? 'instant' : 'smooth' });
  };

  for (const release of releases) {
    const id = release.dataset['release'] ?? '';
    const details = release.querySelector<HTMLDetailsElement>('.release-details');
    if (!details) continue;

    // Opening a version puts its address in the bar, so copying the page address shares these notes open.
    details.addEventListener('toggle', () => {
      if (details.open && location.hash !== `#${id}`) history.replaceState(history.state, '', `#${id}`);
      if (!details.open && location.hash === `#${id}`)
        history.replaceState(history.state, '', location.pathname + location.search);
    });
  }

  // Scripts that fold sections and the fonts and pictures above a shared anchor move it after the browser's first
  // jump, so land on it again once the page has settled, unless the reader has already moved on.
  reveal(true);
  let moved = false;
  for (const type of ['wheel', 'touchstart', 'keydown', 'pointerdown'])
    window.addEventListener(type, () => (moved = true), { once: true, passive: true });
  const settle = () => !moved && reveal(true);
  window.addEventListener('load', settle, { once: true });
  // Web fonts can finish after load and change line heights above the anchor.
  void document.fonts.ready.then(settle);
  window.addEventListener('hashchange', () => reveal());
</script>

<style>
  .release-head {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    align-items: center;
  }

  .release-head h3 {
    margin: 0;
  }

  .release-head time {
    margin: 0;
  }

  .release-download {
    display: inline-flex;
    justify-self: start;
    width: fit-content;
    gap: 12px;
    align-items: center;
    margin-block: 4px;
    padding: 10px 18px 10px 12px;
    border: 2px solid var(--accent);
    border-radius: 6px;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--accent);
    text-decoration: none;
  }

  .release-download:hover {
    background: color-mix(in srgb, var(--accent) 22%, transparent);
  }

  .release-download:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .floppy {
    flex: none;
  }

  .release-download-text {
    display: grid;
    line-height: 1.4;
  }

  .release-download-text strong {
    font-size: 1rem;
  }

  .release-download-text small {
    color: var(--muted);
    font-size: 0.8125rem;
  }
</style>
