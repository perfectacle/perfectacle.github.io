---
interface Props {
  /** Optional short heading for items that group several screens. */
  title?: string | undefined;
  /** Where the change is explained in use, such as a feature on this page or the other game's notes. */
  more?: { href: string; label: string } | undefined;
}

const { title, more } = Astro.props;
---

<section class="release-item">
  {title && <h4 class="release-item-title">{title}</h4>}
  <slot />
  {more && (
    <p class="release-more">
      <a class="pointer" href={more.href}>
        {more.label} <span aria-hidden="true">→</span>
      </a>
    </p>
  )}
</section>

<style>
  .release-item {
    display: grid;
    gap: 16px;
    min-width: 0;
  }

  /* Items run together inside one details box, so each one after the first starts below a rule. */
  .release-item + .release-item {
    margin-top: 12px;
    padding-top: 28px;
    border-top: 2px solid color-mix(in srgb, var(--muted) 70%, transparent);
  }

  .release-item-title {
    margin: 0;
    font-size: 1rem;
  }

  .release-item > :global(p),
  .release-item > :global(ul) {
    max-inline-size: 42rem;
  }

  .release-item > :global(ul) {
    padding-left: 1.5em;
    list-style: disc;
  }

  .release-more a {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
  }
</style>
