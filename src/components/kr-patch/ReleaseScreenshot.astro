---
interface Props {
  src: string;
  width: number;
  height: number;
  alt: string;
  caption: string;
}

const { src, width, height, alt, caption } = Astro.props;
---

<figure class="release-screenshot">
  <a href={src} aria-label={`${caption} 크게 보기`}>
    <img src={src} width={width} height={height} alt={alt} loading="lazy" decoding="async" />
  </a>
  <figcaption>
    {caption}
    <span class="image-hint">사진을 눌러 크게 보기</span>
  </figcaption>
</figure>

<style>
  .release-screenshot {
    display: grid;
    justify-items: start;
    gap: 8px;
    min-width: 0;
    margin: 0;
  }

  img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    image-rendering: pixelated;
  }

  a {
    display: block;
    max-width: 100%;
  }

  .image-hint {
    display: block;
    font-size: 0.8rem;
  }

  figcaption {
    font-size: 0.9rem;
    line-height: 1.6;
  }
</style>
