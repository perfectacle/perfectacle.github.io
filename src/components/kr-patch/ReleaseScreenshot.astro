---
import type { ReleasePanel, ScreenshotHighlight } from '../../lib/version-pairs';
import Screenshot from './Screenshot.astro';

interface Props {
  src?: string;
  width?: number;
  height?: number;
  alt?: string;
  caption?: string | undefined;
  highlights?: ScreenshotHighlight[];
  /** Side-by-side cells, older version first. */
  panels?: ReleasePanel[];
  /** Several rows of cells for scenes that span more than one screen. */
  rows?: ReleasePanel[][];
}

const { src, width = 256, height = 224, alt = '', caption, highlights, panels, rows } = Astro.props;
const lines = rows ?? (panels ? [panels] : [[{ alt }]]);
const columns = Math.max(...lines.map(line => line.length));
---

<figure class={`release-screenshot columns-${columns}`} style={`--release-columns: ${columns}`}>
  {lines.map(line => (
    <div class="release-panels">
      {line.map(panel => (
        <div class="release-panel">
          {panel.label && <p class="panel-label">{panel.label}</p>}
          {panel.note ? (
            <p class="panel-note">{panel.note}</p>
          ) : (
            <Screenshot
              src={panel.src ?? src ?? ''}
              width={panel.width ?? width}
              height={panel.height ?? height}
              alt={panel.alt}
              crop={panel.crop}
              highlights={panel.highlights ?? highlights}
            />
          )}
        </div>
      ))}
    </div>
  ))}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .release-screenshot {
    display: grid;
    gap: 12px;
    min-width: 0;
    width: 100%;
    max-width: calc(var(--release-columns) * 512px + (var(--release-columns) - 1) * 16px + 26px);
    margin: 0;
    /* A card per figure, so a caption visibly belongs to the screens above it and not to the next figure. */
    padding: 12px;
    border: 1px solid color-mix(in srgb, var(--muted) 35%, transparent);
    border-radius: 6px;
    background: rgb(0 0 0 / 22%);
    container: release / inline-size;
  }

  /* Cells are exactly one or two screens wide, chosen by the room for the whole row; too narrow, one per row. */
  .release-panels {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    width: 100%;
  }

  @container release (width >= 528px) {
    .columns-2 .release-panels {
      grid-template-columns: repeat(2, 256px);
    }
  }

  @container release (width >= 1040px) {
    .columns-2 .release-panels {
      grid-template-columns: repeat(2, 512px);
    }
  }

  @container release (width >= 800px) {
    .columns-3 .release-panels {
      grid-template-columns: repeat(3, 256px);
    }
  }

  @container release (width >= 1568px) {
    .columns-3 .release-panels {
      grid-template-columns: repeat(3, 512px);
    }
  }

  .release-panel {
    display: grid;
    gap: 8px;
    align-content: start;
    min-width: 0;
  }

  .panel-label {
    font-weight: bold;
  }

  .panel-note {
    display: grid;
    place-items: center;
    aspect-ratio: 256 / 224;
    padding: 12px;
    border: 1px dashed var(--muted);
    color: var(--muted);
    text-align: center;
  }

  .release-panel :global(.patch-image-trigger) {
    width: 100%;
  }

  figcaption {
    font-size: 1rem;
    line-height: 1.75;
  }
</style>
