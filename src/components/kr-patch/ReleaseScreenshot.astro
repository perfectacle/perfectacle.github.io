---
import type { ScreenshotHighlight } from '../../lib/version-pairs';
import Screenshot from './Screenshot.astro';

interface Props {
  src: string;
  width: number;
  height: number;
  alt: string;
  caption: string;
  highlights?: ScreenshotHighlight[];
}

const { src, width, height, alt, caption, highlights } = Astro.props;
---

<figure class="release-screenshot">
  <Screenshot src={src} width={width} height={height} alt={alt} highlights={highlights} />
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .release-screenshot {
    display: grid;
    justify-items: start;
    gap: 8px;
    min-width: 0;
    margin: 0;
  }

  figcaption {
    font-size: 0.9rem;
    line-height: 1.6;
  }
</style>
