---
import type { ScreenshotCrop, ScreenshotHighlight } from '../../lib/version-pairs';

interface Props {
  src: string;
  width: number;
  height: number;
  alt: string;
  highlights?: ScreenshotHighlight[] | undefined;
  crop?: ScreenshotCrop | undefined;
}

const { src, width, height, alt, highlights = [], crop = [0, 0, width, height] } = Astro.props;
const [cropX, cropY, cropWidth, cropHeight] = crop;
const dimensions = `--patch-image-width: ${cropWidth}px; --patch-image-ratio: ${cropWidth / cropHeight}; --patch-source-width: ${(width / cropWidth) * 100}%; --patch-source-height: ${(height / cropHeight) * 100}%; --patch-source-left: ${(-cropX / cropWidth) * 100}%; --patch-source-top: ${(-cropY / cropHeight) * 100}%`;
---

<button class="patch-image-trigger" type="button" data-patch-preview aria-label={`${alt} 크게 보기`} style={dimensions}>
  <span class="patch-picture" style={dimensions}>
    <img src={src} width={width} height={height} alt={alt} loading="lazy" decoding="async" />
    {highlights.length > 0 && (
      <svg class="patch-highlights" viewBox={crop.join(' ')} aria-hidden="true" focusable="false">
        {highlights.map(([x, y, rectWidth, rectHeight]) => (
          <rect x={x} y={y} width={rectWidth} height={rectHeight} vector-effect="non-scaling-stroke" />
        ))}
      </svg>
    )}
  </span>
</button>

<style>
  .patch-image-trigger {
    display: block;
    width: min(100%, calc(var(--patch-image-width) * 2));
    min-width: 0;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }

  .patch-image-trigger:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }

  .patch-picture {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: var(--patch-image-ratio);
    overflow: clip;
  }

  .patch-picture img {
    display: block;
    position: absolute;
    left: var(--patch-source-left);
    top: var(--patch-source-top);
    width: var(--patch-source-width);
    height: var(--patch-source-height);
    max-width: none;
    image-rendering: pixelated;
  }

  .patch-highlights {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  rect {
    fill: none;
    stroke: #ff3333;
    stroke-width: 2px;
  }
</style>
