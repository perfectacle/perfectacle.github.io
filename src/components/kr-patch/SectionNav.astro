---
interface Props {
  sections: { id: string; label: string }[];
}

const { sections } = Astro.props;
const items = [{ id: 'patch', label: '한글패치 하기' }, ...sections, { id: 'main', label: '맨 위로' }];
---

<nav class="patch-section-nav" aria-label="페이지 내 이동">
  <details class="section-nav-menu frame">
    <summary>
      <span class="section-nav-current">한글패치 하기</span>
    </summary>
    <ul>
      {items.map(({ id, label }) => (
        <li>
          <a class="pointer" href={`#${id}`} aria-current={id === 'patch' ? 'location' : undefined}>
            {label}
          </a>
        </li>
      ))}
    </ul>
  </details>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>('.patch-section-nav');
  const menu = nav?.querySelector<HTMLDetailsElement>('details');
  const current = nav?.querySelector<HTMLElement>('.section-nav-current');

  if (nav && menu && current) {
    nav.dataset['enhanced'] = 'true';
    const wide = window.matchMedia('(min-width: 1500px)');
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const targets = links.flatMap(link => {
      if (link.hash === '#main') return [];
      const target = document.getElementById(link.hash.slice(1));
      return target ? [{ link, target }] : [];
    });
    let anchorMargin = 0;
    const update = () => {
      const threshold = Math.max(anchorMargin, wide.matches ? 32 : nav.getBoundingClientRect().height + 24) + 2;
      const ordered = [...targets].sort(
        (a, b) => a.target.getBoundingClientRect().top - b.target.getBoundingClientRect().top,
      );
      let active = ordered[0];
      for (const item of ordered) {
        if (item.target.getBoundingClientRect().top <= threshold) active = item;
      }
      for (const { link } of targets) {
        if (link === active?.link) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
      current.textContent = active?.link.textContent?.trim() ?? '한글패치 하기';
    };
    let scheduled = false;
    const schedule = () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(() => {
        scheduled = false;
        update();
      });
    };
    const box = document.getElementById('patch');
    const measure = () => {
      // The wide menu starts level with the patch box, which sits below a title whose height depends on the page.
      if (box) nav.style.setProperty('--nav-start', `${box.getBoundingClientRect().top + window.scrollY}px`);
      const target = targets[0]?.target;
      anchorMargin = target ? parseFloat(getComputedStyle(target).scrollMarginTop) || 0 : 0;
      schedule();
    };
    const resize = () => {
      menu.open = wide.matches;
      measure();
    };
    for (const link of links) {
      link.addEventListener('click', () => {
        if (!wide.matches) menu.open = false;
        schedule();
      });
    }
    menu.addEventListener('toggle', () => {
      if (wide.matches && !menu.open) menu.open = true;
    });
    wide.addEventListener('change', resize);
    window.addEventListener('resize', measure);
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('hashchange', schedule);
    window.addEventListener('popstate', schedule);
    window.addEventListener('pageshow', schedule);
    window.addEventListener('load', measure, { once: true });
    resize();
  }
</script>

<style is:global>
  .patch-section-nav {
    position: relative;
    top: 0;
    z-index: 5;
    padding: 8px 16px;
    font-size: 1rem;
  }

  .section-nav-menu.frame {
    max-height: calc(100dvh - 16px);
    overflow-y: auto;
    background-color: #14161e;
  }

  .section-nav-menu summary {
    display: flex;
    flex-wrap: wrap;
    gap: 0 12px;
    align-items: center;
    cursor: pointer;
    list-style: none;
    min-height: 28px;
  }

  .section-nav-menu summary::-webkit-details-marker {
    display: none;
  }

  .section-nav-menu summary::after {
    content: '＋' / '';
    margin-left: auto;
    color: var(--accent);
  }

  .section-nav-menu[open] summary::after {
    content: '−' / '';
  }

  .section-nav-current {
    color: var(--accent);
  }

  .section-nav-menu ul {
    display: grid;
    gap: 4px;
    padding: 8px 0 0 30px;
    list-style: none;
  }

  .section-nav-menu a {
    display: block;
    padding-block: 8px;
    color: var(--ink);
    line-height: 1.5;
  }

  .section-nav-menu a[aria-current='location'] {
    color: var(--accent);
  }

  .section-nav-menu a[aria-current='location']::before {
    opacity: 1;
  }

  .has-section-nav :is(#main, #patch, #comments, .section, .section [id]) {
    scroll-margin-top: 104px;
  }

  [data-theme='gokuden'] .section-nav-menu.frame {
    background-color: #00008c;
  }

  [data-theme='otogirisou'] .section-nav-menu.frame {
    background-color: #000;
  }

  @media (max-width: 1499px) {
    .patch-section-nav[data-enhanced] {
      position: sticky;
    }
  }

  @media (min-width: 1500px) {
    .has-section-nav {
      position: relative;
      padding-right: 240px;
    }

    /* A column down the right edge from the patch box; the menu inside sticks to the top once scrolled past. */
    .patch-section-nav {
      position: absolute;
      top: var(--nav-start, 80px);
      right: 16px;
      bottom: 0;
      width: 208px;
      padding: 0;
    }

    .section-nav-menu.frame {
      position: sticky;
      top: 24px;
      max-height: calc(100dvh - 48px);
      padding: 12px 8px;
    }

    /* The footer runs under the menu column too, so its centered text sits in the middle of the window. */
    .has-section-nav .page-footer {
      width: auto;
      margin-inline: 0 -240px;
    }

    .patch-section-nav[data-enhanced] .section-nav-menu summary {
      display: none;
    }

    /* A mouse needs no 44px touch rows; the list stays one short block. */
    .section-nav-menu ul {
      gap: 0;
      padding-top: 0;
    }

    .section-nav-menu a {
      padding-block: 3px;
    }

    .has-section-nav :is(#main, #patch, #comments, .section, .section [id]) {
      scroll-margin-top: 24px;
    }
  }
</style>
