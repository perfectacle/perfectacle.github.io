---
interface Props {
  items: { path: string; text: string }[];
}

const { items } = Astro.props;
---

<aside class="tool-files" aria-label="패치 소스에서 이 내용에 해당하는 파일">
  <p class="tool-files-title">패치 소스 속 파일</p>
  <ul>
    {items.map(item => (
      <li>
        <code>{item.path}</code> {item.text}
      </li>
    ))}
  </ul>
</aside>

<style>
  .tool-files {
    padding: 10px 14px;
    border: 1px dashed rgb(255 255 255 / 35%);
    border-radius: 6px;
    font-size: 1rem;
  }

  .tool-files-title {
    margin: 0 0 4px;
    color: var(--accent);
    font-weight: 700;
  }

  .tool-files ul {
    display: grid;
    gap: 2px;
    margin: 0;
    padding-left: 18px;
  }

  .tool-files code {
    font-family: var(--mono);
    font-size: 0.875em;
    overflow-wrap: anywhere;
  }
</style>
