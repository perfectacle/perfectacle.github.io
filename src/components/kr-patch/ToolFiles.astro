---
import type { KrPatch } from '../../lib/kr-patches';
import SourceFile from './SourceFile.astro';

interface Props {
  patch: KrPatch;
  /** `path` lists one or more files, separated by `, `: patch source paths, toolkit Lua scripts marked
   * `(krpatch sfc lua)`, or `krpatch` commands. */
  items: { path: string; text: string }[];
}

const { patch, items } = Astro.props;
---

<aside class="tool-files" aria-label="패치 소스에서 이 내용에 해당하는 파일">
  <p class="tool-files-title">패치 소스 속 파일</p>
  <ul>
    {items.map(item => (
      <li>
        <SourceFile patch={patch} name={item.path} /> {item.text}
      </li>
    ))}
  </ul>
</aside>

<style>
  .tool-files {
    padding: 12px 16px;
    border-radius: 8px;
    background: rgb(255 255 255 / 5%);
    box-shadow: inset 3px 0 0 var(--muted);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .tool-files-title {
    margin: 0 0 6px;
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .tool-files ul {
    display: grid;
    gap: 4px;
    margin: 0;
    padding-left: 18px;
  }

  .tool-files :global(code) {
    padding: 1px 6px;
    border-radius: 4px;
    background: rgb(255 255 255 / 10%);
    color: var(--link);
    font-family: var(--mono);
    font-size: 0.875em;
    overflow-wrap: anywhere;
  }

  .tool-files :global(a) {
    text-decoration: none;
  }

  .tool-files :global(a:hover code),
  .tool-files :global(a:focus-visible code) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
