---
import type { Version, VersionPair } from '../../lib/version-pairs';
import Speech from './Speech.astro';
import Screenshot from './Screenshot.astro';

interface Props {
  pair: VersionPair;
  base: string;
  /** Older release first; the last one is highlighted as the current patch. */
  versions: Version[];
  /** Page guide who speaks the caption; without one the caption is a plain dialog box. */
  speaker?: string | undefined;
}

const { pair, base, versions, speaker } = Astro.props;
const frames = pair.frames ?? 1;
const selectedFrames = pair.selectedFrames ?? Array.from({ length: frames }, (_, i) => i + 1);
const height = pair.height ?? 224;
const latest = versions.at(-1)?.key;
const order = (frame: number) => (selectedFrames.length > 1 ? ` (${frame}/${frames})` : '');
---

<figure class="compare version-pair">
  {selectedFrames.map(frame => (
    <div class="compare-shots">
      {versions.map(version => {
        const gap = pair.gaps?.[`${version.key}:${frame}`];
        return (
          <div class="shot">
            <span class:list={['tag', { 'tag-ko': version.key === latest }]} aria-hidden="true">
              {version.label}
            </span>
            <div class="screen">
              {gap ? (
                <p class="gap-note">
                  <span class="sr-only">{version.label}: </span>
                  {gap}
                </p>
              ) : (
                <Screenshot
                  src={`${base}/images/patch/${pair.id}_${version.key}_${frame}.webp`}
                  width={256}
                  height={height}
                  alt={`${version.label}: ${pair.alt}${order(frame)}`}
                  highlights={pair.highlights?.[`${version.key}:${frame}`]}
                />
              )}
            </div>
          </div>
        );
      })}
    </div>
  ))}
  {speaker ? (
    <Speech speaker={speaker} tag="figcaption">
      {pair.caption}
    </Speech>
  ) : (
    <figcaption class="dialog">{pair.caption}</figcaption>
  )}
</figure>

<style>
  .version-pair :global(.patch-image-trigger) {
    width: min(100%, 256px);
  }
</style>
