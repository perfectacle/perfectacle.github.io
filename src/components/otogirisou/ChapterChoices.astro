---
interface Props {
  /** The next chapter, if any; the last chapter only offers the way back to the title. */
  next?: { id: string; label: string } | undefined;
}

const { next } = Astro.props;
---

<div class="chapter-choices">
  {next && (
    <a class="pointer" href={`#${next.id}`}>
      다음 장으로 — {next.label}
    </a>
  )}
  <a class="pointer" href="#title">
    타이틀로
  </a>
</div>
