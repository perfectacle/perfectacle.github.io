---
import ToolFiles from '../smrpg/ToolFiles.astro';
import ChapterChoices from './ChapterChoices.astro';

interface Props {
  base: string;
  /** Chapter title shown above the heading, matching the page's other chapters. */
  mark: string;
}

const { base, mark } = Astro.props;
const img = (name: string) => `${base}/images/making/${name}`;
const zip = `${base}/downloads/Otogirisou_K_v1_2_tools.zip`;

const memories = [
  {
    name: '롬',
    like: '책',
    role: '카트리지에 든 프로그램·대사·그림·폰트. 읽기만 합니다. 이 게임은 1MB, 한글판은 2MB.',
  },
  {
    name: 'WRAM',
    like: '작업 책상',
    role: 'CPU가 계산하며 값을 적어 두는 128KB. 지금 읽는 위치, 선택지 기록이 여기 있습니다.',
  },
  { name: 'SRAM', like: '책갈피', role: '전원을 꺼도 남는 세이브 메모리. 책갈피 슬롯 4개가 들어 있습니다.' },
  { name: 'VRAM', like: '스티커판', role: '화면에 붙일 그림 조각을 올려 두는 64KB. CPU가 아무 때나 쓸 수 없습니다.' },
];

const codes = [
  { code: '{00}', text: '줄바꿈' },
  { code: '{03:@주소}', text: '대본의 다른 곳으로 점프' },
  { code: '{16}', text: 'A 버튼을 기다림' },
  { code: '{19} {1A}', text: '선택지. 보기마다 갈 곳(점프 주소)이 붙어 있음' },
  { code: '{1C}', text: '선택지 보기 하나의 끝' },
  { code: '{20}', text: '주인공 이름' },
  { code: '{25}', text: '화면을 지우고 다음 페이지로' },
  { code: '{2E}…{37}', text: '배경 그림 바꾸기' },
  { code: '{39}…{3D}', text: '음악·효과음 재생과 정지' },
];

const recordLayout = [
  { offset: '+0', size: '4바이트', text: '이번 회차에 읽은 장 (장 하나가 1비트)' },
  { offset: '+4', size: '4바이트', text: '지금까지 읽은 장' },
  { offset: '+8', size: '4바이트', text: '본 엔딩' },
  { offset: '+12', size: '1바이트', text: '마지막으로 읽은 장 (책갈피에 표시)' },
  { offset: '+13', size: '2바이트', text: '장에 들어갈 때의 갈래 변수와 그 유무' },
];

const debugSteps = [
  '프레임마다 CPU가 실행 중인 주소(PC)를 기록해 어디서 멈췄는지 찾습니다.',
  '멈춘 곳이 기다리는 메모리 값에 쓰기 감시를 걸어, 그 값을 바꾸는 코드의 주소와 호출 순서를 봅니다.',
  '정상으로 진행하는 경우에도 같은 감시를 걸어 두 기록을 나란히 비교합니다.',
];

const emulators = [
  { name: 'Mesen 2', result: '정상 (1~4회차, 모든 세이브 종류 이어하기)' },
  { name: 'bsnes, bsnes-hd beta', result: '정상' },
  { name: 'snes9x, snes9x2010', result: '정상' },
  { name: 'Beetle Supafaust', result: '정상' },
  { name: 'Mesen-S 코어', result: '판정 불가 (일본판 원본도 테스트 프로그램에서 바로 종료)' },
];

const toolMap = [
  { job: '대사 꺼내기·다시 넣기', files: ['tools/script.py', 'tools/dump.py', 'tools/assemble.py'] },
  { job: '롬 코드 읽기', files: ['tools/dis65816.py'] },
  { job: '2회차 멈춤 수정', files: ['tools/fixes.py', 'lua/lap.lua'] },
  { job: 'A 버튼 대기 맞추기', files: ['tools/waits.py', 'tools/fixwaits.py', 'lua/waitdemo.lua'] },
  { job: '글자표·새 글자', files: ['tools/font.py', 'tools/ocr/', 'tools/mkfont.py', 'tools/glyph_workbench.py'] },
  { job: '단어 단위 줄바꿈', files: ['asm/wordwrap.asm', 'tools/layout.py', 'tools/splitpages.py'] },
  { job: '재번역 반영', files: ['tools/trcheck.py', 'tools/trmerge.py', 'tools/rvapply.py'] },
  { job: '옛 세이브 이어하기', files: ['tools/savemap.py', 'asm/savecompat.asm'] },
  { job: '장·엔딩·메뉴 데이터', files: ['tools/qol.py', 'tables/qol-chapters.tsv', 'tables/qol-endings.tsv'] },
  { job: '편의 기능 코드', files: ['asm/qol.asm'] },
  { job: '플로차트', files: ['tools/flow.py', 'asm/flow.asm'] },
  { job: '화면 찍기·비교', files: ['lua/pages.lua', 'lua/name.lua', 'lua/jumpsave.py', 'tools/patchnote.py'] },
  { job: '엔진 추적', files: ['lua/qol/pcs.lua', 'lua/qol/wtrace.lua', 'lua/qol/trace.lua', 'lua/qol/watch.lua'] },
  { job: '장 이동 회귀', files: ['lua/qol/menujump.sh', 'lua/qol/chjump.sh'] },
  { job: '에뮬레이터 호환성', files: ['compat/lr.py', 'compat/run_all.sh'] },
];
---

<section id="making" class="section page-width" aria-labelledby="making-title">
  <p class="label chapter-mark">{mark}</p>
  <h2 id="making-title" class="pixel">
    한글판을 만든 방법
  </h2>
  <p class="lead">
    2016년에 낸 v1.0은 2회차부터 멈추거나, A 버튼을 누르지 않았는데 화면이 넘어가거나, 단어 중간에서 줄이 끊기는 문제가
    있었습니다. v1.1은 이 문제를 롬에서 원인을 찾아 고치고 번역을 원문과 대조해 다시 다듬었습니다. v1.2는 한 걸음 더
    나아가 원작에 없던 플로차트, 장 목록, 엔딩 목록을 넣었습니다. 게임 엔진에 새 화면과 새 동작을 끼워 넣은 것이라 번역
    패치라기보다 개조 롬에 가깝습니다.
  </p>
  <p class="section-note">슈퍼 패미컴 구조나 65c816 어셈블리를 몰라도 읽을 수 있게 풀어 썼습니다.</p>
  <p class="section-note">
    빌드 스크립트, 어셈블리 소스, 대본, 글자표, 테스트 스크립트는
    <a href={zip} download>
      빌드 도구(zip, 1.8MB)
    </a>
    로 받을 수 있습니다. 각 단계 끝의 「빌드 도구 속 파일」에 그 단계에서 쓴 파일과 하는 일을 적었습니다. 롬, asar,
    Mesen은 들어 있지 않고, 일본어 대본은 빌드할 때 가지고 있는 일본판 롬에서 뽑습니다. 빌드 순서는 압축 파일 안
    tools/README.txt에 있습니다.
  </p>

  <details class="more making">
    <summary class="pointer">자세히 보기</summary>
    <div class="making-body">
      <h3 class="pixel">1. 배경지식</h3>
      <h4>게임기 안의 메모리</h4>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">이름</th>
              <th scope="col">비유</th>
              <th scope="col">하는 일</th>
            </tr>
          </thead>
          <tbody>
            {memories.map(m => (
              <tr>
                <th scope="row">{m.name}</th>
                <td>{m.like}</td>
                <td class="wrap">{m.role}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h4>주소 읽는 법</h4>
      <p>
        <code>$15:E401</code> 같은 SNES 주소는 CPU가 보는 <code>뱅크:주소</code>이고, <code>0xAE401</code> 같은 파일
        오프셋은 롬 파일을 처음부터 센 위치입니다. 이 게임(LoROM)은 뱅크 하나가 롬의 32KB를 비춥니다.
      </p>
      <pre><code>파일 오프셋 = (뱅크 &amp; 0x7F) × 0x8000 + (주소 &amp; 0x7FFF)
$15:E401 → 0x15 × 0x8000 + 0x6401 = 0xAE401</code></pre>

      <h4>대본은 글자와 명령의 줄</h4>
      <p>
        사운드 노벨의 대본은 글자 사이사이에 명령(제어 코드)이 섞인 하나의 긴 줄입니다. 게임은 이 줄을 앞에서부터 읽으며
        글자는 화면에 찍고 명령은 실행합니다. 아래 표기는 이 글에서 쓰는 형식입니다.
      </p>
      <div class="table-wrap">
        <table>
          <tbody>
            {codes.map(c => (
              <tr>
                <td>
                  <code>{c.code}</code>
                </td>
                <td class="wrap">{c.text}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h4>후킹</h4>
      <p>
        원래 코드 사이에는 새 기능을 넣을 자리가 없습니다. 그래서 원래 코드의 한 지점을 "새 코드로 가라" 는 명령으로
        덮어쓰고, 새 코드는 롬의 빈 공간에 둡니다. v1.1과 v1.2는 이런 지점을 스무 곳 넘게 바꿨습니다. 어셈블리 소스는
        asar로 롬에 덮어씁니다.
      </p>
      <pre><code>org $009CF9      ; 입력 대기 중 X(되감기)를 확인하던 자리를
    JSL SelCheck ; Select도 확인하는 새 코드로 보낸다</code></pre>

      <h3 class="pixel">2. 대사가 들어 있는 방식</h3>
      <p>
        일본판은 대사 전체를 허프만 부호로 압축해 비트 단위로 이어 붙였습니다. 자주 나오는 글자일수록 짧은 비트로 적는
        방식이라, 점프 주소도 바이트가 아니라 "기준점에서 몇 번째 비트" 로 적혀 있습니다. v1.0은 압축을 버리고 글자마다
        2바이트로 적은 대사를 롬 뒤쪽에 새로 늘린 1MB에 넣었습니다. 대신 일본판 대사가 있던 자리는 0으로 비었는데, 이
        자리가 나중에 v1.1과 v1.2의 코드가 들어갈 곳이 됐습니다.
      </p>
      <p>
        먼저 두 형식을 모두 읽는 파서를 만들고 대본을 6,730줄의 텍스트로 꺼냈습니다. 점프 대상이 되는 곳에서 줄을
        나눴더니 일본어 대본과 한국어 대본이 줄 번호까지 똑같이 맞았습니다. 그다음 꺼낸 대본을 고치지 않고 다시 조립했을
        때 v1.0 롬과 바이트 단위로 같아지는 것을 확인했습니다. 이게 맞아야 이후의 수정이 다른 곳을 망가뜨리지 않았다고
        믿을 수 있습니다.
      </p>
      <ToolFiles
        items={[
          { path: 'tools/script.py', text: '일본판 허프만 비트열과 v1.0 2바이트 대사를 둘 다 읽는 파서' },
          { path: 'tools/dump.py', text: '대사를 줄 단위 텍스트로 꺼내기 (점프 대상은 레이블로)' },
          { path: 'tools/assemble.py', text: '텍스트 대본을 다시 롬으로 조립하고 문장부호를 게임 글자로 바꾸기' },
          { path: 'tools/dis65816.py', text: '롬 주소를 넣으면 65c816 명령으로 풀어 보여 주는 간단한 역어셈블러' },
        ]}
      />

      <h3 class="pixel">3. 2회차에 멈추던 이유</h3>
      <p>
        게임은 새 회차를 시작할 때 회차 수와 난수로 세 시나리오 중 하나를 고르고, 시작 주소 표($02:A627)에서 그
        시나리오의 첫 위치를 읽습니다. 2번 시나리오는 2회차부터 뽑힙니다. v1.0은 표의 0번, 1번만 새 대사 위치로 바꾸고
        2번은 일본판 값을 그대로 둬서, 2번이 뽑히면 엉뚱한 데이터를 대사로 읽었습니다.
      </p>
      <figure class="paper narrow">
        <img
          src={img('freeze-lap2.webp')}
          width="630"
          height="920"
          alt="위는 v1.0 2회차에서 화면이 w로 가득 차 멈춘 모습, 아래는 v1.1에서 정상으로 시작한 2번 시나리오"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <p>
        번역문은 v1.0에도 들어 있었습니다. 0번 시나리오 끝 바로 다음이 2번 시나리오의 시작이라, 3바이트만 고쳐 넣으면
        됐습니다. 회차 수를 메모리에서 직접 1, 2, 3으로 바꿔 세 시나리오가 모두 정상으로 시작하는 것을 확인했습니다.
      </p>
      <ToolFiles
        items={[
          { path: 'tools/fixes.py', text: '시작 주소 표 2번과 헤더의 롬 크기 바이트 고치기' },
          { path: 'lua/lap.lua', text: '회차 수를 바꿔 원하는 시나리오로 시작하기 (Mesen 2)' },
        ]}
      />

      <h3 class="pixel">4. A 버튼 없이 넘어가던 화면</h3>
      <p>
        엔진은 「」』.?! 같은 문장 끝 글자를 찍으면 알아서 A 버튼을 기다리고, <code>{'{16}'}</code>을 만나도 기다립니다.
        v1.0은 일본어의 「。」를 「…」나 띄어쓰기로 옮기면서 기다림이 빠진 곳과, 자동 대기 바로 뒤에{' '}
        <code>{'{16}'}</code>이 또 붙은 곳이 생겼습니다. 앞의 경우는 버튼을 누르지 않아도 페이지가 지워졌고, 뒤의 경우는
        두 번 눌러야 넘어갔습니다.
      </p>
      <figure class="paper">
        <img
          src={img('a-wait.webp')}
          width="1150"
          height="970"
          alt="v1.0은 버튼을 누르지 않고 2초 뒤 다음 화면으로 넘어가 있고, v1.1은 같은 자리에서 기다린다"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <p>
        한국어 대본과 일본어 대본이 줄 단위로 맞으니, 줄마다 "어디서 기다리는가" 를 두 대본에서 계산해 비교할 수
        있습니다. 일본판이 기다리는 곳에만 <code>{'{16}'}</code>을 90곳 남짓 넣고, 겹친 대기 30곳 남짓을 지웠습니다. 첫
        자동 수정은 기준을 잘못 잡아 270곳 넘게 고쳐 버려서, 비교 결과를 줄마다 다시 보며 범위를 좁혔습니다. 지금은
        빌드할 때마다 이 비교 결과를 파일로 남기고, 0건이어야 통과입니다.
      </p>
      <ToolFiles
        items={[
          { path: 'tools/waits.py', text: '줄마다 입력 대기 위치를 일본판과 비교' },
          { path: 'tools/fixwaits.py', text: '일본판이 기다리는 곳에만 {16}을 넣고 겹친 대기 지우기' },
          { path: 'lua/waitdemo.lua', text: '정해진 대사까지 A를 누른 뒤 손을 떼고 매 프레임 찍기' },
        ]}
      />

      <h3 class="pixel">5. 글자표를 눈으로 읽게 하기</h3>
      <p>
        대사를 고치려면 롬 속 글자 번호가 어떤 한글인지 적은 글자표가 있어야 하는데, v1.0의 글자표는 남아 있지
        않았습니다. 그래서 폰트 1,282자를 그림으로 그려 macOS의 문자 인식(Vision)에 읽혔습니다. 한 글자씩 넣으면 잘 못
        읽어서 여러 글자를 한 줄로 이어 붙였고, 조건을 바꿔 9번 읽힌 뒤 다수결로 정했습니다. 이 폰트의 ㅇ은 모서리만 빈
        사각형이라 문자 인식이 ㅁ으로 자주 읽었습니다. 받침과 초성의 모서리 픽셀을 보고 가리는 규칙을 더했습니다.
        ㅗ·ㅜ의 꼭지는 1픽셀이라 작게 줄인 그림에서는 ㅡ와 구별되지 않아서, 남은 의심 글자는 픽셀을 직접 보며 대사
        문맥과 맞춰 검수했습니다. 잋→잊, 꿀→훌, 뒸→뒀처럼 30자를 바로잡았습니다.
      </p>
      <figure class="paper narrow">
        <img
          src={img('glyph-mieum.svg')}
          width="560"
          height="330"
          alt="v1.0 폰트의 「마」와 「아」를 픽셀 격자로 그린 그림. 네 모서리 픽셀 하나씩만 다르다"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <p>
        재번역으로 새로 필요해진 글자 75자는 v1.0 글자의 부분을 오려 붙이거나 직접 그려서 같은 모양으로 맞췄습니다. 예를
        들어 「갹」은 「같」의 ㄱ, 「걷」의 ㅓ, 「밑」의 받침 ㅌ을 이어 붙였습니다. 처음에는 자모를 기계적으로 합성해
