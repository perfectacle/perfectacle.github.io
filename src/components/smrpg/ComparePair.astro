---
import type { ComparePair } from '../../lib/smrpg-showcase';
import Speech from './Speech.astro';

interface Props {
  pair: ComparePair;
  base: string;
}

const { pair, base } = Astro.props;
const shots = [
  { suffix: 'jp', label: '일본판' },
  { suffix: 'ko', label: '한글판' },
];
---

<figure class="compare">
  <div class="compare-shots">
    {shots.map(shot => (
      <div class="shot">
        <span class:list={['shot-label', { 'shot-label-ko': shot.suffix === 'ko' }]} aria-hidden="true">
          {shot.label}
        </span>
        <div class="screen">
          <img
            src={`${base}/images/patch/${pair.id}_${shot.suffix}.webp`}
            width="256"
            height="224"
            alt={`${shot.label}: ${pair.alt}`}
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    ))}
  </div>
  <Speech speaker="키노피오" tag="figcaption">
    {pair.caption}
  </Speech>
</figure>
