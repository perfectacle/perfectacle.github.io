const memories = [
  { name: '롬', size: '4MB', role: '카트리지에 든 프로그램·대사·폰트. 읽기만 합니다.' },
  { name: 'WRAM', size: '128KB', role: 'CPU가 계산하며 값을 적어 두는 곳. HP와 인벤토리도 여기 있습니다.' },
  { name: 'VRAM', size: '64KB', role: '화면에 붙일 8×8 그림 조각(타일)을 올려 두는 곳.' },
  { name: 'BW-RAM', size: '32KB', role: '카트리지 안의 두 번째 CPU(SA-1)가 쓰는 메모리. 세이브도 여기 있습니다.' },
];

const opcodes = [
  { bytes: 'AF AE FF 00', asm: 'LDA $00FFAE', text: '$00:FFAE 값을 읽습니다. 주소는 거꾸로 적힙니다.' },
  { bytes: '05 80', asm: 'ORA $80', text: '$80번지 값과 OR 합니다. 둘 다 0일 때만 0입니다.' },
  { bytes: 'F0 01', asm: 'BEQ +1', text: '결과가 0이면 다음 1바이트(RTS)를 건너뛰고 디버그 메뉴로 갑니다.' },
  { bytes: '60', asm: 'RTS', text: '아니면 그냥 돌아갑니다. 제품판은 늘 여기로 옵니다.' },
];

// One row per bank; the cells are coloured by what the bank holds.
const mapRows = [0xc0, 0xd0, 0xe0, 0xf0];
const bankKind = (b: number) =>
  b >= 0xc0 && b <= 0xc3
    ? 'dg-cool'
    : b >= 0xe2 && b <= 0xe4
      ? 'dg-warm'
      : [0xf7, 0xf9, 0xfa, 0xfe].includes(b)
        ? 'dg-accent'
        : 'dg-cell';
const romMap = [
  { bank: '$C0', text: '대사 엔진. 대사 주소 계산 루틴 $C0:5800, 제어 코드 분기' },
  { bank: '$C1·$C2', text: '전투. 전투 메뉴 글자 그리기 $C1:6A3F, 레벨업 화면, 전투 애니메이션 해석기 $C2:0C43' },
  { bank: '$C3', text: '필드 메뉴. 아이템 이름 그리기 $C3:7990, 빈 공간 $C3:F000·$C3:FC40(패치 코드)' },
  { bank: '$E2–$E4', text: '대사 4096개(그룹 0–3은 $E2, 4–6은 $E3, 7은 $E4). $E2:B400부터는 빈 공간(새 이름 표)' },
  { bank: '$E4', text: '대사 뒤 $E4:2800 메뉴 폰트, $E4:4000 대사 폰트, $E4:9D00 대사 폰트 확장 칸' },
  { bank: '$F7', text: '대사 포인터 표 $F7:E000' },
  { bank: '$F9·$FA', text: '적 이름 $F9:8C11, 필살기 $FA:137F, 아이템 $FA:41FC, 아이템 설명·전투 메시지' },
  { bank: '$FE', text: '메뉴 문구 $FE:EF00' },
];

const otherTexts = [
  { what: '전투 대사', table: '$F9:6554', count: '256', how: '다시 채움' },
  { what: '아이템 설명', table: '$FA:2F20', count: '177', how: '다시 채움' },
  { what: '메뉴 문구', table: '$FE:EF00', count: '118', how: '제자리 수정' },
  { what: '전투 메시지', table: '$FA:26F1', count: '46', how: '제자리 수정' },
