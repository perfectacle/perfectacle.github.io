---
import ZoomImage from '../kr-patch/ZoomImage.astro';
import MakingIntro from './MakingIntro.astro';
import NoteRelated from '../romhacking/NoteRelated.astro';
import Deeper from '../romhacking/Deeper.astro';
import Figure from '../romhacking/Figure.astro';
import BankMap from '../romhacking/BankMap.astro';
import ToolFiles from '../kr-patch/ToolFiles.astro';
import MakingSources from '../kr-patch/MakingSources.astro';
import { chapterBySlug, chapterLabel, chapterPath, type GuidePlatform } from '../romhacking/chapters';
import { sourceFileUrl, sourceUrl, type KrPatch } from '../../lib/kr-patches';
import SourceFile from '../kr-patch/SourceFile.astro';

interface Props {
  patch: KrPatch;
}

const { patch } = Astro.props;
const base = patch.path;
const source = sourceUrl(patch);
const img = (name: string) => `${base}/images/making/${name}`;
const chapter = (slug: string, hash = '', platform: GuidePlatform = 'sfc') => {
  const c = chapterBySlug(platform, slug);
  return { href: `${chapterPath(c)}${hash}`, label: `${chapterLabel(c)} ${c.title}` };
};
const ch = {
  cpu: chapter('cpu'),
  banks: chapter('banks'),
  assembly: chapter('assembly'),
  hooking: chapter('hooking'),
  graphics: chapter('graphics'),
  text: chapter('text'),
  pointers: chapter('text', '#pointers'),
  control: chapter('text', '#control'),
  width: chapter('text', '#width'),
  expansion: chapter('expansion'),
  emulator: chapter('emulator'),
  endian: chapter('endian', '', 'common'),
  lzss: chapter('lzss', '', 'common'),
};

const versions = [
  { name: '일본판 원본', text: '4MB, SA-1 카트리지. 이 노트의 모든 주소는 여기 기준입니다.', cls: 'dg-cell' },
  { name: 'v1.0 (IPS)', text: '대사·메뉴는 한글, 아이템·필살기·적 이름은 영문', cls: 'dg-cell' },
  { name: 'v1.1', text: '이름 한글(아이템 165·필살기 27·적 232)', cls: 'dg-warm' },
  { name: 'v1.2', text: '전투 메시지·이름 띠, 글자 코드 충돌을 고침', cls: 'dg-warm' },
  { name: 'v1.3', text: '이름 입력을 자모 조합식 한 페이지 화면으로', cls: 'dg-accent' },
];

const firstReads = [
  { c: ch.cpu, why: '이 게임에는 CPU가 둘 있습니다. 필드 메뉴와 전투 메뉴를 따로 고친 이유입니다.' },
  { c: ch.banks, why: '$E2:B400 같은 주소를 파일 위치로 바꾸는 법' },
  { c: ch.graphics, why: '글자가 타일이라는 것, 폰트 칸이 왜 모자랐는지' },
  { c: ch.text, why: '대사 바이트, 제어 코드, 포인터 표' },
  { c: ch.hooking, why: '원래 코드 중간에 새 코드를 끼우는 방법' },
