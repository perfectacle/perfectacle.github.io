---
import ToolFiles from '../kr-patch/ToolFiles.astro';
import { downloads, type KrPatch } from '../../lib/kr-patches';

interface Props {
  patch: KrPatch;
}

const { patch } = Astro.props;
const base = patch.path;
const { tools } = downloads(patch);
const img = (name: string) => `${base}/images/making/${name}`;

const memories = [
  { name: '롬', size: '4MB', like: '책', role: '카트리지에 든 프로그램·대사·폰트. 읽기만 합니다.' },
  {
    name: 'WRAM',
    size: '128KB',
    like: '작업 책상',
    role: 'CPU가 계산하며 값을 적어 두는 곳. HP와 인벤토리도 여기 있습니다.',
  },
  { name: 'VRAM', size: '64KB', like: '스티커판', role: '화면에 붙일 8×8 그림 조각(타일)을 올려 두는 곳.' },
  { name: 'BW-RAM', size: '32KB', like: 'SA-1 책상', role: '카트리지 안의 두 번째 CPU(SA-1)가 쓰는 메모리.' },
];

const opcodes = [
  { bytes: 'AF AE FF 00', asm: 'LDA $00FFAE', text: '$00:FFAE 값을 읽습니다. 주소는 거꾸로 적힙니다.' },
  { bytes: '05 80', asm: 'ORA $80', text: '$80번지 값과 OR 합니다. 둘 다 0일 때만 0입니다.' },
  { bytes: 'F0 01', asm: 'BEQ +1', text: '결과가 0이면 다음 1바이트(RTS)를 건너뛰고 디버그 메뉴로 갑니다.' },
  { bytes: '60', asm: 'RTS', text: '아니면 그냥 돌아갑니다. 제품판은 늘 여기로 옵니다.' },
];

const glyphFlow = [
  '이름에서 글자 하나를 읽습니다.',
  '메뉴 폰트에 있는 글자면 원래 타일을 그대로 씁니다.',
  '없는 글자면 이미 올려 둔 임시 칸이 있는지 찾고, 없으면 빈 칸을 하나 배정합니다.',
  '게임의 외곽선 루틴($C3:6869)으로 8×12 글자를 메뉴 글자 모양으로 바꿔 WRAM에 모아 둡니다(최대 12자).',
  '화면 갱신 틈(NMI)에 DMA로 VRAM에 한꺼번에 옮깁니다.',
];

const dialogFlow = [
  '대사 ID(0x000–0xFFF)를 512로 나눠 그룹(0–7)을 구합니다. 예: 0x204 ÷ 512 → 그룹 1',
  '뱅크 $E2–$E4 첫머리 헤더에서 그 그룹의 시작 주소를 찾습니다. $E2 헤더는 08 00 F5 03 …이고, 첫 값 0x0008이 헤더 크기(그룹 4개)이자 그룹 0의 시작입니다. 그룹 1은 그다음 값 $03F5입니다.',
  '포인터 표 $F7:E000에서 ID마다 적힌 2바이트(그룹 안 위치)를 읽습니다. $F7:E000 + 0x204 × 2 = $F7:E408에 25 00이 있습니다.',
  '둘을 더한 $E2:03F5 + 0x25 = $E2:041A(파일 0x22041A)에 대사 문자열이 있습니다.',
];

const lineBytes = [
  ['1B 07', '이름'],
  ['20', '빈칸'],
  ['1D 07', '획'],
  ['1D 22', '득'],
  ['21', '!'],
  ['00', '끝'],
];

const nameFlags = [
  { bit: '1', text: '이름을 「」로 감쌉니다.' },
  { bit: '2', text: '줄의 나머지 글자 수를 미리 세어 앞에 빈칸을 채워 가운데에 놓습니다.' },
  { bit: '4', text: '이름 마지막 글자의 받침에 맞춰 을/를을 붙입니다.' },
];

const testRam = [
  {
    addr: '$00:3030',
    text: '지금 방 번호(16비트). 출구를 지날 때 쓰는 값을 바꾸면 그 방으로 갑니다. 0x0000은 디버그 룸입니다.',
  },
  { addr: '$7E:FA0E', text: '전투 편성 번호(16비트). 전투에 들어갈 때 쓰는 값을 바꾸면 다른 적과 싸웁니다.' },
  { addr: '$00:3112', text: 'FF로 쓰면 메뉴가 막힌 곳에서도 메뉴가 열립니다.' },
  { addr: '$7F:F882', text: '아이템 인벤토리 30칸(빈칸 FF). 보고 싶은 아이템을 직접 넣습니다.' },
  { addr: '$7F:F800', text: '마리오 능력치(0x14바이트). +0A의 경험치를 바꿔 레벨업 화면을 만듭니다.' },
];

const files = {
  basics: [
    {
      path: 'ANALYSIS.txt',
      text: '롬 분석 문서. 롬 헤더, 메모리, 대사·폰트 형식, 후킹 주소, 쓴 빈 공간, 디버그 기능을 [실측]·[추정]으로 나눠 적었습니다',
    },
    { path: 'tools/py/dis65816.py', text: '롬 주소를 넣으면 65c816 명령으로 풀어 보여 주는 간단한 역어셈블러' },
    { path: 'src/main.asm', text: '모든 후킹 코드. 맨 위 org 줄들이 덮어쓴 원래 코드 위치입니다' },
  ],
  font: [
    { path: 'tools/py/glyphs.py', text: '롬의 폰트를 그림으로 뽑기 (위 256칸 그림을 이것으로 확인)' },
    { path: 'tools/py/tiles.py', text: '롬의 아무 구간을 타일로 그려 보기' },
    { path: 'data/tbl/korTBL2.tbl', text: 'v1.0 메뉴 폰트 코드표 (korTBL.tbl은 대사 폰트)' },
  ],
  slots: [
    { path: 'tools/py/vramrefs.py', text: 'VRAM 덤프에서 화면이 실제로 참조하는 구간 찾기 (빈 칸 찾기)' },
    { path: 'tools/py/vramchr.py', text: 'VRAM 덤프의 타일을 그림으로 보기' },
    {
      path: 'src/main.asm',
      text: 'DrawItemName·DrawSkillName(그리기), ResetSlots(칸 비우기), NmiUpload(NMI 업로드), HeldName(들고 가는 이름)',
    },
    { path: 'tools/build.py', text: '새 이름 테이블과 동적 글리프 248자 생성' },
  ],
  battle: [{ path: 'src/main.asm', text: 'KoFetch(글자 읽기), KoGlyphX(그림 주소 계산), KoCopy(이름 복사)' }],
  space: [
    { path: 'src/main.asm', text: 'org $C3F000, $C3FC40, $E2B400 등 코드와 데이터를 넣은 빈 공간' },
    { path: 'tools/make.sh', text: 'asar --fix-checksum=on으로 체크섬까지 다시 계산하는 빌드' },
  ],
  dialogue: [
    { path: 'tools/py/dialogue.py', text: '대사 ID로 포인터 표와 뱅크 헤더를 따라가 주소 구하기' },
    { path: 'tools/py/dlg_rewrite.py', text: '대사 다시 채우기, 1A를 1B+옵션으로 바꾸기, 가운데 정렬, 끝 코드 복구' },
    { path: 'tools/py/textusage.py', text: '어떤 2바이트 코드가 실제로 쓰이는지 조사 (재활용할 빈 코드 찾기)' },
    { path: 'tools/py/dump_text.py', text: '모든 텍스트를 읽을 수 있는 줄로 덤프' },
    { path: 'tools/py/render_jp.py', text: '일본판 원문을 대사 폰트로 그려 보기' },
    { path: 'src/main.asm', text: 'org $C06896(1B 분기), KoDlgName(한글 이름을 $7E:2D00에 복사)' },
  ],
  particles: [
    { path: 'tools/build.py', text: '이름 앞 1바이트에 받침 비트(0x80) 넣기' },
    { path: 'tools/py/textfix.py', text: '이름을 바꿀 때 바로 뒤 조사(이/가, 을/를 …)도 같이 고치기' },
    { path: 'src/main.asm', text: 'KoLvSkill, KoLvAfterNum, KoLvAttr (레벨업 화면)' },
  ],
  ui: [
    { path: 'src/main.asm', text: 'KoResultName·KoResultGeom·KoResultChar(결과 창), KoSpecialHint(필살기 안내)' },
    { path: 'tools/make.sh', text: 'asar에 -Dres_ui=0을 주면 원판 배치로 빌드돼 전후 비교가 됩니다' },
  ],
  testing: [
    { path: 'test/seq.lua, tools/run_seq.sh', text: '세이브스테이트에서 버튼 입력 재생, 화면·메모리 저장' },
    { path: 'test/poke_state.lua, tools/make_states.sh', text: 'RAM 값을 바꿔 새 세이브스테이트 만들기' },
    { path: 'test/harness/harness.asm, tools/make_harness.sh', text: '원하는 대사를 띄우는 테스트 전용 롬' },
    { path: 'tools/py/scene_rom.py, test/warp_seq.lua', text: '출구를 바꾸거나 방을 워프해 원하는 장소로 가기' },
    {
      path: 'tools/py/verify_dialogue.py, verify_menu.py, shotcmp.py, tools/test_menu.sh',
      text: '대사·메뉴 회귀 검사와 스크린샷 비교',
    },
    { path: 'tools/py/make_ips.py', text: '일본판 원본 기준 IPS 만들기 (헤더 없음/있음)' },
  ],
};

const sectionTitles: Record<keyof typeof files, string> = {
  basics: '1. 배경지식',
  font: '2. 메뉴 폰트',
  slots: '3. 임시 칸',
  battle: '4. 전투 메뉴',
  space: '5. 롬 크기',
  dialogue: '6. 대사',
  particles: '7. 조사',
  ui: '8. 화면 배치',
  testing: '9. 확인',
};

// A file used by several steps is listed once, with what it does in the first step that uses it.
const allFiles = Object.entries(files)
  .flatMap(([section, items]) => items.map(item => ({ ...item, section: section as keyof typeof files })))
  .filter((file, i, list) => list.findIndex(other => other.path === file.path) === i);
---

<section id="making" class="section page-width" aria-labelledby="making-title">
  <h2 id="making-title" class="pixel">
    롬 분석 노트
  </h2>
  <p class="lead">
    이 롬을 다시 분석하거나 패치를 이어 고칠 사람을 위해 남기는 기록입니다. v1.0은 대사와 메뉴는 한글이었지만
    아이템·필살기·적 이름은 MUSHROOM, HAMMER 같은 영문이었습니다. 롬 용량이 모자라서가 아니라 메뉴 화면에 한 번에 올려
    둘 수 있는 글자가 256개뿐이었기 때문입니다. v1.1은 필요한 글자만 그때그때 빈 칸에 올리는 코드를 게임에 끼워 넣어 이
    문제를 풀었습니다. 롬 크기는 원본과 같은 4MB입니다.
  </p>
  <figure class="paper">
    <img
      src={img('names-shop.webp')}
      width="1150"
      height="920"
      alt="위는 v1.0, 아래는 v1.1 상점 화면. 영문 아이템 이름이 한글로 바뀌었다"
      loading="lazy"
      decoding="async"
    />
    <figcaption>위 v1.0, 아래 v1.1</figcaption>
  </figure>
  <p class="section-note">슈퍼 패미컴 구조나 65c816 어셈블리를 몰라도 읽을 수 있게 풀어 썼습니다.</p>
  <p class="section-note">
    빌드에 쓴 스크립트, 어셈블리 소스, 이름 데이터, v1.0 코드표와 롬 분석 문서는
    <a href={tools} download>
      빌드 도구(zip, 610KB)
    </a>
    로 받을 수 있습니다. 롬, asar, Mesen은 들어 있지 않고, 빌드 순서는 압축 파일 안 README.txt에 있습니다. 롬 헤더,
    메모리, 대사·폰트 형식, 후킹 주소, 쓴 빈 공간, 디버그 기능은 ANALYSIS.txt에 직접 확인한 것과 추정을 나눠 적었습니다.
    아래 「자세히 보기」의 항목마다 그 내용을 다루는 파일을 적어 두었고, 전체 목록은 마지막
    <a href="#making-tools">빌드 도구 파일</a>에 있습니다.
  </p>

  <details class="more making">
    <summary class="pointer">자세히 보기</summary>
    <div class="making-body">
      <h3 id="making-basics" class="pixel">
        1. 배경지식
      </h3>
      <h4>게임기 안의 메모리</h4>
      <p>
        CPU는 화면에 직접 그리지 않습니다. 그림 조각(타일)을 VRAM에 올려 두고 "이 칸에는 몇 번 타일" 이라는
        배치표(타일맵)를 적어 화면을 만듭니다. 글자도 타일입니다.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">이름</th>
              <th scope="col">크기</th>
              <th scope="col">비유</th>
              <th scope="col">하는 일</th>
            </tr>
          </thead>
          <tbody>
            {memories.map(m => (
              <tr>
                <th scope="row">{m.name}</th>
                <td>{m.size}</td>
                <td>{m.like}</td>
                <td class="wrap">{m.role}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h4>CPU가 둘: S-CPU와 SA-1</h4>
      <p>
        이 게임 카트리지에는 SA-1이라는 CPU가 하나 더 들어 있습니다. 본체 CPU(S-CPU, 3.58MHz)보다 세 배쯤 빠르고, 두
        CPU가 동시에 돕니다. 둘 다 65c816 계열이라 같은 어셈블리로 짭니다. 필드 메뉴는 S-CPU가, 전투 메뉴는 SA-1이
        그려서 아이템 이름 하나를 바꾸려 해도 두 길을 따로 고쳐야 했습니다.
      </p>

      <h4>주소 읽는 법</h4>
      <p>
        <code>0x22B400</code> 같은 파일 오프셋은 롬 파일을 처음부터 센 위치이고, <code>$E2:B400</code> 같은 SNES 주소는
        CPU가 보는 <code>뱅크:주소</code>입니다. 뱅크는 64KB짜리 칸 번호입니다. 이 게임은 다음처럼 바꿉니다.
      </p>
      <pre><code>파일 오프셋 = (뱅크 &amp; 0x3F) × 0x10000 + 주소
$E2:B400 → 0x22 × 0x10000 + 0xB400 = 0x22B400</code></pre>

      <h4>어셈블리, 필요한 만큼만</h4>
      <p>
        어셈블리는 CPU가 실행하는 명령을 사람이 읽는 이름으로 적은 것이고, 롬 안에서는 그냥 바이트입니다. 전투 디버그
        메뉴를 막는 코드(파일 <code>0x106A9</code>)를 예로 보겠습니다.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">바이트</th>
              <th scope="col">어셈블리</th>
              <th scope="col">뜻</th>
            </tr>
          </thead>
          <tbody>
            {opcodes.map(o => (
              <tr>
                <td>
                  <code>{o.bytes}</code>
                </td>
                <td>
                  <code>{o.asm}</code>
                </td>
                <td class="wrap">{o.text}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>
        <code>F0</code>(BEQ, 0이면 건너뛰기) 한 바이트를 <code>80</code>(BRA, 무조건 건너뛰기)으로 바꾸면 전투 중
        Start로 개발자용 디버그 메뉴가 열립니다. 롬 해킹은 이런 바이트 바꾸기의 연속입니다.
      </p>

      <h4>후킹: 원래 코드 중간에 새 코드 끼우기</h4>
      <p>
        원래 코드 사이에는 새 기능을 넣을 자리가 없습니다. 그래서 원래 코드의 한 지점을 "새 코드로 가라" 는 명령으로
        덮어쓰고, 새 코드는 롬의 빈 공간에 둡니다. 실제 패치 소스는 이렇게 생겼습니다.
      </p>
      <pre><code>org $C37990          ; 원래 아이템 이름을 그리러 가는 자리를
    JMP DrawItemName ; "DrawItemName으로 가라" 로 덮어쓴다

org $C3F000          ; 원본에서 비어 있던(0xFF) 공간
DrawItemName:        ; 한글 이름을 그리는 새 코드
    ...</code></pre>
      <p>v1.1은 필드 메뉴, 전투 메뉴, 결과 창, 레벨업 화면, 대사 엔진 등 스무 곳 남짓에 이런 후킹을 걸었습니다.</p>

      <ToolFiles items={files.basics} />

      <h3 id="making-font" class="pixel">
        2. 왜 v1.0은 이름을 영문으로 뒀나
      </h3>
      <p>
        메뉴 폰트의 글자 하나는 가로 8, 세로 12 픽셀 그림이고 한 줄에 2바이트씩 24바이트를 씁니다. 아래는 실제 롬에서
        꺼낸 「마」입니다.
      </p>
      <figure class="paper narrow">
        <img
          src={img('glyph-ma.svg')}
          width="436"
          height="354"
          alt="메뉴 폰트의 「마」 글자를 8×12 픽셀 격자와 줄마다의 바이트 값으로 나타낸 그림"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <p>
        아이템 이름은 글자 하나를 1바이트 코드로 적습니다. 1바이트로 고를 수 있는 값은 256개이고 0x00–0x1F를 빼면 글자
        칸은 224개입니다. 메뉴를 열면 게임은 이 폰트 전체를 VRAM에 통째로 올려 두고, 코드 c를 (c − 0x20) × 2번 타일로
        고정해서 그립니다. 아래는 v1.0 롬의 메뉴 폰트 256칸입니다. 회색은 빈 코드, 노란색은 아이콘·영숫자, 파란색은
