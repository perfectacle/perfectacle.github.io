---
interface Props {
  topic: string;
  shot: { index: number; alt: string; caption: string } | undefined;
}

const { topic, shot } = Astro.props;
if (!shot) throw new Error(`Missing screenshot for ${topic}`);
const src = `/games/kr-patches/sfc/super-mario-rpg/images/secrets/${topic}-${String(shot.index).padStart(2, '0')}.webp`;
---

<figure class="secret-shot">
  <img src={src} alt={shot.alt} width="256" height="224" loading="lazy" decoding="async" />
  <figcaption>{shot.caption}</figcaption>
</figure>

<style>
  .secret-shot {
    width: 100%;
    max-width: 512px;
    margin: 1.25rem auto;
  }

  .secret-shot img {
    display: block;
    width: 100%;
    height: auto;
    image-rendering: pixelated;
  }

  .secret-shot figcaption {
    margin-top: 0.6rem;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
</style>
