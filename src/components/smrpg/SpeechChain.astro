---
import Speech from '../kr-patch/Speech.astro';

interface Props {
  lines: { speaker?: string; text: string }[];
}

const { lines } = Astro.props;
---

<div class="speech-chain">
  {lines.map(line => (
    <Speech speaker={line.speaker}>{line.text}</Speech>
  ))}
</div>

<!--
  Without JS every box stays visible; with it the boxes open one at a time, as in the game.
  Inline and right after the markup so the later boxes are hidden before the first paint.
-->
<script is:inline>
  (() => {
    const boxes = [...document.currentScript.previousElementSibling.querySelectorAll('.speech')];
    boxes.forEach((box, i) => {
      if (i > 0) box.hidden = true;
      const next = boxes[i + 1];
      if (!next) return;
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'next';
      button.setAttribute('aria-label', '다음 대사 보기');
      button.textContent = '▶';
      button.addEventListener('click', () => {
        button.remove();
        next.hidden = false;
        // Focus the new line so screen readers read it; its own ▶ is the next Tab stop.
        next.tabIndex = -1;
        next.focus();
      });
      box.append(button);
    });
  })();
</script>
