---
import ZoomImage from '../kr-patch/ZoomImage.astro';
import ToolFiles from '../kr-patch/ToolFiles.astro';
import MakingSources from '../kr-patch/MakingSources.astro';
import MakingToc from '../kr-patch/MakingToc.astro';
import { KAKUSEI_PATCH, KR_PATCH_TOOLKIT_URL, sourceUrl, type KrPatch } from '../../lib/kr-patches';

interface Props {
  patch: KrPatch;
}

const { patch } = Astro.props;
const base = patch.path;
const source = sourceUrl(patch);
const img = (name: string) => `${base}/images/making/${name}`;

const memories = [
  { name: '롬', size: '2MB', like: '책', role: '카트리지에 든 프로그램·대사·폰트·그림. 읽기만 합니다.' },
  {
    name: 'WRAM',
    size: '128KB',
    like: '작업 책상',
    role: 'CPU가 계산하며 값을 적어 두는 곳. 지금 보고 있는 장면 번호 같은 것이 여기 있습니다.',
  },
  { name: 'VRAM', size: '64KB', like: '스티커판', role: '화면에 붙일 8×8 그림 조각(타일)을 올려 두는 곳.' },
  { name: 'SRAM', size: '8KB', like: '수첩', role: '전원을 꺼도 남는 세이브 데이터.' },
];

const opcodes = [
  { bytes: '80 04', asm: 'BRA $8067', text: '무조건 4바이트 뒤로 건너뜁니다. 제품판은 다음 줄을 늘 건너뜁니다.' },
  { bytes: '22 B0 86 82', asm: 'JSL $8286B0', text: '디버그 메뉴 루틴을 부릅니다. 주소는 거꾸로 적힙니다.' },
  { bytes: '22 00 80 82', asm: 'JSL $828000', text: '건너뛴 뒤 제품판이 실행하는 곳입니다.' },
];

const lineBytes = [
  ['F3 08', '어'],
  ['B5 06', '떻'],
  ['27 05', '게'],
  ['0A 00', '줄바꿈'],
  ['A1 09', '잡'],
  ['C6 08', '아'],
  ['C5 02', '빈칸'],
  ['E5 07', '볼'],
  ['85 05', '까'],
  ['6B 01', '‥'],
  ['00 00', '끝'],
];

const banks = [
  { ids: '000–25B', bank: '$A8', table: '$A8:8000' },
  { ids: '25C–570', bank: '$A9', table: '$A9:87D6' },
  { ids: '571–81B', bank: '$AB', table: '$AB:8000' },
  { ids: '81C–A64', bank: '$9D', table: '$9D:8000' },
  { ids: 'A65–CC6', bank: '$9E', table: '$9E:8000' },
  { ids: 'CC7–F57', bank: '$B2', table: '$B2:8000' },
  { ids: 'F58–121E', bank: '$B4', table: '$B4:8000' },
  { ids: '121F–14AC', bank: '$B5', table: '$B5:8000' },
  { ids: '14AD–14F9', bank: '$8E', table: '$8E:B67A' },
];

const dialogFlow = [
  '대사 ID 0x006은 000–25B 범위라 뱅크 $A8입니다.',
  '그 뱅크의 포인터 표에서 ID 순서대로 2바이트를 읽습니다. $A8:8000 + 0x006 × 2 = $A8:800C(파일 0x14000C)에 FE 85가 있습니다.',
  '같은 뱅크의 $A8:85FE(파일 0x1405FE)에 위 문자열이 있습니다.',
  '창 정보는 $8E:C9BA + 0x006 × 2 = $8E:C9C6에 있는 19 06입니다. 첫 바이트가 FF면 나레이션 창입니다.',
];

const fontRanges = [
  { code: '0x100–0x4FF', size: '8×16', width: '9px', origin: '가나', where: '$83:DE00' },
  { code: '0x500–0x7EF', size: '16×16', width: '13px', origin: '한자', where: '$83:8000' },
  { code: '0x7F0–0xBEF', size: '16×16', width: '13px', origin: '한자', where: '$BF:8000' },
];

const lineRules = [
  '단어 중간에서 끊지 않습니다.',
  '위아래 줄 길이를 비슷하게 맞춥니다.',
  '필요한 것보다 줄을 많이 쓰지 않습니다.',
  '더듬는 말(「주‥죽어」)은 한 줄에 둡니다.',
];

