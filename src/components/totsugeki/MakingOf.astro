const emulators = [
  { name: 'Mesen 2', result: '정상. 이어하기에서 나온 대사 ID 순서가 일본판·v1.0·v1.1·v1.2(헤더 있음/없음) 모두 같음' },
  { name: 'bsnes, bsnes-hd beta', result: '정상' },
  { name: 'snes9x, snes9x2010', result: '정상. snes9x2010도 이어하기 대사 ID 순서가 여섯 롬 모두 같음' },
