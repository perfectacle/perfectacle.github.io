---
import '../styles/global.css';
import SearchUi from '../components/SearchUi.astro';
import Analytics from '../components/Analytics.astro';
import { SITE } from '../lib/posts.ts';
import { serializeJsonLd } from '../lib/structured-data.ts';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  image?: string | undefined;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[] | undefined;
}

const { title, description = SITE.description, image, type = 'website', noindex = false, jsonLd = [] } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image ?? '/images/avatar/avatar.png', Astro.site).href;
const nav = [
  { href: '/archives/', label: '아카이브' },
  { href: '/categories/', label: '카테고리' },
  { href: '/tags/', label: '태그' },
  { href: '/about/', label: '소개' },
  { href: '/games/romhacking/', label: '롬해킹' },
];
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title ?? SITE.title} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1114" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/images/favicon/favicon-32x32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/images/favicon/apple-touch-icon.png" />
    <link rel="alternate" type="application/atom+xml" title={SITE.title} href="/atom.xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    {jsonLd.map(data => (
      <script is:inline type="application/ld+json" set:html={serializeJsonLd(data)} />
    ))}
    <SearchUi />
    <Analytics />
    <slot name="head" />
    <script is:inline>
      (() => {
        let t = null;
        try {
          t = localStorage.getItem('theme');
        } catch {
          /* storage blocked: follow the OS */
        }
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
        document.documentElement.dataset.pfTheme = t;
      })();
    </script>
  </head>
  <body>
    <a class="visually-hidden" href="#main">
      본문으로 건너뛰기
    </a>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href="/" aria-current={current === '/' ? 'page' : undefined}>
          {SITE.title}
          <span class="caret" aria-hidden="true"></span>
        </a>
        <nav aria-label="주요 메뉴">
          <ul>
            {nav.map(({ href, label }) => (
              <li>
                <a href={href} aria-current={current.startsWith(href) ? 'page' : undefined}>
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="actions">
          <template data-pagefind>
            <pagefind-modal-trigger compact placeholder="검색"></pagefind-modal-trigger>
            <pagefind-modal></pagefind-modal>
          </template>
          <button class="icon-btn" id="theme-toggle" type="button" aria-label="테마 전환">
            <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                d="M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10ZM12 1v2m0 18v2M4.2 4.2l1.4 1.4m12.8 12.8 1.4 1.4M1 12h2m18 0h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"
              />
            </svg>
            <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linejoin="round"
                d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"
              />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="section-label">{SITE.subtitle}</p>
        <p>
          © 2016–{new Date().getFullYear()} {SITE.author} · <a href="/atom.xml">RSS</a> · <a href="/search/">검색</a> ·{' '}
          <a href="https://github.com/perfectacle" target="_blank" rel="noopener">
            GitHub
          </a>
        </p>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('theme-toggle');
      toggle?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        document.documentElement.dataset.pfTheme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {
          /* storage blocked: theme lasts this page only */
        }
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    max-width: var(--page);
    margin: 0 auto;
    padding: 0 var(--gutter);
    height: 60px;
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .brand {
    font-weight: 800;
    font-size: 1.05rem;
    color: var(--fg);
    white-space: nowrap;
    letter-spacing: -0.02em;
  }
  .brand:hover {
    text-decoration: none;
  }
  /* Old-school terminal cursor, the site's one playful touch: a narrow phosphor-green block at cap height with a
     glow, blinking on/off like a real terminal (step timing, no fade). Reduced motion keeps it lit and still. */
  .caret {
    --phosphor: #39ff14;
    display: inline-block;
    width: 0.36em;
    height: 0.92em;
    margin-left: 4px;
    vertical-align: -0.08em;
    background: var(--phosphor);
    box-shadow:
      0 0 3px var(--phosphor),
      0 0 9px color-mix(in srgb, var(--phosphor) 60%, transparent);
  }
  /* Neon on white washes out; a dark-green rim keeps the shape while the glow keeps the neon feel. */
  :global([data-theme='light']) .caret {
    box-shadow:
      0 0 0 1px #0b6b21,
      0 0 5px color-mix(in srgb, var(--phosphor) 85%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .caret {
      animation: caret-blink 1.06s steps(1, end) infinite;
    }
    @keyframes caret-blink {
      50% {
        opacity: 0;
      }
    }
  }
  nav {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  nav ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    padding: 6px 10px;
    border-radius: 8px;
    color: var(--fg-muted);
    font-size: 0.93rem;
    white-space: nowrap;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--fg);
    background: var(--bg-soft);
    text-decoration: none;
  }
  .actions {
    display: flex;
    gap: 4px;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
  }
  .icon-btn:hover {
    background: var(--bg-soft);
    color: var(--fg);
  }
  :global([data-theme='dark']) .sun,
  :global([data-theme='light']) .moon {
    display: none;
  }
  main:focus {
    outline: none;
  }
  main {
    /* svh: 100vh on mobile includes the collapsing URL bar and forces needless scrolling. */
    min-height: calc(100svh - 160px);
    padding: 40px 0 64px;
  }
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 24px 0;
    font-size: 0.875rem;
    color: var(--fg-muted);
  }
  .site-footer p {
    margin: 0;
  }
  .site-footer a {
    display: inline-block;
    padding: 8px 2px;
    color: inherit;
  }
  /* Pagefind's trigger ships its own bordered button with very high-specificity selectors;
     match it to the neighbouring icon buttons. */
  .actions :global(.pf-trigger-btn) {
    height: 36px !important;
    min-width: 36px !important;
    border: 0 !important;
    border-radius: 8px !important;
    background: transparent !important;
    color: var(--fg-muted) !important;
  }
  .actions :global(.pf-trigger-btn:hover) {
    background: var(--bg-soft) !important;
    color: var(--fg) !important;
  }

  /* Phones: brand + icons on the first row, the nav as its own scrollable row so every item is reachable.
     The two rows (~97px) would cover over a tenth of the screen while reading, so the header scrolls away;
     long posts get a back-to-top button instead. */
  @media (max-width: 640px) {
    .site-header {
      position: static;
      background: var(--bg);
      backdrop-filter: none;
    }
    .bar {
      flex-wrap: wrap;
      height: auto;
      gap: 0;
      padding: 0 4px 0 var(--gutter);
    }
    .brand {
      flex: 1;
      font-size: 1rem;
      line-height: 52px;
    }
    .icon-btn,
    .actions :global(.pf-trigger-btn) {
      width: 44px !important;
      height: 44px !important;
    }
    nav {
      order: 3;
      /* Full header width: 100% plus the .bar side padding it sits inside. */
      flex: 0 0 calc(100% + 4px + var(--gutter));
      margin: 0 -4px 0 calc(-1 * var(--gutter));
      padding: 0 8px;
      border-top: 1px solid var(--border);
    }
    nav ul {
      gap: 0;
    }
    nav a {
      position: relative;
      display: flex;
      align-items: center;
      min-height: 44px;
      padding: 0 12px;
      border-radius: 0;
      font-size: 0.95rem;
    }
    nav a:hover,
    nav a[aria-current='page'] {
      background: none;
    }
    nav a[aria-current='page'] {
      font-weight: 700;
    }
    nav a[aria-current='page']::after {
      content: '';
      position: absolute;
      inset: auto 12px 0;
      height: 2px;
      background: var(--accent);
    }
    main {
      padding: 20px 0 48px;
    }
    .site-footer {
      padding-bottom: calc(24px + env(safe-area-inset-bottom));
    }
  }
</style>
