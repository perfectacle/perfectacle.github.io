---
import Base from './Base.astro';
import { SITE } from '../lib/posts.ts';
import { profilePage } from '../lib/structured-data.ts';

const { frontmatter } = Astro.props;
// `profileImage` marks the author's profile page.
const jsonLd = frontmatter.profileImage ? [profilePage(SITE, frontmatter.profileImage)] : [];
---

<Base title={frontmatter.title} description={frontmatter.description} jsonLd={jsonLd}>
  <article class="container narrow">
    <h1>{frontmatter.title}</h1>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  h1 {
    margin: 0 0 24px;
    font-size: 1.9rem;
    letter-spacing: -0.02em;
  }
</style>
