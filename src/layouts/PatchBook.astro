---
import '../styles/patch-book.css';
import Analytics from '../components/Analytics.astro';
import SectionNav from '../components/kr-patch/SectionNav.astro';
import ImagePreview from '../components/kr-patch/ImagePreview.astro';
import Bgm from '../components/kr-patch/Bgm.astro';
import Comments from '../components/Comments.astro';
import { SECTION_TITLES } from '../lib/patch-sections.ts';
import { SITE } from '../lib/posts.ts';
import { KR_PATCH_SFC_PATH, KR_PATCH_SITE_TITLE, KR_PATCHES, type KrPatchTheme } from '../lib/kr-patches.ts';
import { breadcrumbs, serializeJsonLd } from '../lib/structured-data.ts';
import { OG_SIZE } from '../lib/kr-patch-og.ts';

interface Props {
  title: string;
  description: string;
  /** Where this page sits, from the patch list down to the page itself. */
  trail: { name: string; path: string }[];
  /** Which game's look the page takes. */
  theme: KrPatchTheme | 'sfc';
  copyright: string[];
  links?: { href: string; label: string }[];
  sections?: { id: string; label: string }[];
}

const { title, description, trail, theme, copyright, links = [], sections = [] } = Astro.props;
const patch = KR_PATCHES.find(p => p.theme === theme);
if (!patch && theme !== 'sfc') throw new Error(`Unknown theme ${theme}`);
const color = patch?.color ?? '#182b22';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Every page has an og.png beside it, drawn from the title screens at build time.
const preview = {
  src: `${Astro.url.pathname}og.png`,
  alt: patch ? `${patch.title} 타이틀 화면` : '한글패치로 즐기는 슈퍼 패미콤 게임들의 타이틀 화면',
  ...(patch ? OG_SIZE.game : OG_SIZE.catalogue),
};
const imageUrl = new URL(preview.src, Astro.site).href;
// A game page's heading already says 한글패치, so the tab names the game alone before the site name.
const tabTitle = patch?.title ?? title;
const fullTitle = tabTitle === KR_PATCH_SITE_TITLE ? tabTitle : `${tabTitle} | ${KR_PATCH_SITE_TITLE}`;
// A shared card shows no site name in some messengers: a game keeps 한글패치 in its own title, a list takes the tab's.
const ogTitle = patch ? title : fullTitle;
---

<!doctype html>
<html lang="ko" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="theme-color" content={color} />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/images/favicon/favicon-32x32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/images/favicon/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preload" href="/games/kr-patches/fonts/guide.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/games/kr-patches/fonts/guide-bold.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(preview.width)} />
    <meta property="og:image:height" content={String(preview.height)} />
    <meta property="og:image:alt" content={preview.alt} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content={KR_PATCH_SITE_TITLE} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={serializeJsonLd(breadcrumbs(SITE, trail, null))} />
    <Analytics />
  </head>
  <body class:list={{ 'has-section-nav': sections.length > 0 }}>
    <a class="skip-link" href="#main">
      본문으로 건너뛰기
    </a>
    {theme !== 'sfc' && (
      <header class="masthead page-width">
        <nav aria-label="한글패치">
          <a class="wordmark" href={KR_PATCH_SFC_PATH}>
            <span aria-hidden="true">←</span> 한글패치 목록
          </a>
        </nav>
      </header>
    )}
    {sections.length > 0 && (
      <SectionNav sections={patch ? [...sections, { id: 'comments', label: SECTION_TITLES.comments }] : sections} />
    )}
    <main id="main" tabindex="-1">
      <slot />
      {patch && (
        <div class="patch-comments page-width">
          <Comments path={`${patch.path}/`} />
        </div>
      )}
    </main>
    {theme !== 'sfc' && <ImagePreview />}
    {patch && <Bgm patch={patch} />}
    <footer class="page-footer page-width">
      {copyright.map(line => (
        <p>{line}</p>
      ))}
      <p>{patch ? '화면·그림·배경음악은' : '화면과 그림은'} 원작 게임에서 가져왔습니다.</p>
      <p>
        제목·라벨 글꼴은 <a href="https://galmuri.quiple.dev/">Galmuri</a>(SIL Open Font License 1.1)입니다.
      </p>
      {links.length > 0 && (
        <p>
          {links.map((link, i) => (
            <>
              {i > 0 && <span aria-hidden="true"> · </span>}
              <a href={link.href}>{link.label}</a>
            </>
          ))}
        </p>
      )}
    </footer>
  </body>
</html>
