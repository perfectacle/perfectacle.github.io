---
import '../styles/patch-book.css';
import Analytics from '../components/Analytics.astro';
import { SITE } from '../lib/posts.ts';
import { KR_PATCHES, type KrPatchTheme } from '../lib/kr-patches.ts';
import { breadcrumbs, serializeJsonLd } from '../lib/structured-data.ts';

interface Props {
  title: string;
  description: string;
  /** Where this page sits below the home page, ending with the page itself. */
  trail: { name: string; path: string }[];
  /** Which game's look the page takes. */
  theme: KrPatchTheme;
  /** Social preview: a game screen, 256×224 unless a size is given. */
  image: { src: string; alt: string; width?: number; height?: number };
  copyright: string[];
  links?: { href: string; label: string }[];
}

const { title, description, trail, theme, image, copyright, links = [] } = Astro.props;
const patch = KR_PATCHES.find(p => p.theme === theme);
if (!patch) throw new Error(`Unknown theme ${theme}`);
const { path: assets, color } = patch;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image.src, Astro.site).href;
---

<!doctype html>
<html lang="ko" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {SITE.title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="theme-color" content={color} />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/images/favicon/favicon-32x32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/images/favicon/apple-touch-icon.png" />
    <link rel="alternate" type="application/atom+xml" title={SITE.title} href="/atom.xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preload" href={`${assets}/fonts/guide.woff2`} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(image.width ?? 256)} />
    <meta property="og:image:height" content={String(image.height ?? 224)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content={SITE.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={serializeJsonLd(breadcrumbs(SITE, trail))} />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">
      본문으로 건너뛰기
    </a>
    <header class="masthead page-width">
      <a class="wordmark" href="/">
        {SITE.title}
      </a>
      <nav aria-label="사이트 메뉴">
        <a class="pointer" href="/games/kr-patches/">
          한글패치 목록
        </a>
        <a class="pointer" href="/">
          블로그
        </a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="page-footer page-width">
      {copyright.map(line => (
        <p>{line}</p>
      ))}
      <p>화면과 그림은 원작 게임에서 가져왔습니다.</p>
      <p>
        제목·라벨 글꼴은 <a href="https://galmuri.quiple.dev/">Galmuri</a>(SIL Open Font License 1.1)입니다.
      </p>
      {links.length > 0 && (
        <p>
          {links.map((link, i) => (
            <>
              {i > 0 && <span aria-hidden="true"> · </span>}
              <a href={link.href}>{link.label}</a>
            </>
          ))}
        </p>
      )}
    </footer>
  </body>
</html>
