---
import '../styles/patch-book.css';
import Analytics from '../components/Analytics.astro';
import SectionNav from '../components/kr-patch/SectionNav.astro';
import { SITE } from '../lib/posts.ts';
import { KR_PATCH_LIST_PATH, KR_PATCH_SITE_TITLE, KR_PATCHES, type KrPatchTheme } from '../lib/kr-patches.ts';
import { breadcrumbs, serializeJsonLd } from '../lib/structured-data.ts';

interface Props {
  title: string;
  description: string;
  /** Where this page sits, from the patch list down to the page itself. */
  trail: { name: string; path: string }[];
  /** Which game's look the page takes. */
  theme: KrPatchTheme | 'sfc';
  /** Social preview: a game screen, 256×224 unless a size is given. */
  image: { src: string; alt: string; width?: number; height?: number };
  copyright: string[];
  links?: { href: string; label: string }[];
  sections?: { id: string; label: string }[];
}

const { title, description, trail, theme, image, copyright, links = [], sections = [] } = Astro.props;
const patch = KR_PATCHES.find(p => p.theme === theme);
if (!patch && theme !== 'sfc') throw new Error(`Unknown theme ${theme}`);
const assets = patch?.path;
const color = patch?.color ?? '#080e23';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image.src, Astro.site).href;
const fullTitle = title === KR_PATCH_SITE_TITLE ? title : `${title} | ${KR_PATCH_SITE_TITLE}`;
---

<!doctype html>
<html lang="ko" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="theme-color" content={color} />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/images/favicon/favicon-32x32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/images/favicon/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    {assets && <link rel="preload" href={`${assets}/fonts/guide.woff2`} as="font" type="font/woff2" crossorigin />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(image.width ?? 256)} />
    <meta property="og:image:height" content={String(image.height ?? 224)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content={KR_PATCH_SITE_TITLE} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={serializeJsonLd(breadcrumbs(SITE, trail, null))} />
    <Analytics />
  </head>
  <body class:list={{ 'has-section-nav': sections.length > 0 }}>
    <a class="skip-link" href="#main">
      본문으로 건너뛰기
    </a>
    {theme !== 'sfc' && (
      <header class="masthead page-width">
        <nav aria-label="한글패치">
          <a class="wordmark" href={KR_PATCH_LIST_PATH}>
            <span aria-hidden="true">←</span> 한글패치 목록
          </a>
        </nav>
      </header>
    )}
    {sections.length > 0 && <SectionNav sections={sections} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="page-footer page-width">
      {copyright.map(line => (
        <p>{line}</p>
      ))}
      <p>화면과 그림은 원작 게임에서 가져왔습니다.</p>
      <p>
        제목·라벨 글꼴은 <a href="https://galmuri.quiple.dev/">Galmuri</a>(SIL Open Font License 1.1)입니다.
      </p>
      {links.length > 0 && (
        <p>
          {links.map((link, i) => (
            <>
              {i > 0 && <span aria-hidden="true"> · </span>}
              <a href={link.href}>{link.label}</a>
            </>
          ))}
        </p>
      )}
    </footer>
  </body>
</html>
