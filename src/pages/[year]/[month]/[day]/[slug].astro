---
import { render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import Toc from '../../../../components/Toc.astro';
import Comments from '../../../../components/Comments.astro';
import YoutubeFacade from '../../../../components/YoutubeFacade.astro';
import ImageZoom from '../../../../components/ImageZoom.astro';
import SeriesNav from '../../../../components/SeriesNav.astro';
import {
  categoryPath,
  coverImage,
  excerpt,
  formatDate,
  getPosts,
  postPath,
  postSlug,
  readingMinutes,
  relatedPosts,
  seriesOf,
  tagPath,
  ymd,
  type Post,
  type SeriesInfo,
  SITE,
} from '../../../../lib/posts.ts';
import { blogPosting, breadcrumbs } from '../../../../lib/structured-data.ts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => {
    const { y, m, d } = ymd(post.data.date);
    const series = seriesOf(post, posts);
    return {
      params: { year: y, month: m, day: d, slug: postSlug(post) },
      props: {
        post,
        newer: posts[i - 1],
        older: posts[i + 1],
        series,
        // The series box already lists its parts, so related posts look beyond them.
        related: relatedPosts(post, posts, { exclude: [posts[i - 1], posts[i + 1], ...(series?.posts ?? [])] }),
      },
    };
  });
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
  related: Post[];
  series?: SeriesInfo | undefined;
}
const { post, newer, older, related, series } = Astro.props;
const { Content, headings } = await render(post);
const path = postPath(post);
const ogFile = coverImage(post);
const ogImage = ogFile ? `${path}${ogFile}` : undefined;
const toc = headings.filter(h => h.depth >= 2 && h.depth <= 3);
const cats = post.data.categories;
const description = excerpt(post, 150) || post.data.title;
const jsonLd = [
  blogPosting(SITE, {
    title: post.data.title,
    description,
    path,
    date: post.data.date,
    tags: post.data.tags,
    categories: cats,
    image: ogImage,
  }),
  breadcrumbs(SITE, [
    ...cats.map((c, i) => ({ name: c, path: categoryPath(cats.slice(0, i + 1)) })),
    { name: post.data.title, path },
  ]),
];
---

<Base title={post.data.title} description={description} image={ogImage} type="article" jsonLd={jsonLd}>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.date.toISOString()} />
    <meta property="article:author" content={new URL('/about/', SITE.url).href} />
    {cats[0] && <meta property="article:section" content={cats[0]} />}
    {post.data.tags.map(t => (
      <meta property="article:tag" content={t} />
    ))}
  </Fragment>
  <div class="layout">
    <article class="post" data-pagefind-body>
      <header class="post-head">
        {cats.length > 0 && (
          <p class="cats" data-pagefind-ignore="all">
            {cats.map((c, i) => (
              <>
                {i > 0 && <span aria-hidden="true"> / </span>}
                <a href={categoryPath(cats.slice(0, i + 1))}>{c}</a>
              </>
            ))}
          </p>
        )}
        <h1 data-pagefind-meta="title">{post.data.title}</h1>
        <p class="meta" data-pagefind-ignore="all">
          <time class="mono" datetime={post.data.date.toISOString()}>
            {formatDate(post.data.date)}
          </time>
          <span aria-hidden="true">·</span>
          <span>읽는 데 {readingMinutes(post)}분</span>
          <span aria-hidden="true">·</span>
          <a class="to-comments" href="#comments">
            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
              <path
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linejoin="round"
                d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.9A8 8 0 1 1 21 12Z"
              />
            </svg>
            댓글
          </a>
        </p>
      </header>

      {series && <SeriesNav series={series} />}

      {toc.length > 2 && (
        <details class="toc-inline" data-pagefind-ignore="all">
          <summary>목차</summary>
          <Toc headings={toc} />
        </details>
      )}

      <div class="prose">
        <Content />
      </div>

      {post.data.tags.length > 0 && (
        <ul class="chips tags" data-pagefind-ignore>
          {post.data.tags.map(t => (
            <li>
              <a class="chip" href={tagPath(t)}>
                #{t}
              </a>
            </li>
          ))}
        </ul>
      )}

      {/* Skipped when the series neighbours are the same posts as the plain previous/next links below. */}
      {series && (series.posts[series.index - 1] !== older || series.posts[series.index + 1] !== newer) && (
        <SeriesNav series={series} variant="pager" />
      )}

      {related.length > 0 && (
        <section class="related" aria-labelledby="related-title" data-pagefind-ignore>
          <h2 id="related-title" class="section-label">
            관련 글
          </h2>
          <ul>
            {related.map(r => (
              <li>
                <a href={postPath(r)}>
                  <span class="title">{r.data.title}</span>
                  <time class="mono" datetime={r.data.date.toISOString()}>
                    {formatDate(r.data.date)}
                  </time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <nav class="siblings" aria-label="이전·다음 글" data-pagefind-ignore>
        {older ? (
          <a href={postPath(older)} rel="prev">
            <span class="muted">이전 글</span>
            {older.data.title}
          </a>
        ) : (
          <span />
        )}
        {newer ? (
          <a href={postPath(newer)} rel="next" class="next">
            <span class="muted">다음 글</span>
            {newer.data.title}
          </a>
        ) : (
          <span />
        )}
      </nav>

      <Comments path={path} />
      <YoutubeFacade />
      <ImageZoom />
    </article>

    {toc.length > 2 && (
      <aside class="toc-side" aria-label="목차">
        <p class="toc-title">목차</p>
        <Toc headings={toc} />
        <p class="toc-foot">
          <a href="#main">↑ 맨 위로</a>
          <a href="#comments">댓글로 이동</a>
        </p>
      </aside>
    )}
  </div>

  <div class="progress" aria-hidden="true"></div>
  <div class="fab">
    {toc.length > 2 && (
      <button
        type="button"
        class="fab-btn toc-open"
        aria-haspopup="dialog"
        aria-controls="toc-sheet"
        aria-label="목차 열기"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            d="M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01"
          />
        </svg>
      </button>
    )}
    <a class="fab-btn to-top" href="#main" aria-label="맨 위로 이동">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 19V5m-6 6 6-6 6 6"
        />
      </svg>
    </a>
  </div>
  {toc.length > 2 && (
    <dialog id="toc-sheet" class="toc-sheet" aria-labelledby="toc-sheet-title" data-pagefind-ignore="all">
      <div class="sheet">
        <div class="sheet-head">
          <p id="toc-sheet-title" class="toc-title">
            목차
          </p>
          <button type="button" class="sheet-close" aria-label="목차 닫기">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                d="M6 6l12 12M18 6 6 18"
              />
            </svg>
          </button>
        </div>
        <Toc headings={toc} />
      </div>
    </dialog>
  )}

  <script>
    // Copy buttons are rendered hidden at build time and only shown once they can work.
    for (const button of document.querySelectorAll<HTMLButtonElement>('.code-copy')) {
      const code = button.closest('.code-block')?.querySelector('pre');
      if (!code || !navigator.clipboard) continue;
      button.hidden = false;
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code.innerText.replace(/\n$/, ''));
          button.textContent = '복사됨';
          button.dataset['copied'] = '';
        } catch {
          button.textContent = '복사 실패';
        }
        setTimeout(() => {
          button.textContent = '복사';
          delete button.dataset['copied'];
        }, 2000);
      });
    }

    // The floating buttons appear once the post header has scrolled away, and step aside when the footer arrives
    // so they never cover the footer links.
    const fab = document.querySelector<HTMLElement>('.fab');
    const toTop = document.querySelector<HTMLAnchorElement>('.to-top');
    const head = document.querySelector('.post-head');
    const footer = document.querySelector('.site-footer');
    if (fab && toTop && head && footer) {
      let pastHead = false;
      let atFooter = false;
      const update = () => fab.classList.toggle('show', pastHead && !atFooter);
      new IntersectionObserver(([e]) => {
        pastHead = !!e && !e.isIntersecting && e.boundingClientRect.top < 0;
        update();
      }).observe(head);
      new IntersectionObserver(([e]) => {
        atFooter = !!e?.isIntersecting;
        update();
      }).observe(footer);
      toTop.addEventListener('click', e => {
        e.preventDefault();
        window.scrollTo({
          top: 0,
          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        });
        document.getElementById('main')?.focus({ preventScroll: true });
      });
    }

    // Table of contents as a bottom sheet for screens without the sidebar. <dialog>.showModal() keeps focus
    // inside and closes on Escape; focus goes back to the button, or to the heading that was picked.
    const sheet = document.querySelector<HTMLDialogElement>('#toc-sheet');
    const opener = document.querySelector<HTMLButtonElement>('.toc-open');
    if (sheet && opener) {
      opener.setAttribute('aria-expanded', 'false');
      opener.addEventListener('click', () => {
        sheet.showModal();
        opener.setAttribute('aria-expanded', 'true');
        sheet.querySelector<HTMLAnchorElement>('.toc a.active')?.scrollIntoView({ block: 'center' });
      });
      sheet.addEventListener('close', () => {
        opener.setAttribute('aria-expanded', 'false');
      });
      sheet.querySelector('.sheet-close')?.addEventListener('click', () => sheet.close());
      // A click on the backdrop lands on the <dialog> itself; clicks on the sheet land on its children.
      sheet.addEventListener('click', e => {
        if (e.target === sheet) sheet.close();
      });
      sheet.querySelectorAll<HTMLAnchorElement>('.toc a').forEach(a =>
        a.addEventListener('click', e => {
          const target = document.getElementById(decodeURIComponent(a.hash.slice(1)));
          if (!target) return;
          e.preventDefault();
          // Closing hands focus back to the button, so the jump and the focus move come after it.
          sheet.close();
          location.hash = a.hash;
          target.tabIndex = -1;
          target.focus({ preventScroll: true });
        }),
      );
    }
  </script>
  <script>
    // Mermaid is large and rendering blocks the main thread, so each diagram is drawn only when it
    // approaches the viewport (posts can have many). The library itself loads with the first one.
    const blocks = [...document.querySelectorAll<HTMLElement>('pre > code.language-mermaid')];
    let mermaidReady: Promise<typeof import('mermaid').default> | undefined;
    const loadMermaid = () =>
      (mermaidReady ??= import('mermaid').then(({ default: mermaid }) => {
        mermaid.initialize({
          startOnLoad: false,
          theme: document.documentElement.dataset['theme'] === 'dark' ? 'dark' : 'default',
        });
        return mermaid;
      }));
    const observer = new IntersectionObserver(
      entries => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          observer.unobserve(entry.target);
          const pre = entry.target as HTMLElement;
          const div = document.createElement('div');
          div.className = 'mermaid';
          div.textContent = pre.textContent;
          pre.replaceWith(div);
          void loadMermaid().then(mermaid => mermaid.run({ nodes: [div] }));
        }
      },
      { rootMargin: '400px 0px' },
    );
    for (const code of blocks) if (code.parentElement) observer.observe(code.parentElement);
  </script>
</Base>

<style>
  /* The post takes whatever the page frame leaves after the contents sidebar; running text inside it is held
     to --measure by the prose styles, so only code, tables and media reach the full width. */
  .layout {
    max-width: var(--page);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 280px);
    gap: 56px;
  }
  /* Without a contents sidebar the post takes the whole frame; text still stops at --measure. */
  @media (min-width: 1101px) {
    .layout:not(:has(.toc-side)) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .post-head h1 {
    max-width: var(--measure);
  }
  .post {
    min-width: 0;
  }
  .post-head {
    margin-bottom: 32px;
  }
  .cats {
    margin: 0;
    font-size: 0.88rem;
    color: var(--fg-muted);
  }
  .cats a {
    color: inherit;
  }
  h1 {
    margin: 6px 0 10px;
    font-size: 2.1rem;
    line-height: 1.3;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 6px;
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.9rem;
  }
  .meta .mono {
    font-size: 0.82rem;
  }
  .to-comments {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    /* 44px tap height without making the meta row taller. */
    margin-block: -10px;
    padding-block: 10px;
    color: inherit;
  }
  .to-comments:hover {
    color: var(--accent);
  }
  .toc-inline {
    display: none;
    margin-bottom: 24px;
    padding: 0 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .toc-inline summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .toc-inline :global(.toc) {
    padding-bottom: 12px;
  }
  .toc-inline :global(.toc a) {
    display: block;
    padding: 0.35em 0;
  }
  .toc-side {
    position: sticky;
    top: 84px;
    align-self: start;
    max-height: calc(100vh - 110px);
    overflow-y: auto;
    font-size: 0.85rem;
    padding-left: 16px;
    border-left: 1px solid var(--border);
  }
  .toc-title {
    margin: 0 0 6px;
    font-weight: 700;
    color: var(--fg);
  }
  .tags {
    margin-top: 40px;
  }
  .related {
    margin-top: 40px;
  }
  .related ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .related a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    min-height: 44px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    color: var(--fg);
    line-height: 1.45;
  }
  .related a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .related time {
    flex: none;
    color: var(--fg-muted);
    font-size: 0.78rem;
  }
  .toc-foot {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 16px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }
  .toc-foot a {
    color: var(--fg-muted);
  }
  .toc-foot a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  /* Reading progress, driven by the scroll position alone (no script); browsers without scroll timelines skip it. */
  .progress {
    display: none;
  }
  @supports (animation-timeline: scroll()) {
    .progress {
      display: block;
      position: fixed;
      inset: 0 0 auto;
      z-index: 20;
      height: 2px;
      background: var(--accent);
      transform-origin: 0 50%;
      animation: progress linear both;
    }
    /* A separate rule on purpose: the CSS minifier folds a timeline sitting next to the shorthand into
       `animation`, where browsers reject it and the bar never moves. */
    .layout ~ .progress {
      animation-timeline: scroll(root);
    }
    @keyframes progress {
      from {
        transform: scaleX(0);
      }
      to {
        transform: scaleX(1);
      }
    }
  }
  .fab {
    position: fixed;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 15;
    display: flex;
    gap: 8px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
  }
  .fab.show {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .fab-btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--bg);
    color: var(--fg-muted);
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.08);
    cursor: pointer;
  }
  .fab-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .toc-sheet {
    position: fixed;
    inset: auto 0 0;
    width: 100%;
    max-width: 640px;
    max-height: 75vh;
    margin: 0 auto;
    padding: 0;
    border: 1px solid var(--border);
    border-bottom: 0;
    border-radius: 16px 16px 0 0;
    background: var(--bg);
    color: var(--fg);
  }
  .toc-sheet::backdrop {
    background: rgb(0 0 0 / 0.45);
  }
  .sheet {
    padding: 4px 20px max(16px, env(safe-area-inset-bottom));
  }
  .sheet-head {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .sheet-head .toc-title {
    margin: 0;
  }
  .sheet-close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
  }
  .toc-sheet :global(.toc a) {
    display: flex;
    align-items: center;
    min-height: 44px;
  }
  .toc-sheet :global(.toc li) {
    padding: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .fab {
      transition:
        opacity 0.2s,
        transform 0.2s,
        visibility 0.2s;
    }
    .toc-sheet[open] {
      animation: sheet-in 0.2s ease-out;
    }
    @keyframes sheet-in {
      from {
        transform: translateY(24px);
        opacity: 0;
      }
    }
  }
  /* The sidebar already has the contents and a way back up. */
  @media (min-width: 1101px) {
    .toc-open {
      display: none;
    }
    .layout:has(.toc-side) ~ .fab {
      display: none;
    }
  }
  .siblings {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 40px 0;
  }
  .siblings a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--fg);
    font-weight: 600;
    line-height: 1.45;
  }
  .siblings a:hover {
    border-color: var(--accent);
    text-decoration: none;
  }
  .siblings .muted {
    font-size: 0.8rem;
    font-weight: 400;
  }
  .siblings .next {
    text-align: right;
  }
  @media (max-width: 1100px) {
    .layout {
      grid-template-columns: minmax(0, var(--content));
      justify-content: center;
    }
    .toc-side {
      display: none;
    }
    .toc-inline {
      display: block;
    }
  }
  @media (max-width: 560px) {
    h1 {
      font-size: 1.65rem;
    }
    .siblings {
      grid-template-columns: 1fr;
    }
    .siblings .next {
      text-align: left;
    }
  }
</style>
