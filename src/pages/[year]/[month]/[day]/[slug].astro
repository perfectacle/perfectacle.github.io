---
import { render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import Toc from '../../../../components/Toc.astro';
import Comments from '../../../../components/Comments.astro';
import YoutubeFacade from '../../../../components/YoutubeFacade.astro';
import ImageZoom from '../../../../components/ImageZoom.astro';
import {
  categoryPath,
  excerpt,
  firstImageSrc,
  formatDate,
  getPosts,
  postPath,
  postSlug,
  readingMinutes,
  tagName,
  tagPath,
  ymd,
  type Post,
} from '../../../../lib/posts.ts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => {
    const { y, m, d } = ymd(post.data.date);
    return {
      params: { year: y, month: m, day: d, slug: postSlug(post) },
      props: { post, newer: posts[i - 1], older: posts[i + 1] },
    };
  });
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const path = postPath(post);
const firstImage = firstImageSrc(post);
const ogFile = post.data.image?.replace(/^\.\//, '') ?? firstImage;
const ogImage = ogFile ? `${path}${ogFile}` : undefined;
const toc = headings.filter(h => h.depth >= 2 && h.depth <= 3);
const cats = post.data.categories;
---

<Base title={post.data.title} description={excerpt(post, 150) || post.data.title} image={ogImage} type="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.date.toISOString()} />
    {post.data.tags.map(t => (
      <meta property="article:tag" content={tagName(t)} />
    ))}
  </Fragment>
  <div class="layout">
    <article class="post" data-pagefind-body>
      <header class="post-head">
        {cats.length > 0 && (
          <p class="cats" data-pagefind-ignore="all">
            {cats.map((c, i) => (
              <>
                {i > 0 && <span aria-hidden="true"> / </span>}
                <a href={categoryPath(cats.slice(0, i + 1))}>{c}</a>
              </>
            ))}
          </p>
        )}
        <h1 data-pagefind-meta="title">{post.data.title}</h1>
        <p class="meta" data-pagefind-ignore="all">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <span aria-hidden="true">·</span>
          <span>읽는 데 {readingMinutes(post)}분</span>
        </p>
      </header>

      {toc.length > 2 && (
        <details class="toc-inline" data-pagefind-ignore="all">
          <summary>목차</summary>
          <Toc headings={toc} />
        </details>
      )}

      <div class="prose">
        <Content />
      </div>

      {post.data.tags.length > 0 && (
        <ul class="chips tags" data-pagefind-ignore>
          {post.data.tags.map(t => (
            <li>
              <a class="chip" href={tagPath(t)}>
                #{tagName(t)}
              </a>
            </li>
          ))}
        </ul>
      )}

      <nav class="siblings" aria-label="이전·다음 글" data-pagefind-ignore>
        {older ? (
          <a href={postPath(older)} rel="prev">
            <span class="muted">이전 글</span>
            {older.data.title}
          </a>
        ) : (
          <span />
        )}
        {newer ? (
          <a href={postPath(newer)} rel="next" class="next">
            <span class="muted">다음 글</span>
            {newer.data.title}
          </a>
        ) : (
          <span />
        )}
      </nav>

      <Comments path={path} title={post.data.title} />
      <YoutubeFacade />
      <ImageZoom />
    </article>

    {toc.length > 2 && (
      <aside class="toc-side" aria-label="목차">
        <p class="toc-title">목차</p>
        <Toc headings={toc} />
      </aside>
    )}
  </div>

  <script>
    // Loaded only on pages that have diagrams; mermaid is a large bundle.
    const blocks = document.querySelectorAll<HTMLElement>('pre > code.language-mermaid');
    if (blocks.length) {
      const { default: mermaid } = await import('mermaid');
      for (const code of blocks) {
        const div = document.createElement('div');
        div.className = 'mermaid';
        div.textContent = code.textContent;
        code.parentElement?.replaceWith(div);
      }
      mermaid.initialize({
        startOnLoad: false,
        theme: document.documentElement.dataset['theme'] === 'dark' ? 'dark' : 'default',
      });
      await mermaid.run();
    }
  </script>
</Base>

<style>
  .layout {
    max-width: var(--wide);
    margin: 0 auto;
    padding: 0 16px;
    display: grid;
    grid-template-columns: minmax(0, var(--content)) 1fr;
    gap: 56px;
    justify-content: center;
  }
  .post {
    min-width: 0;
  }
  .post-head {
    margin-bottom: 32px;
  }
  .cats {
    margin: 0;
    font-size: 0.88rem;
    color: var(--fg-muted);
  }
  .cats a {
    color: inherit;
  }
  h1 {
    margin: 6px 0 10px;
    font-size: 2.1rem;
    line-height: 1.3;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .meta {
    display: flex;
    gap: 6px;
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.9rem;
  }
  .toc-inline {
    display: none;
    margin-bottom: 24px;
    padding: 0 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .toc-inline summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .toc-inline :global(.toc) {
    padding-bottom: 12px;
  }
  .toc-inline :global(.toc a) {
    display: block;
    padding: 0.35em 0;
  }
  .toc-side {
    position: sticky;
    top: 84px;
    align-self: start;
    max-height: calc(100vh - 110px);
    overflow-y: auto;
    font-size: 0.85rem;
    padding-left: 16px;
    border-left: 1px solid var(--border);
  }
  .toc-title {
    margin: 0 0 6px;
    font-weight: 700;
    color: var(--fg);
  }
  .tags {
    margin-top: 40px;
  }
  .siblings {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 40px 0;
  }
  .siblings a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--fg);
    font-weight: 600;
    line-height: 1.45;
  }
  .siblings a:hover {
    border-color: var(--accent);
    text-decoration: none;
  }
  .siblings .muted {
    font-size: 0.8rem;
    font-weight: 400;
  }
  .siblings .next {
    text-align: right;
  }
  @media (max-width: 1100px) {
    .layout {
      grid-template-columns: minmax(0, var(--content));
    }
    .toc-side {
      display: none;
    }
    .toc-inline {
      display: block;
    }
  }
  @media (max-width: 560px) {
    h1 {
      font-size: 1.65rem;
    }
    .siblings {
      grid-template-columns: 1fr;
    }
    .siblings .next {
      text-align: left;
    }
  }
</style>
