---
import Base from '../../layouts/Base.astro';
import CategoryTree from '../../components/CategoryTree.astro';
import { flattenCategories, getCategoryTree } from '../../lib/posts.ts';

const tree = await getCategoryTree();
---

<Base title="카테고리">
  <div class="container">
    <h1>카테고리</h1>
    <p class="muted">
      카테고리 {tree.length}개 · 하위 카테고리 {flattenCategories(tree).length - tree.length}개
    </p>
    <CategoryTree nodes={tree} />
  </div>
</Base>

<style>
  h1 {
    margin: 0 0 4px;
    font-size: 1.9rem;
  }
  p {
    margin: 0 0 24px;
  }
</style>
