---
import PatchBook from '../../../layouts/PatchBook.astro';
import { KR_PATCH_LIST_PATH, KR_PATCHES, SMRPG_PATCH, releaseLabel } from '../../../lib/kr-patches';

// Games that share a credit line, like the two Super Gokuden parts, are credited together.
const credits = Map.groupBy(KR_PATCHES, patch => patch.copyright);
const copyright = [...credits].map(([line, patches]) => `${patches.map(patch => patch.title).join(' · ')}: ${line}`);
---

<PatchBook
  title="한글패치"
  trail={[{ name: '한글패치', path: KR_PATCH_LIST_PATH }]}
  description="한국어로 즐기는 고전 게임. 슈퍼 마리오 RPG, 드래곤볼 Z 초오공전 돌격편·각성편, 제절초 한글패치를 이 사이트에서 바로 적용합니다."
  theme="smrpg"
  image={{
    src: `${SMRPG_PATCH.path}/images/world-map-4x.webp`,
    alt: '슈퍼 마리오 RPG의 월드맵',
    width: 1024,
    height: 896,
  }}
  copyright={copyright}
>
  <section class="section page-width" aria-labelledby="catalogue-title">
    <h1 id="catalogue-title" class="pixel">
      한글패치
    </h1>
    <p class="lead">
      일본어로만 나왔던 게임을 한국어로 옮겼습니다. 일본판 롬파일을 고르면 페이지에서 바로 한글판을 만듭니다.
    </p>
    <ul class="catalogue">
      {KR_PATCHES.map((patch, i) => {
        const href = `${patch.path}/`;
        return (
          <li class="entry frame">
            <a class="entry-shot screen" href={href} tabindex="-1" aria-hidden="true">
              {i === 0 ? (
                <img src={href + patch.card.image} width="256" height="224" alt="" fetchpriority="high" />
              ) : (
                <img src={href + patch.card.image} width="256" height="224" alt="" loading="lazy" decoding="async" />
              )}
            </a>
            <div>
              <p class="label">{releaseLabel(patch, '')}</p>
              <h2 class="pixel">
                <a href={href}>{patch.title}</a>
              </h2>
              <p>{patch.card.summary}</p>
              <a class="pointer" href={href}>
                한글판 만들기
              </a>
            </div>
          </li>
        );
      })}
    </ul>
  </section>
</PatchBook>
