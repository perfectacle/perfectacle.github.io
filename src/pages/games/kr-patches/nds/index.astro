---
import PatchBook from '../../../../layouts/PatchBook.astro';
import NdsCartridge from '../../../../components/kr-patch/NdsCartridge.astro';
import NdsCartridgeBoot from '../../../../components/kr-patch/NdsCartridgeBoot.astro';
import { KR_PATCH_LIST_PATH, KR_PATCH_NDS_PATH, NDS_PATCHES } from '../../../../lib/kr-patches';
---

<PatchBook
  title="닌텐도 DS"
  trail={[
    { name: '한글패치', path: KR_PATCH_LIST_PATH },
    { name: '닌텐도 DS', path: KR_PATCH_NDS_PATH },
  ]}
  description={`닌텐도 DS 게임 한글패치 모음. ${NDS_PATCHES.map(p => p.title).join(', ')}. 일본판 롬파일을 고르면 이 사이트에서 바로 한글패치를 적용합니다.`}
  theme="nds"
  copyright={[]}
  links={[
    {
      href: 'https://commons.wikimedia.org/wiki/File:Nintendo-DS-Lite-Black-Open.png',
      label: '닌텐도 DS Lite 사진 Evan-Amos(퍼블릭 도메인)',
    },
  ]}
>
  <section class="nds-catalogue page-width" aria-labelledby="catalogue-title">
    <div class="nds-heading">
      <span class="nds-lcd" aria-hidden="true"></span>
      <div class="nds-heading-copy">
        <a class="nds-back" href={KR_PATCH_LIST_PATH}>
          <span aria-hidden="true">←</span> 기종 고르기
        </a>
        <h1 id="catalogue-title">닌텐도 DS</h1>
      </div>
      <img
        class="nds-photo"
        src="/games/kr-patches/catalogue/nintendo-ds-lite.webp"
        alt=""
        width="914"
        height="759"
        fetchpriority="high"
      />
    </div>
    <ul class="nds-games">
      {NDS_PATCHES.map((patch, i) => (
        <li>
          <a class="nds-card" href={`${patch.path}/`}>
            <NdsCartridge
              label={`/games/kr-patches/catalogue/labels/${patch.theme}.webp`}
              top={patch.titleScreen}
              bottom={`${patch.path}/images/title-bottom.webp`}
              eager={i === 0}
            />
            <span class="nds-hinge" aria-hidden="true"></span>
            <div class="nds-copy">
              <span class="nds-lcd" aria-hidden="true"></span>
              <div class="nds-banner">
                <img src={`${patch.path}/images/icon.webp`} width="32" height="32" alt="" />
                <div>
                  <h2>{patch.title}</h2>
                  <p class="nds-release">
                    게임 {patch.year} <span aria-hidden="true">·</span> 한글패치 v{patch.version}{' '}
                    <time datetime={patch.released}>({patch.released})</time>
                  </p>
                </div>
              </div>
              <p class="nds-copyright">{patch.copyright}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
  <NdsCartridgeBoot />
</PatchBook>

<style is:global>
  [data-theme='nds'] {
    --ink: #eceaf2;
    --muted: #b3afc0;
    --accent: #7fb2ff;
    --link: #a9cbff;
    color-scheme: dark;
  }

  [data-theme='nds'] body {
    background: radial-gradient(circle at 50% 0%, #2a2d3a, #101118 70%);
  }

  [data-theme='nds'] .page-width {
    width: min(100%, 960px);
    padding-inline: 24px;
  }

  [data-theme='nds'] .page-footer {
    margin-top: 32px;
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>

<style>
  .nds-catalogue {
    padding-block: clamp(40px, 7vw, 72px) 16px;
  }

  /* Heading and copy are the DS's two screens: a black bezel with a lit LCD inside, joined by the hinge. */
  .nds-heading,
  .nds-copy {
    position: relative;
    isolation: isolate;
    background: #0d0f14;
    box-shadow:
      inset 0 0 0 10px #1e1f25,
      inset 0 0 0 11px #3a3c45,
      0 0 0 2px #050507;
  }

  .nds-lcd {
    position: absolute;
    z-index: -1;
    inset: 14px;
    border-radius: 4px;
  }

  .nds-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 26px 30px;
    border-radius: 16px 16px 8px 8px;
  }

  .nds-heading .nds-lcd {
    background: radial-gradient(ellipse at 30% 0%, #1d2a3c, #0b1018 70%);
  }

  .nds-back {
    color: #8fb4dd;
    font-size: 0.875rem;
    text-decoration: none;
  }

  .nds-back:hover,
  .nds-back:focus-visible {
    color: #cfe3fa;
    text-decoration: underline;
  }

  .nds-heading h1 {
    margin-top: 6px;
    color: var(--ink);
    font-family: var(--pixel);
    font-synthesis: none;
    font-size: 24px;
    font-weight: 700;
  }

  .nds-photo {
    width: 120px;
    height: 120px;
    object-fit: contain;
  }

  .nds-games {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
    gap: 32px;
    margin-top: 40px;
    padding: 0;
    list-style: none;
  }

  .nds-card {
    display: grid;
    gap: 0;
    color: var(--ink);
    text-decoration: none;
  }

  .nds-card:focus-visible {
    outline: 4px solid var(--accent);
    outline-offset: 6px;
  }

  .nds-card :global(.ds-cartridge) {
    width: min(100%, 240px);
    justify-self: center;
  }

  .nds-card:hover :global(.ds-cartridge),
  .nds-card:focus-visible :global(.ds-cartridge) {
    transform: translateY(-6px);
  }

  /* The copy sits in a panel cut from the same glossy black plastic as the DS Lite lid above. */
  .nds-hinge {
    display: block;
    height: 14px;
    margin: 16px 24px 0;
    border-radius: 0 0 8px 8px;
    background: linear-gradient(#2e2f36, #111216);
  }

  .nds-copy {
    display: grid;
    gap: 10px;
    padding: 26px 28px;
    border-radius: 8px 8px 16px 16px;
    transition: box-shadow 0.15s;
  }

  .nds-copy .nds-lcd {
    background: linear-gradient(180deg, #121a26, #0b0f16);
  }

  .nds-card:hover .nds-copy,
  .nds-card:focus-visible .nds-copy {
    box-shadow:
      inset 0 0 0 10px #1e1f25,
      inset 0 0 0 11px #2a8be0,
      0 0 0 2px #050507,
      0 0 18px rgb(42 139 224 / 35%);
  }

  .nds-banner {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .nds-banner img {
    width: 64px;
    height: 64px;
    border-radius: 10px;
    box-shadow:
      0 0 0 2px #2a8be0,
      0 0 14px rgb(42 139 224 / 45%);
    image-rendering: pixelated;
  }

  .nds-release,
  .nds-copyright {
    color: #8e9ab0;
    font-size: 0.875rem;
  }

  .nds-release span {
    margin-inline: 4px;
  }

  .nds-release time {
    white-space: nowrap;
  }

  .nds-copy h2 {
    color: var(--ink);
    font-family: var(--pixel);
    font-synthesis: none;
    font-size: 24px;
    line-height: 1.4;
  }

  @media (width < 560px) {
    .nds-photo {
      display: none;
    }
  }
</style>
