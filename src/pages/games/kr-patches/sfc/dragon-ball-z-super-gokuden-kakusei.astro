---
import ReleaseDetails from '../../../../components/kr-patch/ReleaseDetails.astro';
import ReleaseScreenshot from '../../../../components/kr-patch/ReleaseScreenshot.astro';
import CompareGroup from '../../../../components/kr-patch/CompareGroup.astro';
import ManualPatch from '../../../../components/kr-patch/ManualPatch.astro';
import PatchBox from '../../../../components/kr-patch/PatchBox.astro';
import BattleSystem from '../../../../components/kakusei/BattleSystem.astro';
import Endings from '../../../../components/kakusei/Endings.astro';
import MakingOf from '../../../../components/kakusei/MakingOf.astro';
import PatchBook from '../../../../layouts/PatchBook.astro';
import { KAKUSEI_PATCH, downloads, releaseLabel, trail } from '../../../../lib/kr-patches';
import { kakuseiGroups, kakuseiV13Groups, kakuseiV13Versions, kakuseiVersions } from '../../../../lib/kakusei-showcase';

const patch = KAKUSEI_PATCH;
const base = patch.path;
const releaseGroups = [
  ...kakuseiGroups.filter(group => group.id === 'names'),
  ...kakuseiGroups.filter(group => group.id !== 'names'),
].map(group => ({
  ...group,
  pairs: group.pairs.filter(pair =>
    [
      'restore_goku',
      'restore_match',
      'tone_frieza_1',
      'title',
      'spell_kami',
      'credits_popo',
      'bugfix_vegeta_pod',
      'bugfix_bulma_ship',
    ].includes(pair.id),
  ),
}));

const play = [
  {
    image: 'battle',
    alt: '나메크성에서 애플이 연속 에너지탄을 쓰는 순간의 전투 화면',
    title: '전투',
    text: '상대가 기술을 쓰면 화면 위에 기술 이름이 뜹니다. 그 순간 맞는 버튼을 눌러 받아칩니다. 기술마다 계열이 있어 서로 이기고 지는 관계가 있습니다.',
  },
  {
    image: 'quiz',
    alt: '세 가지 답 중 하나를 고르는 DBZ 퀴즈',
    title: 'DBZ 퀴즈',
    text: '이야기 중간중간 DBZ 퀴즈가 나와 세 가지 답 중 하나를 고릅니다. 맞힌 비율은 세이브 화면에 남습니다.',
  },
  {
    image: 'shenron',
    alt: '신룡 앞에서 소원을 고르는 화면',
    title: '신룡의 소원',
    text: '드래곤볼을 모으면 신룡에게 소원을 빕니다. 전투력이나 체력을 올려 다음 싸움에 대비합니다.',
  },
  {
    image: 'gravity',
    alt: '20배 중력 속에서 수련을 시작하는 오공',
    title: '수련',
    text: '나메크성으로 가는 우주선 안에서는 20배 중력 속에서 수련합니다.',
  },
];

const castGroups = [
  {
    label: '주인공과 동료',
    members: [
      {
        id: 'goku',
        name: '손오공',
        role: '계왕권 · 원기옥',
        text: '어른이 되어 오반의 아버지가 된 오공. 계왕에게 배운 기술로 사이어인과 프리더에 맞섭니다.',
      },
      {
        id: 'gohan',
        name: '손오반',
        role: '오공의 아들',
        text: '오공의 아들. 피콜로에게 수련을 받고, 동료들을 되살리기 위해 나메크성으로 향합니다.',
      },
      {
        id: 'piccolo',
        name: '피콜로',
        role: '오반의 스승',
        text: '무술대회 결승에서 마주니어로 오공과 싸운 숙적. 사이어인이 온다는 걸 알고 오반을 단련시킵니다.',
      },
    ],
  },
  {
    label: '주요 적',
    members: [
      {
        id: 'raditz',
        name: '라데츠',
        role: '오공의 형',
        text: '오공을 찾아 지구로 온 사이어인. 오반을 데려가며 오공과 피콜로를 위협합니다.',
      },
      {
        id: 'vegeta',
        name: '베지터',
        role: '사이어인',
        text: '내퍼와 함께 지구를 찾아온 사이어인. 영원한 생명을 노리고 나메크성의 드래곤볼을 쫓습니다.',
      },
      {
        id: 'frieza',
        name: '프리더',
        role: '나메크성의 적',
        text: '영원한 생명을 얻으려 나메크성의 드래곤볼을 노리는 우주의 지배자. 누구에게나 존댓말을 씁니다.',
      },
    ],
  },
];
---

<PatchBook
  title={`${patch.title} 한글판`}
  trail={trail(patch)}
  description={`${patch.year}년 슈퍼 패미컴 ${patch.title} 한글패치 v${patch.version}. 일본판 롬파일을 고르면 이 페이지에서 바로 한글판을 만듭니다.`}
  sections={[
    { id: 'changes', label: '한국어로 바뀐 것' },
    { id: 'story', label: '이야기' },
    { id: 'cast', label: '등장인물' },
    { id: 'play', label: '진행 방식' },
    { id: 'battle-system', label: '전투 시스템' },
    { id: 'endings', label: '엔딩과 특별 장면' },
    { id: 'patch-notes', label: '패치 노트' },
    { id: 'making', label: '롬 분석 노트' },
  ]}
  theme={patch.theme}
  image={{ src: `${base}/images/title.webp`, alt: '드래곤볼 Z 초오공전 각성편 한글판 타이틀 화면' }}
  copyright={[patch.copyright]}
>
  <section class="hero page-width" aria-labelledby="title">
    <div class="hero-copy">
      <p class="label">{releaseLabel(patch)}</p>
      <h1 id="title" class="pixel">
        {patch.title} 한글판
      </h1>
      <PatchBox ips={downloads(patch).ips} spec={patch.spec} version={patch.version} output={patch.stem} />
      <ManualPatch patch={patch}>
        <p>세이브 구조는 바꾸지 않아 v1.2·v1.1 세이브 파일을 그대로 이어서 쓸 수 있습니다.</p>
      </ManualPatch>
    </div>
    <figure class="hero-shot screen">
      <img
        src={`${base}/images/title.webp`}
        width="256"
        height="224"
        alt="'초오공전 각성편' 한글 로고와 오공·오반이 있는 타이틀 화면"
        fetchpriority="high"
      />
    </figure>
  </section>

  <section id="changes" class="section page-width" aria-labelledby="changes-title">
    <h2 id="changes-title" class="pixel">
      한국어로 바뀐 것
    </h2>
    <p>
      천하제일 무술대회부터 프리더와의 결전까지, 대사와 선택지를 한국어로 읽습니다. 타이틀·메뉴·전투 화면과 DBZ 퀴즈도
      한국어로 즐길 수 있습니다.
    </p>
    <ul class="checklist frame">
      <li>이야기 대사와 선택지</li>
      <li>타이틀 화면과 메뉴</li>
      <li>전투 대사와 캐릭터별 말투</li>
      <li>DBZ 퀴즈와 신룡의 소원</li>
    </ul>
  </section>

  <section id="story" class="section page-width" aria-labelledby="story-title">
    <h2 id="story-title" class="pixel">
      이야기
    </h2>
    <div class="story">
      <div class="story-copy">
        <p class="lead">
          피콜로 대마왕을 쓰러뜨리고 3년, 제23회 천하제일 무술대회 결승에서 오공은 마주니어와 맞붙습니다. 그로부터 5년
          뒤 오공의 형이라는 사이어인 라데츠가 지구에 나타납니다.
        </p>
        <p>
          지구로 오는 베지터와 내퍼에 맞서 1년을 수련하고, 드래곤볼을 찾아 나메크성으로 건너가 프리더와의 결전 끝에
          초사이어인으로 각성하기까지, 원작 만화 《드래곤볼》의 어른이 된 오공의 이야기를 따라갑니다.
        </p>
        <p>
          반다이가 1995년 9월 22일에 낸 슈퍼 패미컴 게임으로, 개발은 TOSE가 맡았습니다. 같은 해 3월에 나온{' '}
          <a href="/games/kr-patches/sfc/dragon-ball-z-super-gokuden-totsugeki/">초오공전 돌격편</a>의 뒤를 잇습니다.
        </p>
      </div>
      <div class="story-shots">
        <figure class="screen">
          <img
            src={`${base}/images/scenes/vegeta.webp`}
            width="256"
            height="224"
            alt="대원숭이로 변신해 모두 파괴해 주겠다고 외치는 베지터"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="screen">
          <img
            src={`${base}/images/scenes/frieza-ship.webp`}
            width="256"
            height="224"
            alt="프리더의 우주선에서 베지터를 찾는 도도리아와 프리더 일당"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <section id="cast" class="section page-width" aria-labelledby="cast-title">
    <h2 id="cast-title" class="pixel">
      등장인물
    </h2>
    <div class="cast-groups">
      {castGroups.map(group => (
        <ul class="cast-list" aria-label={group.label}>
          {group.members.map(member => (
            <li class="member frame">
              <img
                class="portrait"
                src={`${base}/images/cast/${member.id}.webp`}
                width="38"
                height="48"
                alt=""
                loading="lazy"
                decoding="async"
              />
              <div>
                <h3 class="pixel">{member.name}</h3>
                <p class="label">{member.role}</p>
                <p>{member.text}</p>
              </div>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </section>

  <section id="play" class="section page-width" aria-labelledby="play-title">
    <h2 id="play-title" class="pixel">
      진행 방식
    </h2>
    <div class="play-list">
      {play.map(item => (
        <article class="play frame">
          <figure class="screen">
            <img
              src={`${base}/images/scenes/${item.image}.webp`}
              width="256"
              height="224"
              alt={item.alt}
              loading="lazy"
              decoding="async"
            />
          </figure>
          <h3 class="pixel">{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <BattleSystem />
  <Endings />

  <section id="patch-notes" class="section page-width" aria-labelledby="patch-notes-title">
    <h2 id="patch-notes-title" class="pixel">
      패치 노트
    </h2>
    <article class="patch-release" aria-labelledby="release-1-3">
      <h3 id="release-1-3" class="pixel">
        v1.3 · 최신 버전
      </h3>
      <p class="section-note">
        <time datetime="2026-10-22">2026년 10월 22일</time>
      </p>
      <p class="release-overview">
        나레이션 줄바꿈을 바로잡고, 전투 말풍선을 원문과 다시 대조하고, 돌격편 암호가 이어지도록 고쳤습니다.
      </p>
      <ReleaseDetails>
        <ul>
          <li>나레이션 대사 8개에서 마지막 글자가 혼자 다음 줄로 떨어지던 문제를 고쳤습니다.</li>
          <li>전투 말풍선 문자열 443개(대사 ID 719개)를 원문에 맞게 고쳤습니다.</li>
          <li>말풍선 밖으로 넘치던 줄을 창 크기에 맞게 나눴습니다.</li>
          <li>돌격편 엔딩의 암호 「손오공은사이어인」을 입력하면 돌격편을 마친 상태로 시작합니다.</li>
          <li>돌격편 한글판의 50자 암호도 화면에 보이는 글자 그대로 입력하면 이어지도록 고쳤습니다.</li>
          <li>
            돌격편 이름을 각성편 글자로 옮기는 표가 37번째 글자부터 밀려 있어 이름이 다른 글자로 바뀌던 문제를
            고쳤습니다. v1.2는 데이터 암호를 키로 칠 수 없어서(256가지 바이트 값 중 11가지만 입력 가능), 비교 화면의
            v1.2 쪽은 같은 암호를 메모리에 직접 써 넣고 찍었습니다.
          </li>
          <li>새 게임의 이름 입력 화면도 암호 화면과 같은 글자 판을 써서 글자 배치가 바뀌었습니다.</li>
          <li>v1.2·v1.1 세이브 파일을 그대로 사용할 수 있습니다.</li>
        </ul>
        <p class="section-note">같은 장면을 같은 입력으로 찍어 v1.2와 v1.3을 나란히 놓았습니다.</p>
        {kakuseiV13Groups.map(group => (
          <CompareGroup group={group} base={base} versions={kakuseiV13Versions} visible={group.pairs.length} />
        ))}
      </ReleaseDetails>
    </article>
    <article class="patch-release" aria-labelledby="release-1-2">
      <h3 id="release-1-2" class="pixel">
        v1.2
      </h3>
      <p class="section-note">
        <time datetime="2026-10-18">2026년 10월 18일</time>
      </p>
      <p class="release-overview">대사와 타이틀을 다듬고, 우주선 장면의 진행 오류를 고쳤습니다.</p>
      <ReleaseDetails>
        <ul>
          <li>대사 782줄을 수정하고 누락된 대사를 복구했습니다.</li>
          <li>캐릭터 말투·이름·맞춤법·줄바꿈을 다듬었습니다.</li>
          <li>타이틀 화면을 한국어로 옮겼습니다.</li>
          <li>폰트에 없던 글자 11자(깨·롭 등)를 추가했습니다.</li>
          <li>베지터·부르마의 우주선 장면에서 진행이 막히던 문제를 수정했습니다.</li>
          <li>v1.1 세이브 파일을 그대로 사용할 수 있습니다.</li>
        </ul>
        <p class="section-note">같은 장면을 같은 입력으로 찍어 v1.1과 v1.2를 나란히 놓았습니다.</p>
        {releaseGroups.map(group => (
          <CompareGroup group={group} base={base} versions={kakuseiVersions} visible={group.pairs.length} />
        ))}
      </ReleaseDetails>
    </article>
    <article class="patch-release" aria-labelledby="release-1-1">
      <h3 id="release-1-1" class="pixel">
        v1.1
      </h3>
      <p class="section-note">
        <time datetime="2016-01-04">2016년 1월 4일</time>
      </p>
      <p class="release-overview">DBZ 퀴즈 일부의 난이도를 조정했습니다.</p>
      <ReleaseDetails>
        <ul>
          <li>DBZ 퀴즈 일부의 난이도를 조정했습니다.</li>
        </ul>
        <ReleaseScreenshot
          src={`${base}/images/releases/v1-1/quiz-choices.webp`}
          width={256}
          height={239}
          alt="나메크성에서 세 가지 답을 고르는 DBZ 퀴즈 화면"
          caption="v1.1 공개 글에 실린 DBZ 퀴즈 선택지"
        />

        <ReleaseScreenshot
          src={`${base}/images/releases/v1-1/preliminary-choices.webp`}
          width={256}
          height={239}
          alt="예선 회장에서 두 가지 대답 중 하나를 고르는 화면"
          caption="v1.1 공개 글에 실린 예선 회장 선택지"
        />
      </ReleaseDetails>
    </article>
    <article class="patch-release" aria-labelledby="release-1-0">
      <h3 id="release-1-0" class="pixel">
        v1.0
      </h3>
      <p class="section-note">
        <time datetime="2011-12-30">2011년 12월 30일</time>
      </p>
      <p class="release-overview">드래곤볼 Z 초오공전 각성편의 첫 한글판입니다.</p>
      <ReleaseDetails>
        <ul>
          <li>최초 한글패치입니다.</li>
        </ul>

        <ReleaseScreenshot
          src={`${base}/images/releases/v1-0/piccolo-dialogue.webp`}
          width={256}
          height={239}
          alt="피콜로의 전투 대사 화면"
          caption="v1.0의 피콜로 전투 대사"
        />

        <ReleaseScreenshot
          src={`${base}/images/releases/v1-0/training-choices.webp`}
          width={256}
          height={239}
          alt="계왕성에서 전투력과 체력 중 고르는 선택지"
          caption="v1.0의 계왕성 수련 선택지"
        />
      </ReleaseDetails>
    </article>
  </section>

  <MakingOf patch={patch} />

  <p class="back-to-top page-width">
    <a class="pointer" href="#title">
      한글패치 하러 가기
    </a>
  </p>
</PatchBook>
