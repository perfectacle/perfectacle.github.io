---
import ReleaseScreenshot from '../../../../components/kr-patch/ReleaseScreenshot.astro';
import ReleaseDetails from '../../../../components/kr-patch/ReleaseDetails.astro';
import CompareGroup from '../../../../components/kr-patch/CompareGroup.astro';
import ManualPatch from '../../../../components/kr-patch/ManualPatch.astro';
import PatchBox from '../../../../components/kr-patch/PatchBox.astro';
import MakingOf from '../../../../components/totsugeki/MakingOf.astro';
import PatchBook from '../../../../layouts/PatchBook.astro';
import { TOTSUGEKI_PATCH, downloads, releaseLabel, trail } from '../../../../lib/kr-patches';
import { totsugekiGroups, totsugekiVersions } from '../../../../lib/totsugeki-showcase';

const patch = TOTSUGEKI_PATCH;
const base = patch.path;
const releaseGroups = [
  ...totsugekiGroups.filter(group => group.id === 'names'),
  ...totsugekiGroups.filter(group => group.id !== 'names'),
].map(group => ({
  ...group,
  pairs: group.pairs.filter(pair =>
    [
      'restore_goku_fish',
      'tone_goku',
      'joke_tao',
      'title',
      'ui_title_menu',
      'layout_wrap_1',
      'bugfix_event_list',
    ].includes(pair.id),
  ),
}));

const play = [
  {
    image: 'map',
    alt: '숲과 강이 펼쳐진 지도',
    title: '지도',
    text: '장소를 옮겨 가며 원작의 장면이 이어집니다. 드래곤볼을 찾을 때는 X 버튼으로 레이더를 보며 직접 돌아다닙니다.',
  },
  {
    image: 'choice',
    alt: '오른쪽·가운데·왼쪽 중 겨냥할 곳을 고르는 선택지',
    title: '선택지',
    text: '대사 사이사이에 오공이 할 일을 고릅니다. 고른 것에 따라 뒤에 이어지는 장면이 달라집니다.',
  },
  {
    image: 'battle',
    alt: '프테라노돈이 발톱 공격을 쓰는 순간의 전투 화면',
    title: '전투',
    text: '상대가 기술을 쓰면 화면 위에 기술 이름이 뜹니다. 그 순간 맞는 버튼을 눌러 받아칩니다. 기술을 쓸수록 전투력이 줄어듭니다.',
  },
  {
    image: 'event-list',
    alt: '198번부터 203번까지 보이는 이벤트 표',
    title: '이벤트 표',
    text: '본 장면은 이벤트 표에 하나씩 채워집니다. 모두 204개입니다.',
  },
];

const cast = [
  {
    id: 'goku',
    name: '손오공',
    role: '여의봉 · 근두운 · 에네르기파',
    text: '산속에서 할아버지의 유품인 사성구를 지키며 사는 꼬리 달린 소년. 부르마를 만나 처음으로 산을 나섭니다.',
  },
  {
    id: 'bulma',
    name: '부르마',
    role: '드래곤 레이더',
    text: '캡슐 코퍼레이션의 딸. 직접 만든 드래곤 레이더를 들고 드래곤볼을 찾아다닙니다.',
  },
  {
    id: 'roshi',
    name: '무천도사',
    role: '에네르기파',
    text: '거북선인이라고도 불리는 무술의 달인. 오공과 크리링을 제자로 받아 수행시킵니다.',
  },
  {
    id: 'tao',
    name: '타오파이파이',
    role: '도돈파',
    text: '레드 리본군이 고용한 세계 최고의 킬러. 학선인의 동생입니다.',
  },
  {
    id: 'tien',
    name: '천진반',
    role: '기공포',
    text: '학선인의 제자. 천하제일 무술대회에서 오공과 맞붙은 뒤 동료가 됩니다.',
  },
  {
    id: 'piccolo-daimao',
    name: '피콜로 대마왕',
    role: '세계를 위협하는 마왕',
    text: '드래곤볼로 젊음을 되찾고 세계를 지배하려는 마왕. 오공이 맞서 싸웁니다.',
  },
];
---

<PatchBook
  title={`${patch.title} 한글판`}
  trail={trail(patch)}
  description={`${patch.year}년 슈퍼 패미컴 ${patch.title} 한글패치 v${patch.version}. 일본판 롬파일을 고르면 이 페이지에서 바로 한글판을 만듭니다.`}
  sections={[
    { id: 'changes', label: '한국어로 바뀐 것' },
    { id: 'story', label: '이야기' },
    { id: 'cast', label: '등장인물' },
    { id: 'play', label: '진행 방식' },
    { id: 'patch-notes', label: '패치 노트' },
    { id: 'making', label: '롬 분석 노트' },
  ]}
  theme={patch.theme}
  image={{ src: `${base}/images/title.webp`, alt: '드래곤볼 Z 초오공전 돌격편 한글판 타이틀 화면' }}
  copyright={[patch.copyright]}
>
  <section class="hero page-width" aria-labelledby="title">
    <div class="hero-copy">
      <p class="label">{releaseLabel(patch)}</p>
      <h1 id="title" class="pixel">
        {patch.title} 한글판
      </h1>
      <PatchBox ips={downloads(patch).ips} spec={patch.spec} version={patch.version} output={patch.stem} />
      <ManualPatch patch={patch}>
        <p>세이브 구조는 바꾸지 않아 v1.0 세이브 파일을 그대로 이어서 쓸 수 있습니다.</p>
      </ManualPatch>
    </div>
    <figure class="hero-shot screen">
      <img
        src={`${base}/images/title.webp`}
        width="256"
        height="224"
        alt="'초오공전 돌격편' 한글 로고와 여의봉을 든 오공이 있는 타이틀 화면"
        fetchpriority="high"
      />
    </figure>
  </section>

  <section id="changes" class="section page-width" aria-labelledby="changes-title">
    <h2 id="changes-title" class="pixel">
      한국어로 바뀐 것
    </h2>
    <p>
      소년 오공의 모험을 대사와 선택지부터 타이틀·메뉴까지 한국어로 즐길 수 있습니다. 전투 대사와 적 이름도 한국어로
      표시합니다.
    </p>
    <ul class="checklist frame">
      <li>이야기 대사와 선택지</li>
      <li>타이틀 화면과 메뉴</li>
      <li>전투 대사·기술 이름·적 이름</li>
      <li>이벤트 표와 캐릭터별 말투</li>
    </ul>
  </section>

  <section id="story" class="section page-width" aria-labelledby="story-title">
    <h2 id="story-title" class="pixel">
      이야기
    </h2>
    <div class="story">
      <div class="story-copy">
        <p class="lead">
          산속에서 할아버지의 유품인 사성구를 지키며 사는 꼬리 달린 소년 오공. 어느 날 드래곤볼을 찾아 나선 부르마를
          만나 함께 모험을 떠납니다.
        </p>
        <p>
          드래곤볼을 노리는 피라후 일당과 레드 리본군, 무천도사 밑에서의 수행과 천하제일 무술대회를 거쳐 피콜로
          대마왕과의 결전까지, 원작 만화 《드래곤볼》의 소년 오공 시절을 따라갑니다.
        </p>
        <p>
          반다이가 1995년 3월 24일에 낸 슈퍼 패미컴 게임으로, 개발은 TOSE가 맡았습니다. 같은 해 9월에 나온{' '}
          <a href="/games/kr-patches/sfc/dragon-ball-z-super-gokuden-kakusei/">초오공전 각성편</a>이 그 뒤 이야기를
          다룹니다.
        </p>
      </div>
      <div class="story-shots">
        <figure class="screen">
          <img
            src={`${base}/images/scenes/bulma.webp`}
            width="256"
            height="224"
            alt="총을 맞고도 멀쩡한 오공에게 놀라는 부르마"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="screen">
          <img
            src={`${base}/images/scenes/dragon-balls.webp`}
            width="256"
            height="224"
            alt="드래곤볼 7개를 모으면 굉장한 일이 생긴다고 설명하는 부르마"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <section id="cast" class="section page-width" aria-labelledby="cast-title">
    <h2 id="cast-title" class="pixel">
      등장인물
    </h2>
    <ul class="cast-list">
      {cast.map(member => (
        <li class="member frame">
          <img
            class="portrait"
            src={`${base}/images/cast/${member.id}.webp`}
            width="38"
            height="48"
            alt=""
            loading="lazy"
            decoding="async"
          />
          <div>
            <h3 class="pixel">{member.name}</h3>
            <p class="label">{member.role}</p>
            <p>{member.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section id="play" class="section page-width" aria-labelledby="play-title">
    <h2 id="play-title" class="pixel">
      진행 방식
    </h2>
    <div class="play-list">
      {play.map(item => (
        <article class="play frame">
          <figure class="screen">
            <img
              src={`${base}/images/scenes/${item.image}.webp`}
              width="256"
              height="224"
              alt={item.alt}
              loading="lazy"
              decoding="async"
            />
          </figure>
          <h3 class="pixel">{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="patch-notes" class="section page-width" aria-labelledby="patch-notes-title">
    <h2 id="patch-notes-title" class="pixel">
      패치 노트
    </h2>
    <article class="patch-release" aria-labelledby="release-1-1">
      <h3 id="release-1-1" class="pixel">
        v1.1 · 최신 버전
      </h3>
      <p class="section-note">
        <time datetime="2026-10-18">2026년 10월 18일</time>
      </p>
      <p class="release-overview">대사를 원문과 대조하고, 타이틀·메뉴와 진행 오류를 고쳤습니다.</p>
      <ReleaseDetails>
        <ul>
          <li>대사 5,370줄을 일본어 원문과 대조해 4,483줄을 수정했습니다.</li>
          <li>타이틀 화면과 메뉴를 한국어로 옮겼습니다.</li>
          <li>캐릭터 말투·고유명사·맞춤법·줄바꿈을 다듬었습니다.</li>
          <li>폰트에 없던 글자 213자(꽃·쫓·흙 등)를 추가했습니다.</li>
          <li>이벤트 표 203번 부근에서 화면을 닫지 못하던 문제를 수정했습니다.</li>
          <li>v1.0 세이브 파일을 그대로 사용할 수 있습니다.</li>
        </ul>
        <p class="section-note">같은 장면을 같은 입력으로 찍어 v1.0과 v1.1을 나란히 놓았습니다.</p>
        {releaseGroups.map(group => (
          <CompareGroup group={group} base={base} versions={totsugekiVersions} visible={group.pairs.length} />
        ))}
      </ReleaseDetails>
    </article>
    <article class="patch-release" aria-labelledby="release-1-0">
      <h3 id="release-1-0" class="pixel">
        v1.0
      </h3>
      <p class="section-note">
        <time datetime="2012-12-12">2012년 12월 12일</time>
      </p>
      <p class="release-overview">드래곤볼 Z 초오공전 돌격편의 첫 한글판입니다.</p>
      <ReleaseDetails>
        <ul>
          <li>최초 한글패치입니다.</li>
        </ul>

        <ReleaseScreenshot
          src={`${base}/images/patch/title_v10_1.webp`}
          width={256}
          height={224}
          alt="드래곤볼 Z 초오공전 돌격편 v1.0 타이틀 화면"
          caption="v1.0 타이틀 화면"
        />

        <ReleaseScreenshot
          src={`${base}/images/patch/restore_goku_fish_v10_1.webp`}
          width={256}
          height={224}
          alt="드래곤볼 Z 초오공전 돌격편 v1.0에서 물고기를 잡으려는 오공"
          caption="v1.0의 오공 대사"
        />
      </ReleaseDetails>
    </article>
  </section>

  <MakingOf patch={patch} />

  <p class="back-to-top page-width">
    <a class="pointer" href="#title">
      한글패치 하러 가기
    </a>
  </p>
</PatchBook>
