---
import { SECTION_TITLES, sectionsOf } from '../../../../lib/patch-sections';
import PatchRelease from '../../../../components/kr-patch/PatchRelease.astro';
import ZoomImage from '../../../../components/kr-patch/ZoomImage.astro';
import ReleaseScreenshot from '../../../../components/kr-patch/ReleaseScreenshot.astro';
import ReleaseDetails from '../../../../components/kr-patch/ReleaseDetails.astro';
import ReleaseItem from '../../../../components/kr-patch/ReleaseItem.astro';
import ReleasePairs from '../../../../components/kr-patch/ReleasePairs.astro';
import ManualPatch from '../../../../components/kr-patch/ManualPatch.astro';
import SaveNote from '../../../../components/kr-patch/SaveNote.astro';
import PatchBox from '../../../../components/kr-patch/PatchBox.astro';
import BattleSystem from '../../../../components/totsugeki/BattleSystem.astro';
import TrainingScenes from '../../../../components/totsugeki/TrainingScenes.astro';
import MakingOf from '../../../../components/totsugeki/MakingOf.astro';
import PatchBook from '../../../../layouts/PatchBook.astro';
import { TOTSUGEKI_PATCH, downloads, releaseLabel, trail } from '../../../../lib/kr-patches';
import { totsugekiGroups, totsugekiVersions } from '../../../../lib/totsugeki-showcase';

const patch = TOTSUGEKI_PATCH;
const base = patch.path;
const releaseGroups = [
  ...totsugekiGroups.filter(group => group.id === 'names'),
  ...totsugekiGroups.filter(group => group.id !== 'names'),
].map(group => ({
  ...group,
  pairs: group.pairs.filter(pair =>
    [
      'restore_goku_fish',
      'tone_goku',
      'joke_tao',
      'title',
      'ui_title_menu',
      'layout_wrap_1',
      'bugfix_event_list',
    ].includes(pair.id),
  ),
}));

const play = [
  {
    image: 'map',
    alt: '숲과 강이 펼쳐진 지도',
    title: '지도',
    text: '장소를 옮겨 가며 원작의 장면이 이어집니다. 드래곤볼을 찾을 때는 X 버튼으로 레이더를 보며 직접 돌아다닙니다.',
  },
  {
    image: 'choice',
    alt: '오른쪽·가운데·왼쪽 중 겨냥할 곳을 고르는 선택지',
    title: '선택지',
    text: '대사 사이사이에 오공이 할 일을 고릅니다. 고른 것에 따라 뒤에 이어지는 장면이 달라집니다.',
  },
  {
    image: 'battle',
    alt: '프테라노돈이 발톱 공격을 쓰는 순간의 전투 화면',
    title: '전투',
    text: '오공이 빛나면 공격하고, 상대가 빛나면 화면 위에 뜬 기술 이름을 보고 막습니다. 자세한 조작은 아래 전투 시스템에서 설명합니다.',
  },
  {
    image: 'event-list',
    alt: '198번부터 203번까지 보이는 이벤트 표',
    title: '이벤트 표',
    text: '본 장면은 이벤트 표에 하나씩 채워집니다. 모두 204개입니다.',
  },
];

const castGroups = [
  {
    label: '주인공과 동료',
    members: [
      {
        id: 'goku',
        name: '손오공',
        role: '여의봉 · 근두운 · 에네르기파',
        text: '산속에서 할아버지의 유품인 사성구를 지키며 사는 꼬리 달린 소년. 부르마를 만나 처음으로 산을 나섭니다.',
      },
      {
        id: 'bulma',
        name: '부르마',
        role: '드래곤 레이더',
        text: '캡슐 코퍼레이션의 딸. 직접 만든 드래곤 레이더를 들고 드래곤볼을 찾아다닙니다.',
      },
      {
        id: 'roshi',
        name: '무천도사',
        role: '에네르기파',
        text: '무술의 달인. 오공과 크리링을 제자로 받아 우유 배달과 밭일, 공사 알바로 수련시킵니다.',
      },
      {
        id: 'krillin',
        name: '크리링',
        role: '오공의 동문',
        text: '동쪽 마을의 절에서 8년을 수련하고 무천도사를 찾아온 소년. 오공과 함께 수련하고 무술대회에 나갑니다.',
      },
      {
        id: 'yamcha',
        name: '야무치',
        role: '낭아풍풍권',
        text: '황야를 근거지로 삼던 도적. 여자 앞에서는 얼어붙고 맙니다. 뒤에는 천하제일 무술대회에도 나섭니다.',
      },
      {
        id: 'tien',
        name: '천진반',
        role: '기공포',
        text: '학선인의 제자. 제22회 천하제일 무술대회 결승에서 오공을 꺾고 우승한 뒤 학선인을 등집니다.',
      },
    ],
  },
  {
    label: '주요 적',
    members: [
      {
        id: 'pilaf',
        name: '피라후',
        role: '세계 정복을 노리는 대왕',
        text: '슈와 마이를 거느리고 드래곤볼을 모아 세계를 손에 넣으려 합니다.',
      },
      {
        id: 'red',
        name: '레드 총수',
        role: '레드 리본군',
        text: '드래곤볼을 노리는 레드 리본군의 우두머리. 오공을 발견하는 즉시 죽이라고 명령합니다.',
      },
      {
        id: 'tao',
        name: '타오파이파이',
        role: '도돈파',
        text: '레드 리본군이 고용한 세계 최고의 킬러. 학선인의 동생입니다.',
      },
      {
        id: 'piccolo-daimao',
        name: '피콜로 대마왕',
        role: '세계를 위협하는 마왕',
        text: '드래곤볼로 젊음을 되찾고 세계를 지배하려는 마왕. 오공이 맞서 싸웁니다.',
      },
    ],
  },
];

// The story in the order of the game's own event list, ending where the sequel picks up.
const arcs = [
  {
    image: 'story-pilaf',
    alt: '피라후 성 안에서 일곱 번째 구슬도 제 발로 오는군이라고 말하는 피라후와 슈·마이',
    title: '부르마와 드래곤볼 찾기',
    text: '뒷강에서 물고기를 잡던 오공이 부르마를 만나 드래곤볼을 찾아 나섭니다. 오룡·야무치·우마왕과 치치를 만나고, 피라후 성에 숨어든 밤 보름달을 보고 거대 원숭이가 됩니다.',
  },
  {
    image: 'story-tournament',
    alt: '여기가 천하제일 무술대회장이다라고 말하는 무천도사',
    title: '수련과 제21회 무술대회',
    text: '크리링과 함께 무천도사의 제자가 되어 우유 배달과 밭일, 공사 알바로 수련합니다. 첫 천하제일 무술대회 결승에서 잭키 춘과 맞붙습니다.',
  },
  {
    image: 'story-red-ribbon',
    alt: '레드 리본군 사령실에서 화이트 장군이 보낸 영상으로 적을 파악했다고 보고하는 장면',
    title: '레드 리본군',
    text: '할아버지의 유품인 사성구를 찾아 나선 오공 앞에 레드 리본군이 나타납니다. 머슬 타워와 블루 장군, 카린 탑을 거쳐 타오파이파이를 꺾고 본부로 쳐들어갑니다.',
  },
  {
    image: 'story-piccolo',
    alt: '피라후의 비행선에서 돌아왔느냐 탬버린이라고 말하는 피콜로 대마왕',
    title: '제22회 무술대회와 피콜로 대마왕',
    text: '제22회 대회 결승에서 천진반과 싸운 뒤 크리링이 쓰러지고 피콜로 대마왕이 나타납니다. 초신수를 마신 오공은 피콜로 킹 캐슬에서 결전을 벌입니다.',
  },
  {
    image: 'story-ending-popo',
    alt: '천계에서 미스터 포포가 너 인간인데 용케 피콜로 대마왕 쓰러뜨렸다고 말하는 장면',
    title: '천계에서 3년',
    text: '피콜로 대마왕을 쓰러뜨린 오공은 천계에 올라 미스터 포포와 신님을 만나 신룡을 되살리고 3년 수련을 시작합니다. 이야기는 2편 각성편의 제23회 천하제일 무술대회로 이어집니다.',
  },
];
---

<PatchBook
  title={`${patch.title} 한글판`}
  trail={trail(patch)}
  description={`${patch.year}년 슈퍼 패미컴 ${patch.title} 한글패치 v${patch.version}. 일본판 롬파일을 고르면 이 페이지에서 바로 한글판을 만듭니다.`}
  sections={sectionsOf(['changes', 'story', 'cast', 'play', 'battle-system', 'scenes', 'patch-notes', 'making'])}
  theme={patch.theme}
  image={{ src: `${base}/images/title.webp`, alt: '드래곤볼 Z 초오공전 돌격편 한글판 타이틀 화면' }}
  copyright={[patch.copyright]}
>
  <section class="hero page-width" aria-labelledby="title">
    <div class="hero-copy">
      <p class="label">{releaseLabel(patch)}</p>
      <h1 id="title" class="pixel">
        {patch.title} 한글판
      </h1>
      <PatchBox ips={downloads(patch).ips} spec={patch.spec} version={patch.version} output={patch.stem}>
        <ManualPatch patch={patch} />
        <SaveNote />
      </PatchBox>
    </div>
    <figure class="hero-shot screen">
      <ZoomImage
        src={`${base}/images/title.webp`}
        width="256"
        height="224"
        alt="'초오공전 돌격편' 한글 로고와 여의봉을 든 오공이 있는 타이틀 화면"
        fetchpriority="high"
      />
    </figure>
  </section>

  <section id="changes" class="section page-width" aria-labelledby="changes-title">
    <h2 id="changes-title" class="pixel">
      {SECTION_TITLES.changes}
    </h2>
    <p>
      소년 오공의 모험을 대사와 선택지부터 타이틀·메뉴까지 한국어로 즐길 수 있습니다. 전투 대사와 적 이름도 한국어로
      표시합니다.
    </p>
    <ul class="checklist frame">
      <li>이야기 대사와 선택지</li>
      <li>타이틀 화면과 메뉴</li>
      <li>전투 대사·기술 이름·적 이름</li>
      <li>이벤트 표와 캐릭터별 말투</li>
    </ul>
  </section>

  <section id="story" class="section page-width" aria-labelledby="story-title">
    <h2 id="story-title" class="pixel">
      {SECTION_TITLES.story}
    </h2>
    <div class="story">
      <div class="story-copy">
        <p class="lead">
          산속에서 할아버지의 유품인 사성구를 지키며 사는 꼬리 달린 소년 오공. 어느 날 드래곤볼을 찾아 나선 부르마를
          만나 함께 모험을 떠납니다.
        </p>
        <p>
          드래곤볼을 노리는 피라후 일당과 레드 리본군, 무천도사 밑에서의 수행과 천하제일 무술대회를 거쳐 피콜로
          대마왕과의 결전까지, 원작 만화 《드래곤볼》의 소년 오공 시절을 따라갑니다.
        </p>
        <p>
          반다이가 1995년 3월 24일에 낸 슈퍼 패미컴 게임으로, 개발은 TOSE가 맡았습니다. 초오공전 시리즈의 1편이고, 같은
          해 9월에 나온 2편 <a href="/games/kr-patches/sfc/dragon-ball-z-super-gokuden-kakusei/">초오공전 각성편</a>이
          그 뒤 이야기를 다룹니다.
        </p>
      </div>
      <div class="story-shots">
        <figure class="screen">
          <ZoomImage
            src={`${base}/images/scenes/bulma.webp`}
            width="256"
            height="224"
            alt="총을 맞고도 멀쩡한 오공에게 놀라는 부르마"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="screen">
          <ZoomImage
            src={`${base}/images/scenes/dragon-balls.webp`}
            width="256"
            height="224"
            alt="드래곤볼 7개를 모으면 굉장한 일이 생긴다고 설명하는 부르마"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
    <h3 class="pixel story-arcs-title">이야기의 흐름</h3>
    <ol class="play-list story-arcs">
      {arcs.map(arc => (
        <li class="play frame">
          <figure class="screen">
            <ZoomImage
              src={`${base}/images/scenes/${arc.image}.webp`}
              width="256"
              height="224"
              alt={arc.alt}
              loading="lazy"
              decoding="async"
            />
          </figure>
          <h4 class="pixel">{arc.title}</h4>
          <p>{arc.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="cast" class="section page-width" aria-labelledby="cast-title">
    <h2 id="cast-title" class="pixel">
      {SECTION_TITLES.cast}
    </h2>
    <div class="cast-groups">
      {castGroups.map(group => (
        <ul class="cast-list" aria-label={group.label}>
          {group.members.map(member => (
            <li class="member frame">
              <img
                class="portrait"
                src={`${base}/images/cast/${member.id}.webp`}
                width="38"
                height="48"
                alt=""
                loading="lazy"
                decoding="async"
              />
              <div>
                <h3 class="pixel">{member.name}</h3>
                <p class="label">{member.role}</p>
                <p>{member.text}</p>
              </div>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </section>

  <section id="play" class="section page-width" aria-labelledby="play-title">
    <h2 id="play-title" class="pixel">
      {SECTION_TITLES.play}
    </h2>
    <div class="play-list">
      {play.map(item => (
        <article class="play frame">
          <figure class="screen">
            <ZoomImage
              src={`${base}/images/scenes/${item.image}.webp`}
              width="256"
              height="224"
              alt={item.alt}
              loading="lazy"
              decoding="async"
            />
          </figure>
          <h3 class="pixel">{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <BattleSystem />
  <TrainingScenes />

  <section id="patch-notes" class="section page-width" aria-labelledby="patch-notes-title">
    <h2 id="patch-notes-title" class="pixel">
      {SECTION_TITLES['patch-notes']}
    </h2>
    <PatchRelease patch={patch} version="1.2">
      <p class="release-overview">
        엔딩 암호를 각성편에 그대로 칠 수 있게 바꾸고, 잘못 보이거나 한 칸에 두 글자씩 눌려 있던 글자를 바로잡았습니다.
      </p>
      <ReleaseDetails>
        <ReleaseItem>
          <ul>
            <li>엔딩 암호를 각성편에 그대로 칠 수 있는 「손오공은사이어인」으로 바꿨습니다.</li>
          </ul>
          <ReleaseScreenshot
            panels={[
              {
                label: 'v1.1',
                src: `${base}/images/patch/password_v11_1.webp`,
                alt: 'v1.1 엔딩 화면. 한글 50자로 된 암호와 TO BE CONTINUED',
              },
              {
                label: 'v1.2',
                src: `${base}/images/patch/password_v12_1.webp`,
                alt: 'v1.2 엔딩 화면. 가운데에 손오공은사이어인과 TO BE CONTINUED',
              },
            ]}
            caption="엔딩의 암호. 기록을 담은 50자 암호를 여덟 글자로 바꿨습니다."
          />
        </ReleaseItem>
        <ReleaseItem>
          <ul>
            <li>
              각성편 v1.3의 암호 화면에 이 여덟 글자를 넣으면 통과합니다. 이름은 넘어가지 않고 각성편 기본 이름으로
              시작합니다.
            </li>
          </ul>
          <ReleaseScreenshot
            panels={[
              {
                label: '암호 입력',
                src: `${base}/images/patch/kakusei_phrase_v12_1.webp`,
                alt: '각성편 v1.3 암호 화면에 손오공은사이어인을 넣은 모습',
              },
              {
                label: '통과',
                src: `${base}/images/patch/kakusei_phrase_v12_2.webp`,
                alt: '암호가 통과해 열린 각성편 v1.3 이름 화면. 기본 이름 엑소버드',
              },
            ]}
            caption="각성편 v1.3에 입력하면 이름 화면으로 넘어갑니다."
          />
        </ReleaseItem>
        <ReleaseItem>
          <ul>
            <li>
              작은 글자 다섯 개를 다·동·레·렉·저로 다시 그렸습니다. v1.1에서는 나·등·러·러·지와 똑같거나 거의 같게 보여,
              이 글자로 지은 이름이 다른 이름처럼 보였습니다.
            </li>
          </ul>
          <ReleaseScreenshot
            highlights={[
              [15, 17, 41, 14],
              [63, 57, 41, 14],
            ]}
            panels={[
              {
                label: 'v1.1',
                src: `${base}/images/patch/name_v11_1.webp`,
                alt: 'v1.1 대화창. 이름 다동레렉저가 나등러러지로 보인다',
              },
              {
                label: 'v1.2',
                src: `${base}/images/patch/name_v12_1.webp`,
                alt: 'v1.2 대화창. 이름 다동레렉저가 그대로 보인다',
              },
            ]}
            caption="이름 「다동레렉저」"
          />
        </ReleaseItem>
        <ReleaseItem>
          <ul>
            <li>엔딩 스태프 소개의 「디러터」를 「디렉터」로 고쳤습니다.</li>
          </ul>
          <ReleaseScreenshot
            panels={[
              {
                label: 'v1.1',
                src: `${base}/images/patch/credits_v11_1.webp`,
                alt: 'v1.1 엔딩 스태프 소개. 디러터 신사쿠 시마다',
                highlights: [[119, 89, 15, 13]],
              },
              {
                label: 'v1.2',
