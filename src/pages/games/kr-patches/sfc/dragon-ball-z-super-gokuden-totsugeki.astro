---
import PatchBox from '../../../../components/kr-patch/PatchBox.astro';
import VersionPair from '../../../../components/kr-patch/VersionPair.astro';
import PatchBook from '../../../../layouts/PatchBook.astro';
import { totsugekiGroups, totsugekiVersions } from '../../../../lib/totsugeki-showcase';
import { GOKUDEN_TOTSUGEKI } from '../../../../lib/rom-patch';

const base = '/games/kr-patches/sfc/dragon-ball-z-super-gokuden-totsugeki';
const ips = `${base}/downloads/Dragon_Ball_Z_Super_Gokuden_Totsugeki_Hen_K_v1_1.ips`;
const headeredIps = `${base}/downloads/Dragon_Ball_Z_Super_Gokuden_Totsugeki_Hen_K_v1_1_Headered.ips`;
const VISIBLE_PER_GROUP = 2;

const play = [
  {
    image: 'map',
    alt: '숲과 강이 펼쳐진 지도',
    title: '지도',
    text: '장소를 옮겨 가며 원작의 장면이 이어집니다. 드래곤볼을 찾을 때는 X 버튼으로 레이더를 보며 직접 돌아다닙니다.',
  },
  {
    image: 'choice',
    alt: '오른쪽·가운데·왼쪽 중 겨냥할 곳을 고르는 선택지',
    title: '선택지',
    text: '대사 사이사이에 오공이 할 일을 고릅니다. 고른 것에 따라 뒤에 이어지는 장면이 달라집니다.',
  },
  {
    image: 'battle',
    alt: '프테라노돈이 발톱 공격을 쓰는 순간의 전투 화면',
    title: '전투',
    text: '상대가 기술을 쓰면 화면 위에 기술 이름이 뜹니다. 그 순간 맞는 버튼을 눌러 받아칩니다. 기술을 쓸수록 전투력이 줄어듭니다.',
  },
  {
    image: 'event-list',
    alt: '198번부터 203번까지 보이는 이벤트 표',
    title: '이벤트 표',
    text: '본 장면은 이벤트 표에 하나씩 채워집니다. 모두 204개입니다.',
  },
];

const bytes = (n: number) => `${n.toLocaleString('ko-KR')}바이트`;
---

<PatchBook
  title="드래곤볼 Z 초오공전 돌격편 한글판"
  trail={[
    { name: '한글패치', path: '/games/kr-patches/' },
    { name: '드래곤볼 Z 초오공전 돌격편', path: base + '/' },
  ]}
  description="1995년 슈퍼 패미컴 드래곤볼 Z 초오공전 돌격편 한글패치 v1.1. 일본판 게임 파일을 고르면 이 페이지에서 바로 한글판을 만듭니다."
  theme="gokuden"
  image={{ src: `${base}/images/title.webp`, alt: '드래곤볼 Z 초오공전 돌격편 한글판 타이틀 화면' }}
  copyright={['게임 및 캐릭터 © バードスタジオ/集英社・フジテレビ・東映動画 © BANDAI 1995']}
  links={[]}
>
  <section class="hero page-width" aria-labelledby="title">
    <div class="hero-copy">
      <p class="label">슈퍼 패미컴 · 1995 · 한글패치 v1.1</p>
      <h1 id="title" class="pixel">
        드래곤볼 Z 초오공전 돌격편 한글판
      </h1>
      <p class="lead">
        가지고 있는 일본판 게임 파일을 고르면 바로 한글판으로 바꿔 저장합니다. 따로 프로그램을 설치하지 않아도 됩니다.
      </p>
      <PatchBox ips={ips} spec={GOKUDEN_TOTSUGEKI} output="Dragon_Ball_Z_Super_Gokuden_Totsugeki_Hen_K_v1_1" />
      <details class="manual">
        <summary class="pointer">직접 패치하려면</summary>
        <div class="manual-body">
          <p>
            Floating IPS·Lunar IPS·ROM Patcher JS 같은 도구로 손대지 않은 일본판 원본에 적용하세요. 파일 크기에 맞는
            IPS를 받으세요.
          </p>
          <ul class="downloads">
            <li>
              <a href={ips} download>
                헤더 없는 파일용 IPS
              </a>
              <span>(2MB, {bytes(GOKUDEN_TOTSUGEKI.size)})</span>
            </li>
            <li>
              <a href={headeredIps} download>
                헤더 있는 파일용 IPS
              </a>
              <span>(2MB+512바이트, {bytes(GOKUDEN_TOTSUGEKI.size + 512)})</span>
            </li>
          </ul>
          <table>
            <caption>헤더 없는 파일 기준</caption>
            <thead>
              <tr>
                <th scope="col">구분</th>
                <th scope="col">크기</th>
                <th scope="col">CRC32</th>
                <th scope="col">MD5</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">일본판 원본</th>
                <td>{bytes(GOKUDEN_TOTSUGEKI.size)}</td>
                <td>
                  <code>{GOKUDEN_TOTSUGEKI.original.crc32}</code>
                </td>
                <td>
                  <code>{GOKUDEN_TOTSUGEKI.original.md5}</code>
                </td>
              </tr>
              <tr>
                <th scope="row">한글판 v1.1</th>
                <td>{bytes(GOKUDEN_TOTSUGEKI.size)}</td>
                <td>
                  <code>{GOKUDEN_TOTSUGEKI.patched.crc32}</code>
                </td>
                <td>
                  <code>{GOKUDEN_TOTSUGEKI.patched.md5}</code>
                </td>
              </tr>
            </tbody>
          </table>
          <p>세이브 구조는 바꾸지 않아 v1.0 세이브 파일을 그대로 이어서 쓸 수 있습니다.</p>
        </div>
      </details>
    </div>
    <figure class="hero-shot screen">
      <img
        src={`${base}/images/title.webp`}
        width="256"
        height="224"
        alt="'초오공전 돌격편' 한글 로고와 여의봉을 든 오공이 있는 타이틀 화면"
        fetchpriority="high"
      />
    </figure>
  </section>

  <nav class="toc page-width frame" aria-label="이 페이지 차례">
    <a class="pointer" href="#changes">
      v1.1에서 달라진 것
    </a>
    <a class="pointer" href="#story">
      이야기
    </a>
    <a class="pointer" href="#play">
      진행 방식
    </a>
  </nav>

  <section id="changes" class="section page-width" aria-labelledby="changes-title">
    <h2 id="changes-title" class="pixel">
      v1.1에서 달라진 것
    </h2>
    <p>
      2012년에 낸 v1.0 이후 약 14년 만의 업데이트입니다. 대사 5,370줄을 일본어 원문과 한 줄씩 대조해 4,483줄을
      고쳤습니다.
    </p>
    <ul class="checklist frame">
      <li>타이틀 화면과 메뉴 한글화</li>
      <li>이벤트 표에서 빠져나오지 못하던 버그 수정</li>
      <li>전투 대사·선택지·적 이름까지 다시 검수</li>
      <li>폰트에 없던 글자 213자(꽃·쫓·흙 등) 추가</li>
    </ul>
    <p class="section-note">같은 장면을 같은 입력으로 찍어 v1.0과 v1.1을 나란히 놓았습니다.</p>
    {totsugekiGroups.map(group => (
      <section class="compare-group" aria-labelledby={`group-${group.id}`}>
        <h3 id={`group-${group.id}`} class="pixel">
          {group.title}
        </h3>
        <p>{group.summary}</p>
        <div class="compare-list">
          {group.pairs.slice(0, VISIBLE_PER_GROUP).map(pair => (
            <VersionPair pair={pair} base={base} versions={totsugekiVersions} />
          ))}
        </div>
        {group.pairs.length > VISIBLE_PER_GROUP && (
          <details class="more">
            <summary class="pointer">{group.pairs.length - VISIBLE_PER_GROUP}장면 더 보기</summary>
            <div class="compare-list">
              {group.pairs.slice(VISIBLE_PER_GROUP).map(pair => (
                <VersionPair pair={pair} base={base} versions={totsugekiVersions} />
              ))}
            </div>
          </details>
        )}
      </section>
    ))}
  </section>

  <section id="story" class="section page-width" aria-labelledby="story-title">
    <h2 id="story-title" class="pixel">
      이야기
    </h2>
    <div class="story">
      <div class="story-copy">
        <p class="lead">
          산속에서 할아버지의 유품인 사성구를 지키며 사는 꼬리 달린 소년 오공. 어느 날 드래곤볼을 찾아 나선 부르마를
          만나 함께 모험을 떠납니다.
        </p>
        <p>
          드래곤볼을 노리는 피라후 일당과 레드 리본군, 무천도사 밑에서의 수행과 천하제일 무술대회를 거쳐 피콜로
          대마왕과의 결전까지, 원작 만화 《드래곤볼》의 소년 오공 시절을 따라갑니다.
        </p>
        <p>반다이가 1995년에 낸 슈퍼 패미컴 게임입니다. 같은 해 나온 초오공전 각성편이 그 뒤 이야기를 다룹니다.</p>
      </div>
      <div class="story-shots">
        <figure class="screen">
          <img
            src={`${base}/images/scenes/bulma.webp`}
            width="256"
            height="224"
            alt="총을 맞고도 멀쩡한 오공에게 놀라는 부르마"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="screen">
          <img
            src={`${base}/images/scenes/dragon-balls.webp`}
            width="256"
            height="224"
            alt="드래곤볼 7개를 모으면 굉장한 일이 생긴다고 설명하는 부르마"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <section id="play" class="section page-width" aria-labelledby="play-title">
    <h2 id="play-title" class="pixel">
      진행 방식
    </h2>
    <div class="play-list">
      {play.map(item => (
        <article class="play frame">
          <figure class="screen">
            <img
              src={`${base}/images/scenes/${item.image}.webp`}
              width="256"
              height="224"
              alt={item.alt}
              loading="lazy"
              decoding="async"
            />
          </figure>
          <h3 class="pixel">{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
    <p class="back-to-top">
      <a class="pointer" href="#title">
        한글판 만들러 가기
      </a>
    </p>
  </section>
</PatchBook>
