---
import PatchBook from '../../../../layouts/PatchBook.astro';
import SfcController from '../../../../components/kr-patch/SfcController.astro';
import CartridgeBoot from '../../../../components/kr-patch/CartridgeBoot.astro';
import SfcCartridge from '../../../../components/kr-patch/SfcCartridge.astro';
import SfcCartridgeDefs from '../../../../components/kr-patch/SfcCartridgeDefs.astro';
import { KR_PATCH_LIST_PATH, KR_PATCH_SFC_PATH, KR_PATCHES } from '../../../../lib/kr-patches';
import '../../../../styles/patch-catalogue.css';
---

<PatchBook
  title="슈퍼 패미콤"
  trail={[
    { name: '한글패치', path: KR_PATCH_LIST_PATH },
    { name: '슈퍼 패미콤', path: KR_PATCH_SFC_PATH },
  ]}
  description="슈퍼 패미콤 게임 한글패치 모음. 슈퍼 마리오 RPG, 드래곤볼 Z 초오공전 돌격편·각성편, 제절초. 일본판 롬파일을 고르면 이 사이트에서 바로 한글패치를 적용합니다."
  theme="sfc"
  copyright={[]}
  links={[
    { href: 'https://www.fantasyanime.com/mana/som2maps.htm', label: '성검전설 3 배경 © 1995 SQUARE · FantasyAnime' },
    { href: 'https://spritedatabase.net/file/8203', label: '록맨 X3 스프라이트' },
    { href: 'https://spritedatabase.net/file/7653', label: '동키콩 컨트리 2 스프라이트' },
    { href: 'https://spritedatabase.net/file/31727', label: '스트리트 파이터 II 스프라이트' },
    {
      href: 'https://commons.wikimedia.org/wiki/File:Nintendo-Super-Famicom-Set-FL.png',
      label: '슈퍼 패미콤 사진 Evan-Amos(퍼블릭 도메인)',
    },
  ]}
>
  <div class="catalogue-world">
    <div class="world-rail world-rail-left" aria-hidden="true">
      <div class="world-sprite sprite-mega-man-x"></div>
      <div class="world-sprite sprite-diddy-kong"></div>
    </div>
    <section class="patch-catalogue page-width" aria-labelledby="catalogue-title">
      <div class="console-heading">
        <div class="console-label">
          <a class="console-back" href={KR_PATCH_LIST_PATH}>
            <span aria-hidden="true">←</span> 기종 고르기
          </a>
          <h1 id="catalogue-title">슈퍼 패미콤</h1>
        </div>
        <SfcController />
      </div>
      <SfcCartridgeDefs />
      <ul class="game-catalogue">
        {KR_PATCHES.map((patch, i) => {
          const href = `${patch.path}/`;
          return (
            <li>
              <a class="game-card" href={href}>
                <SfcCartridge
                  label={`/games/kr-patches/catalogue/labels/${patch.theme}.webp`}
                  screen={patch.titleScreen}
                  eager={i === 0}
                />
                <div class="game-card-copy">
                  <p class="game-release">
                    게임 {patch.year} <span aria-hidden="true">·</span> 한글패치 v{patch.version}{' '}
                    <time datetime={patch.released}>({patch.released})</time>
                  </p>
                  <h2>{patch.title}</h2>
                </div>
                <p class="game-copyright">{patch.copyright}</p>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
    <div class="world-rail world-rail-right" aria-hidden="true">
      <div class="world-sprite sprite-ryu"></div>
    </div>
  </div>
  <CartridgeBoot />
</PatchBook>
