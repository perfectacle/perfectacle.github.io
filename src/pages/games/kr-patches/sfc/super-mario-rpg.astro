---
import ComparePair from '../../../../components/smrpg/ComparePair.astro';
import MakingOf from '../../../../components/smrpg/MakingOf.astro';
import PatchBox from '../../../../components/kr-patch/PatchBox.astro';
import Speech from '../../../../components/smrpg/Speech.astro';
import SpeechChain from '../../../../components/smrpg/SpeechChain.astro';
import PatchBook from '../../../../layouts/PatchBook.astro';
import { compareGroups } from '../../../../lib/smrpg-showcase';
import { SMRPG } from '../../../../lib/rom-patch';

const base = '/games/kr-patches/sfc/super-mario-rpg';
const ips = `${base}/downloads/Super_Mario_RPG_K_v1_1.ips`;
const VISIBLE_PER_GROUP = 4;

const play = [
  {
    image: 'moleville',
    alt: '바위 언덕 사이로 두더지 마을을 둘러보는 마리오',
    title: '탐험',
    text: '마리오 님, 이곳은 비스듬히 내려다보는 입체 세계예요. 높은 곳에 올라서거나 숨은 상자를 찾으며 다음 마을로 가 보세요.',
  },
  {
    image: 'battle',
    alt: '마리오가 전투 명령을 고르는 화면',
    title: '전투',
    text: '필드에 보이는 적과 부딪히면 전투가 시작돼요. 버튼마다 명령이 하나씩 붙어 있어요.',
    buttons: [
      { key: 'A', name: '공격' },
      { key: 'X', name: '필살기' },
      { key: 'Y', name: '아이템' },
      { key: 'B', name: '방어' },
    ],
  },
  {
    image: 'specials',
    alt: '마리오와 마로의 필살기 설명이 보이는 메뉴',
    title: '타이밍',
    text: '공격이 닿는 순간 버튼을 누르면 피해가 커지고, 맞는 순간 누르면 피해가 줄어요. 필살기마다 누르는 방법이 다르니 메뉴에서 설명을 읽어 보세요.',
  },
  {
    image: 'shop',
    alt: '아이템 이름과 설명이 보이는 상점 화면',
    title: '성장',
    text: '레벨이 오르면 능력치 하나를 골라 키울 수 있어요. 상점에서 장비와 아이템을 갖추고, 동료를 바꿔 가며 싸워 보세요.',
  },
];

const cast = [
  {
    id: 'mario',
    name: '마리오',
    role: '점프 · 불꽃',
    text: '이번에도 피치 공주를 구하러 나섰다가, 스타 피스를 모으는 모험을 맡게 됩니다.',
    // Mario never speaks in the game; he answers with gestures, which the game narrates.
    line: '‥‥‥ (마리오는 말없이 고개를 끄덕였다)',
  },
  {
    id: 'mallow',
    name: '마로',
    role: '날씨 · 회복',
    text: '자신을 개구리라 믿는 구름 같은 아이. 잘 울지만 날씨를 부리는 힘이 있습니다.',
    speaker: '마로',
    line: '저는 개굴개굴 연못에서 온 개구리 「마로」입니다.',
  },
  {
    id: 'geno',
    name: '지노',
    role: '천공의 사자',
    text: '천공에서 내려와 인형의 몸을 빌린 사자. 스타 로드를 고치려 마리오와 함께합니다.',
    speaker: '지노',
    line: '나는 천공의 사자! 그리고 별을 쫓는 자!!',
  },
  {
    id: 'bowser',
    name: '쿠파',
    role: '힘 · 물리 공격',
    text: '거대한 검에 성을 빼앗긴 라이벌. 성을 되찾으려 이번에는 같은 편이 됩니다.',
    speaker: '쿠파',
    line: '이 몸의 「쿠파 군단」에 너희를 넣어주마! 거절은 사양한다!',
  },
  {
    id: 'peach',
    name: '피치',
    role: '회복 · 지원',
    text: '구해야 할 공주이자, 합류한 뒤에는 회복으로 일행을 지탱하는 동료입니다.',
    speaker: '피치',
    line: '마리오 씨~~! 힘내세요~~!!',
  },
];

// Told by the Chancellor in his own voice from the patch; the last box is game-style narration.
const story = [
  {
    speaker: '버섯 대신',
    text: '마리오 씨, 큰일입니다! 공주님을 구하러 쿠파성에 가셨을 때, 하늘에서 거대한 검이 내리꽂혔지요. 그 바람에 마리오 씨는 성 밖으로 튕겨 나가고 말았습니다.',
  },
  {
    speaker: '버섯 대신',
    text: '검과 함께 나타난 카지오 군단이 소원을 이루어 주는 스타 로드를 부숴 버렸습니다. 흩어진 스타 피스 7개는 세계 곳곳으로 떨어졌다고 합니다.',
  },
  {
    speaker: '버섯 대신',
    text: '스타 피스를 모아 스타 로드를 고치지 않으면 누구의 소원도 이루어지지 않습니다. 마리오 씨, 부탁이네! 서둘러주게!!',
  },
  {
    text: '1996년, 스퀘어가 개발하고 닌텐도가 발매한 슈퍼 패미컴 RPG. 마리오다운 점프와 장난기 위에, 동료를 모으고 성장하는 RPG의 재미를 얹었다.',
  },
];

const bytes = (n: number) => `${n.toLocaleString('ko-KR')}바이트`;
---

<PatchBook
  title="슈퍼 마리오 RPG 한글판"
  trail={[
    { name: '한글패치', path: '/games/kr-patches/' },
    { name: '슈퍼 마리오 RPG', path: base + '/' },
  ]}
  description="1996년 슈퍼 패미컴 슈퍼 마리오 RPG 한글패치 v1.1. 일본판 게임 파일을 고르면 이 페이지에서 바로 한글판을 만듭니다."
>
  <section class="hero page-width" aria-labelledby="title">
    <div class="hero-copy">
      <p class="label">슈퍼 패미컴 · 1996 · 한글패치 v1.1</p>
      <h1 id="title" class="pixel">
        슈퍼 마리오 RPG 한글판
      </h1>
      <Speech speaker="키노피오">
        마리오 님, 가지고 계신 일본판 게임 파일을 고르시면 바로 한글판으로 바꿔 저장해 드려요. 따로 프로그램을 설치하지
        않아도 돼요.
      </Speech>
      <PatchBox ips={ips} spec={SMRPG} output="Super_Mario_RPG_K_v1_1" speaker="키노피오" />
      <details class="manual">
        <summary class="pointer">직접 패치하려면</summary>
        <div class="manual-body">
          <p>
            <a href={ips} download>
              IPS 파일 받기
            </a>
            를 누른 뒤 Floating IPS·Lunar IPS·ROM Patcher JS 같은 도구로 헤더 없는 일본판 원본에 적용하세요. 헤더가 있는
            파일(4MB+512바이트)은 이 페이지의 패치 상자를 쓰면 알아서 처리합니다.
          </p>
          <table class="frame">
            <caption>헤더 없는 파일 기준</caption>
            <thead>
              <tr>
                <th scope="col">구분</th>
                <th scope="col">크기</th>
                <th scope="col">CRC32</th>
                <th scope="col">MD5</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">일본판 원본</th>
                <td>{bytes(SMRPG.size)}</td>
                <td>
                  <code>{SMRPG.original.crc32}</code>
                </td>
                <td>
                  <code>{SMRPG.original.md5}</code>
                </td>
              </tr>
              <tr>
                <th scope="row">한글판 v1.1</th>
                <td>{bytes(SMRPG.size)}</td>
                <td>
                  <code>{SMRPG.patched.crc32}</code>
                </td>
                <td>
                  <code>{SMRPG.patched.md5}</code>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </details>
    </div>
    <figure class="hero-shot screen">
      <img
        src={`${base}/images/patch/geno_sky_ko.webp`}
        width="256"
        height="224"
        alt="한국어 대사로 '나는 천공의 사자!'라고 외치는 지노"
        fetchpriority="high"
      />
    </figure>
  </section>

  <nav class="toc page-width frame" aria-label="이 페이지 차례">
    <a class="pointer" href="#korean">
      한국어로 바뀐 것
    </a>
    <a class="pointer" href="#story">
      이야기
    </a>
    <a class="pointer" href="#play">
      진행 방식
    </a>
    <a class="pointer" href="#cast">
      주인공과 동료
    </a>
    <a class="pointer" href="#making">
      만든 방법
    </a>
  </nav>

  <section id="korean" class="section page-width" aria-labelledby="korean-title">
    <h2 id="korean-title" class="pixel">
      한국어로 바뀐 것
    </h2>
    <ul class="checklist frame">
      <li>모든 대사와 이름</li>
      <li>메뉴·상점·아이템 설명</li>
      <li>전투 명령·적 이름·필살기 설명</li>
      <li>동료마다 다른 원작의 말투</li>
    </ul>
    <Speech speaker="키노피오">같은 장면을 같은 입력으로 찍어서 일본판과 한글판을 나란히 놓았어요.</Speech>
    {compareGroups.map(group => (
      <section class="compare-group" aria-labelledby={`group-${group.id}`}>
        <h3 id={`group-${group.id}`} class="pixel">
          {group.title}
        </h3>
        <Speech speaker="키노피오">{group.summary}</Speech>
        <div class="compare-list">
          {group.pairs.slice(0, VISIBLE_PER_GROUP).map(pair => (
            <ComparePair pair={pair} base={base} />
          ))}
        </div>
        {group.pairs.length > VISIBLE_PER_GROUP && (
          <details class="more">
            <summary class="pointer">{group.pairs.length - VISIBLE_PER_GROUP}장면 더 보기</summary>
            <div class="compare-list">
              {group.pairs.slice(VISIBLE_PER_GROUP).map(pair => (
                <ComparePair pair={pair} base={base} />
              ))}
            </div>
          </details>
        )}
      </section>
    ))}
  </section>

  <section id="story" class="section page-width" aria-labelledby="story-title">
    <h2 id="story-title" class="pixel">
      이야기
    </h2>
    <div class="story">
      <SpeechChain lines={story} />
      <div class="story-shots">
        <figure class="screen">
          <img
            src={`${base}/images/patch/chancellor_kidnap_ko.webp`}
            width="256"
            height="224"
            alt="피치 공주가 또 납치됐다며 놀라는 버섯 대신"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="screen">
          <img
            src={`${base}/images/scenes/castle.webp`}
            width="256"
            height="224"
            alt="공주의 기운을 느끼며 성 안을 걷는 마리오"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <section id="play" class="section page-width" aria-labelledby="play-title">
    <h2 id="play-title" class="pixel">
      진행 방식
    </h2>
    <div class="play-list">
      {play.map(item => (
        <article class="play frame">
          <figure class="screen">
            <img
              src={`${base}/images/scenes/${item.image}.webp`}
              width="256"
              height="224"
              alt={item.alt}
              loading="lazy"
              decoding="async"
            />
          </figure>
          <h3 class="pixel">{item.title}</h3>
          <Speech speaker="키노피오">{item.text}</Speech>
          {item.buttons && (
            <ul class="pad-buttons" aria-label="전투 버튼">
              {item.buttons.map(button => (
                <li>
                  <span class:list={['pad-key', `pad-${button.key.toLowerCase()}`]}>{button.key}</span>
                  {button.name}
                </li>
              ))}
            </ul>
          )}
        </article>
      ))}
    </div>
  </section>

  <section id="cast" class="section page-width" aria-labelledby="cast-title">
    <h2 id="cast-title" class="pixel">
      주인공과 동료
    </h2>
    <ul class="cast-list">
      {cast.map(member => (
        <li class="member frame">
          <img
            class="portrait"
            src={`${base}/images/cast/${member.id}.webp`}
            width="144"
            height="144"
            alt=""
            loading="lazy"
            decoding="async"
          />
          <div>
            <h3 class="pixel">{member.name}</h3>
            <p class="label">{member.role}</p>
            <p>{member.text}</p>
            <Speech speaker={member.speaker}>{member.line}</Speech>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <MakingOf base={base} />

  <p class="back-to-top page-width">
    <a class="pointer" href="#title">
      한글판 만들러 가기
    </a>
  </p>
</PatchBook>
