---
import ZoomImage from '../../../../components/kr-patch/ZoomImage.astro';
import ReleaseDetails from '../../../../components/kr-patch/ReleaseDetails.astro';
import ReleaseItem from '../../../../components/kr-patch/ReleaseItem.astro';
import ReleaseScreenshot from '../../../../components/kr-patch/ReleaseScreenshot.astro';
import CompareGroup from '../../../../components/kr-patch/CompareGroup.astro';
import ManualPatch from '../../../../components/kr-patch/ManualPatch.astro';
import SaveNote from '../../../../components/kr-patch/SaveNote.astro';
import PatchBox from '../../../../components/kr-patch/PatchBox.astro';
import Speech from '../../../../components/kr-patch/Speech.astro';
import MakingOf from '../../../../components/smrpg/MakingOf.astro';
import Secrets from '../../../../components/smrpg/Secrets.astro';
import SpeechChain from '../../../../components/smrpg/SpeechChain.astro';
import PatchBook from '../../../../layouts/PatchBook.astro';
import { SMRPG_PATCH, downloads, releaseLabel, trail } from '../../../../lib/kr-patches';
import { compareGroups } from '../../../../lib/smrpg-showcase';
import { JAPANESE_AND_KOREAN } from '../../../../lib/version-pairs';

const patch = SMRPG_PATCH;
const base = patch.path;
const VISIBLE_PER_GROUP = 4;
const GUIDE = '키노피오';

const play = [
  {
    image: 'moleville',
    alt: '바위 언덕 사이로 두더지 마을을 둘러보는 마리오',
    title: '탐험',
    text: '마리오 님, 이곳은 비스듬히 내려다보는 입체 세계예요. 높은 곳에 올라서거나 숨은 상자를 찾으며 다음 마을로 가 보세요.',
  },
  {
    image: 'battle',
    alt: '마리오가 전투 명령을 고르는 화면',
    title: '전투',
    text: '필드에 보이는 적과 부딪히면 전투가 시작돼요. 버튼마다 명령이 하나씩 붙어 있어요.',
    buttons: [
      { key: 'A', name: '공격' },
      { key: 'X', name: '필살기' },
      { key: 'Y', name: '아이템' },
      { key: 'B', name: '방어' },
    ],
  },
  {
    image: 'specials',
    alt: '마리오와 마로의 필살기 설명이 보이는 메뉴',
    title: '타이밍',
    text: '공격이 닿는 순간 버튼을 누르면 피해가 커지고, 맞는 순간 누르면 피해가 줄어요. 필살기마다 누르는 방법이 다르니 메뉴에서 설명을 읽어 보세요.',
  },
  {
    image: 'shop',
    alt: '아이템 이름과 설명이 보이는 상점 화면',
    title: '성장',
    text: '레벨이 오르면 능력치 하나를 골라 키울 수 있어요. 상점에서 장비와 아이템을 갖추고, 동료를 바꿔 가며 싸워 보세요.',
  },
];

const cast = [
  {
    id: 'mario',
    name: '마리오',
    role: '점프 · 불꽃',
    text: '이번에도 피치 공주를 구하러 나섰다가, 스타 피스를 모으는 모험을 맡게 됩니다.',
    // Mario never speaks in the game; he answers with gestures, which the game narrates.
    line: '‥‥‥ (마리오는 말없이 고개를 끄덕였다)',
  },
  {
    id: 'mallow',
    name: '마로',
    role: '날씨 · 회복',
    text: '자신을 개구리라 믿는 구름 같은 아이. 잘 울지만 날씨를 부리는 힘이 있습니다.',
    speaker: '마로',
    line: '저는 개굴개굴 연못에서 온 개구리 「마로」입니다.',
  },
  {
    id: 'geno',
    name: '지노',
    role: '천공의 사자',
    text: '천공에서 내려와 인형의 몸을 빌린 사자. 스타 로드를 고치려 마리오와 함께합니다.',
    speaker: '지노',
    line: '나는 천공의 사자! 그리고 별을 쫓는 자!!',
  },
  {
    id: 'bowser',
    name: '쿠파',
    role: '힘 · 물리 공격',
    text: '거대한 검에 성을 빼앗긴 라이벌. 성을 되찾으려 이번에는 같은 편이 됩니다.',
    speaker: '쿠파',
    line: '이 몸의 「쿠파 군단」에 너희를 넣어주마! 거절은 사양한다!',
  },
  {
    id: 'peach',
    name: '피치',
    role: '회복 · 지원',
    text: '구해야 할 공주이자, 합류한 뒤에는 회복으로 일행을 지탱하는 동료입니다.',
    speaker: '피치',
    line: '마리오 씨~~! 힘내세요~~!!',
  },
];

// Told by the Chancellor in his own voice from the patch; the last box is game-style narration.
const story = [
  {
    speaker: '버섯 대신',
    text: '마리오 씨, 큰일입니다! 공주님을 구하러 쿠파성에 가셨을 때, 하늘에서 거대한 검이 내리꽂혔지요. 그 바람에 마리오 씨는 성 밖으로 튕겨 나가고 말았습니다.',
  },
  {
    speaker: '버섯 대신',
    text: '검과 함께 나타난 카지오 군단이 소원을 이루어 주는 스타 로드를 부숴 버렸습니다. 흩어진 스타 피스 7개는 세계 곳곳으로 떨어졌다고 합니다.',
  },
  {
    speaker: '버섯 대신',
    text: '스타 피스를 모아 스타 로드를 고치지 않으면 누구의 소원도 이루어지지 않습니다. 마리오 씨, 부탁이네! 서둘러주게!!',
  },
  {
    text: '1996년, 스퀘어가 개발하고 닌텐도가 발매한 슈퍼 패미컴 RPG. 마리오다운 점프와 장난기 위에, 동료를 모으고 성장하는 RPG의 재미를 얹었다.',
  },
];
---

<PatchBook
  title={`${patch.title} 한글판`}
  trail={trail(patch)}
  description={`${patch.year}년 슈퍼 패미컴 ${patch.title} 한글패치 v${patch.version}. 일본판 롬파일을 고르면 이 페이지에서 바로 한글판을 만듭니다.`}
  sections={[
    { id: 'korean', label: '한국어로 바뀐 것' },
    { id: 'story', label: '이야기' },
    { id: 'play', label: '진행 방식' },
    { id: 'cast', label: '주인공과 동료' },
    { id: 'secrets', label: '놓치기 쉬운 즐길 거리' },
    { id: 'patch-notes', label: '패치 노트' },
    { id: 'making', label: '롬 분석 노트' },
  ]}
  theme={patch.theme}
  image={{
    src: `${base}/images/world-map-4x.webp`,
    alt: '슈퍼 마리오 RPG의 월드맵',
    width: 1024,
    height: 896,
  }}
  copyright={[patch.copyright]}
  links={[{ href: 'https://www.nintendo.co.jp/clvs/manuals/ja/pdf/CLV-P-VABQJ.pdf', label: '원작 공식 설명서' }]}
>
  <section class="hero page-width" aria-labelledby="title">
    <div class="hero-copy">
      <p class="label">{releaseLabel(patch)}</p>
      <h1 id="title" class="pixel">
        {patch.title} 한글판
      </h1>
      <PatchBox
        ips={downloads(patch).ips}
        spec={patch.spec}
        version={patch.version}
        output={patch.stem}
        speaker={GUIDE}
      />
      <SaveNote />
      <ManualPatch patch={patch} />
    </div>
    <figure class="hero-shot screen">
      <ZoomImage
        src="/games/kr-patches/catalogue/super-mario-rpg-title.webp"
        width="256"
        height="224"
        alt="슈퍼 마리오 RPG 한글판 타이틀 화면"
        fetchpriority="high"
      />
    </figure>
  </section>

  <section id="korean" class="section page-width" aria-labelledby="korean-title">
    <h2 id="korean-title" class="pixel">
      한국어로 바뀐 것
    </h2>
    <ul class="checklist frame">
      <li>모든 대사와 이름</li>
      <li>메뉴·상점·아이템 설명</li>
      <li>전투 명령·적 이름·필살기 설명</li>
      <li>동료마다 다른 원작의 말투</li>
    </ul>
    <Speech speaker={GUIDE}>같은 장면을 같은 입력으로 찍어서 일본판과 한글판을 나란히 놓았어요.</Speech>
    {compareGroups.map(group => (
      <CompareGroup
        group={group}
        base={base}
        versions={JAPANESE_AND_KOREAN}
        visible={VISIBLE_PER_GROUP}
        speaker={GUIDE}
      />
    ))}
  </section>

  <section id="story" class="section page-width" aria-labelledby="story-title">
    <h2 id="story-title" class="pixel">
      이야기
    </h2>
    <div class="story">
      <SpeechChain lines={story} />
      <div class="story-shots">
        <figure class="screen">
          <ZoomImage
            src={`${base}/images/patch/chancellor_kidnap_ko_1.webp`}
            width="256"
            height="224"
            alt="피치 공주가 또 납치됐다며 놀라는 버섯 대신"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="screen">
          <ZoomImage
            src={`${base}/images/scenes/castle.webp`}
            width="256"
            height="224"
            alt="공주의 기운을 느끼며 성 안을 걷는 마리오"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <section id="play" class="section page-width" aria-labelledby="play-title">
    <h2 id="play-title" class="pixel">
      진행 방식
    </h2>
    <div class="play-list">
      {play.map(item => (
        <article class="play frame">
          <figure class="screen">
            <ZoomImage
              src={`${base}/images/scenes/${item.image}.webp`}
              width="256"
              height="224"
              alt={item.alt}
              loading="lazy"
              decoding="async"
            />
          </figure>
          <h3 class="pixel">{item.title}</h3>
          <Speech speaker={GUIDE}>{item.text}</Speech>
          {item.buttons && (
            <ul class="pad-buttons" aria-label="전투 버튼">
              {item.buttons.map(button => (
                <li>
                  <span class:list={['pad-key', `pad-${button.key.toLowerCase()}`]}>{button.key}</span>
                  {button.name}
                </li>
              ))}
            </ul>
          )}
        </article>
      ))}
    </div>
  </section>

  <section id="cast" class="section page-width" aria-labelledby="cast-title">
    <h2 id="cast-title" class="pixel">
      주인공과 동료
    </h2>
    <ul class="cast-list">
      {cast.map(member => (
        <li class="member frame">
          <img
            class="portrait"
            src={`${base}/images/cast/${member.id}.webp`}
            width="144"
            height="144"
            alt=""
            loading="lazy"
            decoding="async"
          />
          <div>
            <h3 class="pixel">{member.name}</h3>
            <p class="label">{member.role}</p>
            <p>{member.text}</p>
            <Speech speaker={member.speaker}>{member.line}</Speech>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <Secrets />

  <section id="patch-notes" class="section page-width" aria-labelledby="patch-notes-title">
    <h2 id="patch-notes-title" class="pixel">
      패치 노트
    </h2>
    <article class="patch-release" aria-labelledby="release-1-2">
      <h3 id="release-1-2" class="pixel">
        v1.2 · 최신 버전
      </h3>
      <p class="section-note">
        <time datetime="2026-10-23">2026년 10월 23일</time>
      </p>
      <p class="release-overview">
        전투 메시지와 이름 띠의 영문 이름, 대사와 메뉴에서 잘못 나오던 글자를 고치고 셸·쉘 표기를 통일했습니다.
      </p>
      <ReleaseDetails>
        <ReleaseItem>
          <ul>
            <li>
              요시쿠키로 몬스터가 아이템으로 바뀔 때 「몬스터는 MUSHROOM 모습이 됐다!」처럼 영문 이름이 나오던 것을
              「버섯」 같은 한글 이름으로 고쳤습니다. v1.0부터 있던 문제입니다.
            </li>
          </ul>
          <ReleaseScreenshot
            src={`${base}/images/releases/v1-2/yoshi-cookie.webp`}
            highlights={[
              [222, 40, 328, 46],
              [222, 496, 328, 46],
            ]}
            width={630}
            height={920}
            panels={[
              { label: 'v1.1', crop: [110, 8, 512, 448], alt: 'v1.1 요시쿠키 메시지의 영문 MUSHROOM' },
              { label: 'v1.2', crop: [110, 464, 512, 448], alt: 'v1.2 요시쿠키 메시지의 한글 버섯' },
            ]}
            alt="요시쿠키 메시지의 아이템 이름 전후 비교"
            caption="요시쿠키 메시지"
          />
        </ReleaseItem>
        <ReleaseItem>
          <ul>
            <li>
              화면 위 이름 띠가 아이템과 아군 필살기 이름을 영문으로 읽던 것을 한글로 고쳤습니다. 평소 플레이에서는 적
              마법 이름만 띠에 나와 보이지 않던 부분입니다.
            </li>
          </ul>
          <ReleaseScreenshot
            src={`${base}/images/releases/v1-2/banner-item.webp`}
            highlights={[
              [118, 36, 496, 44],
              [118, 492, 496, 44],
            ]}
            width={630}
            height={920}
            panels={[
              { label: 'v1.1', crop: [110, 8, 512, 448], alt: 'v1.1 이름 띠의 영문 YOSICOOKIE' },
              { label: 'v1.2', crop: [110, 464, 512, 448], alt: 'v1.2 이름 띠의 한글 요시쿠키' },
            ]}
            alt="이름 띠의 아이템 이름 전후 비교"
            caption="이름 띠의 아이템 이름 (띠를 띄우려고 적의 행동을 바꾼 테스트 롬)"
          />
          <ReleaseScreenshot
            src={`${base}/images/releases/v1-2/banner-special.webp`}
            highlights={[
              [118, 36, 496, 44],
              [118, 492, 496, 44],
            ]}
            width={630}
            height={920}
            panels={[
              { label: 'v1.1', crop: [110, 8, 512, 448], alt: 'v1.1 이름 띠의 영문 CRUSH' },
              { label: 'v1.2', crop: [110, 464, 512, 448], alt: 'v1.2 이름 띠의 한글 솟아나라쑤욱' },
            ]}
            alt="이름 띠의 필살기 이름 전후 비교"
            caption="이름 띠의 필살기 이름 (같은 테스트 롬)"
          />
        </ReleaseItem>
        <ReleaseItem>
          <ul>
            <li>
              대사 폰트로 그리는 화면에서 아이템 「힐셸」이 「캡셸」로, 필살기 「천둥콰르릉」이 「천둥잣르릉」으로
              나오던 것을 고쳤습니다. v1.1이 대사 폰트에 새 글자를 넣으며 다른 글자의 자리를 덮어서 생긴 문제입니다.
            </li>
          </ul>
          <ReleaseScreenshot
            src={`${base}/images/releases/v1-2/glyph-result.webp`}
            highlights={[
              [424, 184, 48, 38],
              [424, 640, 48, 38],
            ]}
            width={630}
            height={920}
            panels={[
              { label: 'v1.1', crop: [110, 8, 512, 448], alt: 'v1.1 전투 결과 창의 캡셸' },
              { label: 'v1.2', crop: [110, 464, 512, 448], alt: 'v1.2 전투 결과 창의 힐쉘' },
            ]}
            alt="전투 결과 창의 힐쉘 전후 비교"
            caption="전투 결과 창의 아이템 이름"
          />
          <ReleaseScreenshot
            src={`${base}/images/releases/v1-2/glyph-levelup.webp`}
            highlights={[
              [298, 210, 128, 48],
              [298, 666, 128, 48],
            ]}
            width={630}
            height={920}
            panels={[
              { label: 'v1.1', crop: [110, 8, 512, 448], alt: 'v1.1 레벨업 화면의 천둥잣르릉' },
              { label: 'v1.2', crop: [110, 464, 512, 448], alt: 'v1.2 레벨업 화면의 천둥콰르릉' },
            ]}
            alt="레벨업 화면의 천둥콰르릉 전후 비교"
            caption="레벨업 화면에서 배운 필살기"
          />
        </ReleaseItem>
        <ReleaseItem>
          <ul>
            <li>
              메뉴에서 「힐셸」의 「힐」이 점으로, 「지노휠」의 「휠」이 「빼」로 나오던 문제를 고쳤습니다. v1.0 메뉴
              폰트 코드표가 그 두 글자를 다른 그림에 연결해 두었던 탓입니다.
            </li>
            <li>셸 → 쉘 표기 통일: 해피쉘·파이어쉘·힐쉘. 이미 쓰던 「레이지쉘」과 맞췄습니다.</li>
          </ul>
          <ReleaseScreenshot
            src={`${base}/images/releases/v1-2/shell-names.webp`}
            highlights={[
              [372, 16, 96, 98],
              [372, 472, 96, 98],
            ]}
            width={630}
            height={920}
            panels={[
              { label: 'v1.1', crop: [110, 8, 512, 448], alt: 'v1.1 장비 목록의 해피셸, 파이어셸, 점으로 나오는 ●셸' },
              { label: 'v1.2', crop: [110, 464, 512, 448], alt: 'v1.2 장비 목록의 해피쉘, 파이어쉘, 힐쉘' },
            ]}
            alt="장비 목록의 힐 글자와 셸·쉘 표기 전후 비교"
            caption="장비 목록의 이름 표기와 힐 글자"
          />
        </ReleaseItem>
        <ReleaseItem>
          <ul>
            <li>이전 버전 세이브를 그대로 이어서 할 수 있습니다.</li>
          </ul>
        </ReleaseItem>
      </ReleaseDetails>
    </article>
    <article class="patch-release" aria-labelledby="release-1-1">
      <h3 id="release-1-1" class="pixel">
        v1.1
      </h3>
      <p class="section-note">
        <time datetime="2026-10-18">2026년 10월 18일</time>
      </p>
      <p class="release-overview">이름 한글화와 조사 처리를 개선하고, 빠진 대사를 복구했습니다.</p>
      <ReleaseDetails>
        <ReleaseItem>
          <ul>
            <li>아이템·필살기·적 이름을 한국어로 옮겼습니다.</li>
          </ul>
          <ReleaseScreenshot
            highlights={[[134, 6, 108, 104]]}
            panels={[
              {
                label: 'v1.0',
                src: `${base}/images/releases/v1-1/shop-buy-v1-0.webp`,
                alt: 'v1.0 상점의 영문 아이템 이름',
              },
