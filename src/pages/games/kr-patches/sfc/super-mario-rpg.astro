---
import { SECTION_TITLES, sectionsOf } from '../../../../lib/patch-sections';
import PatchRelease from '../../../../components/kr-patch/PatchRelease.astro';
import ZoomImage from '../../../../components/kr-patch/ZoomImage.astro';
import ReleaseDetails from '../../../../components/kr-patch/ReleaseDetails.astro';
import ReleaseItem from '../../../../components/kr-patch/ReleaseItem.astro';
import ReleaseScreenshot from '../../../../components/kr-patch/ReleaseScreenshot.astro';
import CompareGroup from '../../../../components/kr-patch/CompareGroup.astro';
import ManualPatch from '../../../../components/kr-patch/ManualPatch.astro';
import SaveNote from '../../../../components/kr-patch/SaveNote.astro';
import PatchBox from '../../../../components/kr-patch/PatchBox.astro';
import Speech from '../../../../components/kr-patch/Speech.astro';
import MakingOf from '../../../../components/smrpg/MakingOf.astro';
import Secrets from '../../../../components/smrpg/Secrets.astro';
import PatchBook from '../../../../layouts/PatchBook.astro';
import { SMRPG_PATCH, downloads, releaseLabel, trail } from '../../../../lib/kr-patches';
import { compareGroups } from '../../../../lib/smrpg-showcase';
import { JAPANESE_AND_KOREAN } from '../../../../lib/version-pairs';

const patch = SMRPG_PATCH;
const base = patch.path;
const VISIBLE_PER_GROUP = 4;
const GUIDE = '키노피오';

const play = [
  {
    image: 'moleville',
    alt: '바위 언덕 사이로 두더지 마을을 둘러보는 마리오',
    title: '탐험',
    text: '마리오 님, 이곳은 비스듬히 내려다보는 입체 세계예요. 높은 곳에 올라서거나 숨은 상자를 찾으며 다음 마을로 가 보세요.',
  },
  {
    image: 'battle',
    alt: '마리오가 전투 명령을 고르는 화면',
    title: '전투',
    text: '필드에 보이는 적과 부딪히면 전투가 시작돼요. 버튼마다 명령이 하나씩 붙어 있어요.',
    buttons: [
      { key: 'A', name: '공격' },
      { key: 'X', name: '필살기' },
      { key: 'Y', name: '아이템' },
      { key: 'B', name: '방어' },
    ],
  },
  {
    image: 'specials',
    alt: '마리오와 마로의 필살기 설명이 보이는 메뉴',
    title: '타이밍',
    text: '공격이 닿는 순간 버튼을 누르면 피해가 커지고, 맞는 순간 누르면 피해가 줄어요. 필살기마다 누르는 방법이 다르니 메뉴에서 설명을 읽어 보세요.',
  },
  {
    image: 'shop',
    alt: '아이템 이름과 설명이 보이는 상점 화면',
    title: '성장',
    text: '레벨이 오르면 능력치 하나를 골라 키울 수 있어요. 상점에서 장비와 아이템을 갖추고, 동료를 바꿔 가며 싸워 보세요.',
  },
];

// Told in the order the party gathers; each screen is the Korean version of that scene.
const chapters = [
  {
    title: '하늘에서 떨어진 검',
    shots: [
      { src: 'patch/chancellor_kidnap_ko_1', alt: '피치 공주가 또 납치됐다며 놀라는 버섯 대신' },
      { src: 'scenes/castle', alt: '공주의 기운을 느끼며 성 안을 걷는 마리오' },
    ],
    text: [
      '이번에도 쿠파에게 잡혀간 피치 공주를 구하러 쿠파성에 쳐들어간 마리오. 쿠파와 맞붙은 순간, 하늘에서 거대한 검이 성에 내리꽂히고 마리오는 성 밖까지 튕겨 나갑니다.',
      '쿠파성은 검의 주인 「카지오」가 이끄는 카지오 군단에게 넘어갔습니다. 검이 하늘의 스타 로드를 뚫고 들어오면서 소원을 이루어 주던 스타 피스 7개도 세계 곳곳으로 흩어졌습니다. 스타 로드를 고치지 않으면 누구의 소원도 이루어지지 않습니다.',
    ],
    member: { id: 'mario', name: '마리오', role: '점프 · 불꽃' },
  },
  {
    title: '자기가 개구리라 믿는 아이',
    shots: [
      { src: 'patch/mallow_plan_ko_1', alt: '크로코를 뒤에서 잡자고 말하는 마로' },
      { src: 'patch/croco_hide_ko_1', alt: '막다른 길에 몰린 크로코' },
    ],
    text: [
      '버섯 왕국에서 만난 마로는 도둑 크로코에게 개구리 코인을 빼앗긴 참이었습니다. 함께 크로코를 쫓아 코인을 되찾고 돌아오니, 이번에는 카지오 군단의 맥이 버섯 궁전을 차지하고 있었습니다. 맥을 물리치자 첫 번째 스타 피스가 나타납니다.',
      '개굴개굴 연못으로 돌아간 마로는 할아버지 개구리 선인에게서 자신이 개구리가 아니라는 말을 듣습니다. 울음을 그친 마로는 진짜 부모를 찾으려고 마리오를 따라나섭니다.',
    ],
    member: { id: 'mallow', name: '마로', role: '날씨 · 회복' },
  },
  {
    title: '인형에 깃든 별',
    shots: [
      { src: 'patch/geno_sky_ko_1', alt: '숲속 공터에서 천공의 사자라고 외치는 지노' },
      { src: 'patch/geno_name_ko_1', alt: '지노라는 이름을 얻는 장면' },
    ],
    text: [
      '로즈 타운 사람들은 카지오 군단의 유민파가 쏜 화살에 맞아 꼼짝도 못 하고 있었습니다. 유민파가 별을 가로채려 하자, 파란 모자를 쓴 인형이 「나는 천공의 사자!」라며 앞을 막아섭니다.',
      '하늘에서 내려와 아이의 히어로 인형에 몸을 빌린 별의 사자는 인형의 이름을 따서 「지노」가 됩니다. 유민파를 물리쳐 두 번째 스타 피스를 되찾은 뒤, 지노는 스타 로드를 고치려고 일행에 합류합니다.',
    ],
    member: { id: 'geno', name: '지노', role: '천공의 사자' },
  },
  {
    title: '집을 잃은 대마왕',
    shots: [
      { src: 'patch/bowser_reminisce_ko_1', alt: '집도 없다며 한탄하는 쿠파' },
      { src: 'patch/bowser_army_ko_1', alt: '마리오 일행을 쿠파 군단에 넣어 주겠다는 쿠파' },
    ],
    text: [
      '두더지 마을에서 세 번째 스타 피스를 찾고 부키 타워에 다다른 일행 앞에, 부하들이 모두 떠나 버린 쿠파가 홀로 있었습니다. 「부키라는 녀석도 집이 있는데 이 몸은 아무것도 없다니‥」',
      '성을 되찾고 싶지만 도와 달라는 말은 차마 못 하는 쿠파. 대신 마리오 일행을 「쿠파 군단」에 넣어 주겠다며, 어제의 라이벌이 같은 편이 됩니다.',
    ],
    member: { id: 'bowser', name: '쿠파', role: '힘 · 물리 공격' },
  },
  {
    title: '원치 않는 결혼식',
    shots: [
      { src: 'patch/booster_itchy_ko_1', alt: '우는 신부에게 말을 거는 부키' },
      { src: 'patch/booster_salty_ko_1', alt: '짜다고 말하는 부키' },
    ],
    text: [
      '하늘에서 떨어진 피치 공주를 데려간 것은 부키 타워의 주인 부키였습니다. 메리마리 마을 성당에서 억지 결혼식이 열리려는 찰나, 마리오 일행이 뛰어듭니다. 신부가 왜 우는지도 모르는 부키는 눈물을 맛보고 「짜다.」 한마디뿐입니다.',
      '무사히 버섯 궁전으로 돌아간 공주는 성에서 기다리지 않고, 스타 피스를 찾는 모험에 직접 따라나섭니다.',
    ],
    member: { id: 'peach', name: '피치', role: '회복 · 지원' },
  },
  {
    title: '남은 스타 피스를 찾아서',
    shots: [
      { src: 'scenes/star-road', alt: '거대한 검이 스타 로드를 뚫고 내려오며 별이 흩어지는 장면' },
      { src: 'scenes/exor', alt: '쿠파성에 거대한 검이 꽂혀 있는 모습' },
    ],
    text: [
      '다섯이 모인 뒤에도 여정은 이어집니다. 구름 위 나라에서는 마로의 출생에 얽힌 비밀이, 뜨거운 화산 속에서는 여섯 번째 스타 피스가 기다립니다. 그리고 마지막 스타 피스는 모든 일이 시작된 쿠파성, 그 거대한 검 너머에 있습니다.',
    ],
  },
];
---

<PatchBook
  title={`${patch.title} 한글판`}
  trail={trail(patch)}
  description={`${patch.year}년 슈퍼 패미컴 ${patch.title} 한글패치 v${patch.version}. 일본판 롬파일을 고르면 이 페이지에서 바로 한글판을 만듭니다.`}
  sections={sectionsOf(['korean', 'story', 'play', 'secrets', 'patch-notes', 'making'])}
  theme={patch.theme}
  image={{
    src: `${base}/images/world-map-4x.webp`,
    alt: '슈퍼 마리오 RPG의 월드맵',
    width: 1024,
    height: 896,
  }}
  copyright={[patch.copyright]}
  links={[{ href: 'https://www.nintendo.co.jp/clvs/manuals/ja/pdf/CLV-P-VABQJ.pdf', label: '원작 공식 설명서' }]}
>
  <section class="hero page-width" aria-labelledby="title">
    <div class="hero-copy">
      <p class="label">{releaseLabel(patch)}</p>
      <h1 id="title" class="pixel">
        {patch.title} 한글판
      </h1>
      <PatchBox
        ips={downloads(patch).ips}
        spec={patch.spec}
        version={patch.version}
        output={patch.stem}
        speaker={GUIDE}
      >
        <ManualPatch patch={patch} />
        <SaveNote />
      </PatchBox>
    </div>
    <figure class="hero-shot screen">
      <ZoomImage
        src="/games/kr-patches/catalogue/super-mario-rpg-title.webp"
        width="256"
        height="224"
        alt="슈퍼 마리오 RPG 한글판 타이틀 화면"
        fetchpriority="high"
      />
    </figure>
  </section>

  <section id="korean" class="section page-width" aria-labelledby="korean-title">
    <h2 id="korean-title" class="pixel">
      {SECTION_TITLES.korean}
    </h2>
    <ul class="checklist frame">
      <li>모든 대사와 이름</li>
      <li>메뉴·상점·아이템 설명</li>
      <li>전투 명령·적 이름·필살기 설명</li>
    </ul>
    <Speech speaker={GUIDE}>같은 장면을 같은 입력으로 찍어서 일본판과 한글판을 나란히 놓았어요.</Speech>
    {compareGroups.map(group => (
      <CompareGroup
        group={group}
        base={base}
        versions={JAPANESE_AND_KOREAN}
        visible={VISIBLE_PER_GROUP}
        speaker={GUIDE}
      />
    ))}
  </section>

  <section id="story" class="section page-width" aria-labelledby="story-title">
    <h2 id="story-title" class="pixel">
      {SECTION_TITLES.story}
    </h2>
    <p>
      1996년, 스퀘어가 개발하고 닌텐도가 발매한 슈퍼 패미컴 RPG입니다.
      <br />
      흩어진 스타 피스 7개를 찾아 떠나는 길에 동료가 한 명씩 늘어납니다.
    </p>
    <ol class="chapters">
      {chapters.map(chapter => (
        <li class="chapter frame">
          {chapter.shots && (
            <div class="chapter-shots">
              {chapter.shots.map(shot => (
                <figure class="screen">
                  <ZoomImage
                    src={`${base}/images/${shot.src}.webp`}
                    width="256"
                    height="224"
                    alt={shot.alt}
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              ))}
            </div>
          )}
          <div class="chapter-copy">
            <h3 class="pixel">{chapter.title}</h3>
            {chapter.text.map(paragraph => (
              <p>{paragraph}</p>
            ))}
            {chapter.member && (
              <p class="companion">
                <img
                  class="portrait"
                  src={`${base}/images/cast/${chapter.member.id}.webp`}
                  width="144"
                  height="144"
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <span>
                  <strong>{chapter.member.name}</strong>
                  <span class="label">{chapter.member.role}</span>
                </span>
              </p>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section id="play" class="section page-width" aria-labelledby="play-title">
    <h2 id="play-title" class="pixel">
      {SECTION_TITLES.play}
    </h2>
    <div class="play-list">
      {play.map(item => (
        <article class="play frame">
          <figure class="screen">
            <ZoomImage
              src={`${base}/images/scenes/${item.image}.webp`}
              width="256"
              height="224"
              alt={item.alt}
              loading="lazy"
              decoding="async"
            />
          </figure>
          <h3 class="pixel">{item.title}</h3>
          <Speech speaker={GUIDE}>{item.text}</Speech>
          {item.buttons && (
            <ul class="pad-buttons" aria-label="전투 버튼">
              {item.buttons.map(button => (
                <li>
                  <span class:list={['pad-key', `pad-${button.key.toLowerCase()}`]}>{button.key}</span>
                  {button.name}
                </li>
              ))}
            </ul>
          )}
        </article>
      ))}
    </div>
  </section>

  <Secrets />

  <section id="patch-notes" class="section page-width" aria-labelledby="patch-notes-title">
    <h2 id="patch-notes-title" class="pixel">
      {SECTION_TITLES['patch-notes']}
    </h2>
    <PatchRelease patch={patch} version="1.2">
      <p class="release-overview">
        전투 메시지와 이름 띠의 영문 이름, 대사와 메뉴에서 잘못 나오던 글자를 고치고 셸·쉘 표기를 통일했습니다.
      </p>
      <ReleaseDetails>
        <ReleaseItem>
          <ul>
            <li>
              요시쿠키로 몬스터가 아이템으로 바뀔 때 「몬스터는 MUSHROOM 모습이 됐다!」처럼 영문 이름이 나오던 것을
              「버섯」 같은 한글 이름으로 고쳤습니다. v1.0부터 있던 문제입니다.
            </li>
          </ul>
          <ReleaseScreenshot
            src={`${base}/images/releases/v1-2/yoshi-cookie.webp`}
            highlights={[
              [222, 40, 328, 46],
              [222, 496, 328, 46],
            ]}
            width={630}
            height={920}
            panels={[
              { label: 'v1.1', crop: [110, 8, 512, 448], alt: 'v1.1 요시쿠키 메시지의 영문 MUSHROOM' },
              { label: 'v1.2', crop: [110, 464, 512, 448], alt: 'v1.2 요시쿠키 메시지의 한글 버섯' },
            ]}
            alt="요시쿠키 메시지의 아이템 이름 전후 비교"
            caption="요시쿠키 메시지"
          />
        </ReleaseItem>
        <ReleaseItem>
          <ul>
            <li>
              화면 위 이름 띠가 아이템과 아군 필살기 이름을 영문으로 읽던 것을 한글로 고쳤습니다. 평소 플레이에서는 적
              마법 이름만 띠에 나와 보이지 않던 부분입니다.
            </li>
          </ul>
          <ReleaseScreenshot
            src={`${base}/images/releases/v1-2/banner-item.webp`}
            highlights={[
              [118, 36, 496, 44],
              [118, 492, 496, 44],
            ]}
            width={630}
            height={920}
            panels={[
              { label: 'v1.1', crop: [110, 8, 512, 448], alt: 'v1.1 이름 띠의 영문 YOSICOOKIE' },
              { label: 'v1.2', crop: [110, 464, 512, 448], alt: 'v1.2 이름 띠의 한글 요시쿠키' },
            ]}
            alt="이름 띠의 아이템 이름 전후 비교"
            caption="이름 띠의 아이템 이름 (띠를 띄우려고 적의 행동을 바꾼 테스트 롬)"
          />
          <ReleaseScreenshot
            src={`${base}/images/releases/v1-2/banner-special.webp`}
            highlights={[
              [118, 36, 496, 44],
              [118, 492, 496, 44],
            ]}
            width={630}
            height={920}
            panels={[
              { label: 'v1.1', crop: [110, 8, 512, 448], alt: 'v1.1 이름 띠의 영문 CRUSH' },
              { label: 'v1.2', crop: [110, 464, 512, 448], alt: 'v1.2 이름 띠의 한글 솟아나라쑤욱' },
            ]}
            alt="이름 띠의 필살기 이름 전후 비교"
            caption="이름 띠의 필살기 이름 (같은 테스트 롬)"
          />
        </ReleaseItem>
        <ReleaseItem>
          <ul>
            <li>
              대사 폰트로 그리는 화면에서 아이템 「힐셸」이 「캡셸」로, 필살기 「천둥콰르릉」이 「천둥잣르릉」으로
              나오던 것을 고쳤습니다. v1.1이 대사 폰트에 새 글자를 넣으며 다른 글자의 자리를 덮어서 생긴 문제입니다.
            </li>
          </ul>
          <ReleaseScreenshot
            src={`${base}/images/releases/v1-2/glyph-result.webp`}
            highlights={[
              [424, 184, 48, 38],
              [424, 640, 48, 38],
            ]}
            width={630}
            height={920}
            panels={[
              { label: 'v1.1', crop: [110, 8, 512, 448], alt: 'v1.1 전투 결과 창의 캡셸' },
              { label: 'v1.2', crop: [110, 464, 512, 448], alt: 'v1.2 전투 결과 창의 힐쉘' },
            ]}
            alt="전투 결과 창의 힐쉘 전후 비교"
            caption="전투 결과 창의 아이템 이름"
          />
          <ReleaseScreenshot
            src={`${base}/images/releases/v1-2/glyph-levelup.webp`}
            highlights={[
              [298, 210, 128, 48],
              [298, 666, 128, 48],
            ]}
            width={630}
            height={920}
            panels={[
              { label: 'v1.1', crop: [110, 8, 512, 448], alt: 'v1.1 레벨업 화면의 천둥잣르릉' },
