---
import GuideChapter from '../../../layouts/GuideChapter.astro';
import Deeper from '../../../components/romhacking/Deeper.astro';
import Figure from '../../../components/romhacking/Figure.astro';
import HuffmanCode from '../../../components/romhacking/HuffmanCode.astro';
import { OTOGIRISOU_PATCH } from '../../../lib/kr-patches.ts';
import { chapterBySlug, chapterPath } from '../../../components/romhacking/chapters.ts';

const sections = [
  { id: 'idea', label: '자주 나오는 글자에 짧은 부호' },
  { id: 'prefix', label: '어떤 부호도 다른 부호의 앞부분이 아니다' },
  { id: 'tree', label: '가장 적은 둘을 묶어 트리 만들기' },
  { id: 'bits', label: '비트열을 한 비트씩 읽기' },
  { id: 'rom-tree', label: '롬에 트리를 저장하는 방법과 찾는 법' },
  { id: 'in-patch', label: '실제 패치에서' },
  { id: 'try', label: '직접 해 보기' },
];
const references = [
  {
    href: 'https://doi.org/10.1109/JRPROC.1952.273898',
    label: 'D. A. Huffman, "A Method for the Construction of Minimum-Redundancy Codes", Proc. IRE 40(9), 1952',
    note: '가장 적게 나온 둘을 묶기를 되풀이해 평균 길이가 가장 짧은 부호를 만드는 방법',
  },
  {
    href: 'https://www.rfc-editor.org/rfc/rfc1951#section-3.2.2',
    label: 'RFC 1951, DEFLATE 3.2.2 "Use of Huffman coding in the deflate format"',
    note: '부호 길이만 저장하고 부호를 정해진 순서로 다시 만드는 정규 허프만 부호와 그 예(ABCDEFGH)',
  },
  {
    href: 'https://github.com/perfectacle/kr-patches/blob/main/snes/otogirisou/docs/ANALYSIS.ko.md',
    label: 'kr-patches, 제절초 docs/ANALYSIS.ko.md 3장',
    note: '일본판 허프만 비트열의 기준점, 트리 표 두 개와 루트, 첫 문장의 비트, v1.0의 2바이트 대본',
  },
  {
    href: 'https://github.com/perfectacle/kr-patches/blob/main/snes/otogirisou/tools/script.py',
    label: 'kr-patches, 제절초 tools/script.py',
    note: '일본판 비트열과 v1.0 2바이트 대본을 읽는 파서(이 장의 실행 결과)',
  },
];
const LZSS = chapterPath(chapterBySlug('common', 'lzss'));
const TEXT = chapterPath(chapterBySlug('snes', 'text'));
const EXPANSION = chapterPath(chapterBySlug('snes', 'expansion'));

// 「夏の夕暮。」 and the line break as the Japanese script stores them (tools/script.py).
const firstLine = [
  { ch: '夏', code: '1000100000000010' },
  { ch: 'の', code: '01001' },
  { ch: '夕', code: '1111101010101000' },
  { ch: '暮', code: '00110111101111' },
  { ch: '。', code: '10010' },
  { ch: '{00}', code: '11001' },
];
// The walk for 「の」 (tools/script.py on the Japanese ROM): bit, offset read, value there.
const noWalk = [
  ['0', '0B6C', '05B4'],
  ['1', '0B68', '05B1'],
  ['0', '0B62', '05AA'],
  ['0', '0B54', '059C'],
  ['1', '0B38', '862E'],
];
---

<GuideChapter platform="common" slug="huffman" sections={sections} references={references}>
  <h2 id="idea">
    자주 나오는 글자에 짧은 부호 <span class="layer-badge layer-easy">쉽게</span>
  </h2>
  <p>
    지금까지 본 대사는 글자마다 같은 길이였습니다. 2바이트 글자표라면 「の」도 「鬱」도 16비트입니다. 그런데 일본어
    대본에서 「の」는 수천 번 나오고 어려운 한자는 몇 번 나오지 않습니다. 자주 나오는 글자에 짧은 부호를, 드문 글자에 긴
    부호를 주면 전체가 짧아집니다. 모스 부호가 영어에서 가장 흔한 E를 점 하나(·)로 적는 것과 같은 생각입니다.
  </p>
  <p>
    1952년 데이비드 허프만(David A. Huffman)은 글자마다 나온 횟수를 알 때 <strong>평균 길이가 가장 짧은</strong> 부호를
    만드는 방법을 내놓았습니다. 이것이 <strong>허프만 부호</strong>입니다. <a href={LZSS}>9장</a>의 LZSS가 "앞에 나온
    것을 다시 쓰기"로 줄인다면, 허프만 부호는 "글자마다 비트 수를 다르게 하기"로 줄입니다. 둘을 함께 쓰는 형식(ZIP의
    DEFLATE 등)도 많습니다.
  </p>

  <h2 id="prefix">
    어떤 부호도 다른 부호의 앞부분이 아니다 <span class="layer-badge layer-easy">쉽게</span>
  </h2>
  <p>
    길이가 제각각인 부호를 빈틈없이 이어 붙이면 어디서 한 글자가 끝나는지 표시가 없습니다. 그래도 읽을 수 있으려면
    조건이 하나 필요합니다. <strong>어떤 부호도 다른 부호의 앞부분이 되면 안 됩니다.</strong> 이런 부호를 접두
    부호(prefix code)라고 합니다.
  </p>
  <Figure caption="왼쪽은 앞부분이 겹쳐 01을 두 가지로 읽을 수 있고, 오른쪽은 한 가지로만 읽힙니다." max={600}>
    <svg viewBox="0 0 360 200" role="img" aria-labelledby="pre-t pre-d">
      <title id="pre-t">접두 부호</title>
      <desc id="pre-d">
        왼쪽 부호 A=0, B=01, C=1에서는 A가 B의 앞부분이라 비트 01을 B로도, A 다음 C로도 읽을 수 있다. 오른쪽 부호 A=0,
        B=10, C=11은 어느 부호도 다른 부호의 앞부분이 아니어서 0 10 11을 A B C로만 읽는다.
      </desc>
      <rect class="dg-paper" x="4" y="4" width="172" height="192" rx="8"></rect>
      <text class="dg-text dg-bold" x="16" y="26">
        겹치는 부호
      </text>
      <text class="dg-mono" x="16" y="52">
        A = 0
      </text>
      <text class="dg-mono" x="16" y="72">
        B = 01
      </text>
      <text class="dg-mono" x="16" y="92">
        C = 1
      </text>
      <text class="dg-small" x="16" y="122">
        비트 01은?
      </text>
      <rect class="dg-warm" x="16" y="132" width="148" height="26" rx="4"></rect>
      <text class="dg-small" x="24" y="149">
        B 하나
      </text>
      <rect class="dg-warm" x="16" y="162" width="148" height="26" rx="4"></rect>
      <text class="dg-small" x="24" y="179">
        A 다음 C — 둘 다 맞음
      </text>
      <rect class="dg-paper" x="184" y="4" width="172" height="192" rx="8"></rect>
      <text class="dg-text dg-bold" x="196" y="26">
        접두 부호
      </text>
      <text class="dg-mono" x="196" y="52">
        A = 0
      </text>
      <text class="dg-mono" x="196" y="72">
        B = 10
      </text>
      <text class="dg-mono" x="196" y="92">
        C = 11
      </text>
      <text class="dg-small" x="196" y="122">
        비트 01011은?
      </text>
      <rect class="dg-accent" x="196" y="132" width="148" height="56" rx="4"></rect>
      <text class="dg-mono" x="206" y="154">
        0 | 10 | 11
      </text>
      <text class="dg-small" x="206" y="176">
        A B C 한 가지뿐
      </text>
    </svg>
  </Figure>
  <p>
    접두 부호라면 앞에서부터 비트를 하나씩 붙여 가다가 부호표에 있는 꼴이 되는 순간 그것이 한 글자입니다. 더 긴 부호가
    그 꼴로 시작할 수 없으니 기다릴 필요도, 되돌아갈 필요도 없습니다. 허프만 부호는 언제나 접두 부호입니다. 그 이유는
    다음 절에서 만드는 트리의 모양에 있습니다.
  </p>

  <h2 id="tree">
    가장 적은 둘을 묶어 트리 만들기 <span class="layer-badge layer-easy">쉽게</span>
  </h2>
  <p>
    허프만의 방법은 글자들을 <strong>트리</strong>로 묶는 것입니다. 트리는 맨 위의 한 점에서 갈림길이 아래로 두 갈래씩
    뻗어 나가는 모양의 자료 구조입니다. 갈림길이나 끝 하나하나를 <strong>노드</strong>, 맨 위에서 시작하는 노드를{' '}
    <strong>루트</strong>, 더 갈라지지 않는 끝 노드를 <strong>리프</strong>라고 합니다. 허프만 부호에서는 글자가 모두
    리프에 있습니다.
  </p>
  <p>만드는 순서는 단순합니다.</p>
  <ol>
    <li>글자마다 나온 횟수를 셉니다. 이 횟수를 무게라고 합니다.</li>
    <li>가장 가벼운 둘을 골라 하나로 묶습니다. 묶음의 무게는 둘의 합입니다.</li>
    <li>하나만 남을 때까지 2를 되풀이합니다. 남은 하나가 루트입니다.</li>
    <li>
      루트에서 글자까지 내려가며 한쪽 가지에 0, 다른 쪽에 1을 적습니다. 지나온 숫자를 이은 것이 그 글자의 부호입니다.
    </li>
  </ol>
  <p>
    글자는 모두 리프에 있고, 한 리프로 가는 길이 다른 리프로 가는 길의 중간에서 끝나는 일은 없습니다. 그래서 어떤 부호도
    다른 부호의 앞부분이 될 수 없습니다. 가벼운 것부터 묶었으니 드문 글자는 깊은 곳(긴 부호)에, 흔한 글자는 루트
    가까이(짧은 부호)에 놓입니다.
  </p>

  <HuffmanCode />

  <Deeper title="최소라는 뜻, 같은 무게일 때, 부호 길이만 저장하는 정규 허프만 부호">
    <h3>무엇이 가장 짧은가</h3>
    <p>
      허프만 부호는 "글자마다 정수 개의 비트를 주는 접두 부호" 가운데 전체 길이(횟수 × 부호 길이의 합)가 가장 짧습니다.
      위 예에서 「장」 넷에 1비트, 「공」·빈칸 둘씩에 2·3비트, 「간」 하나에 3비트를 주어 17비트가 됩니다. 이보다 짧은
      접두 부호는 없습니다. 다만 글자마다 정수 개의 비트를 주는 방식 안에서의 최소입니다. LZSS처럼 앞에 나온 문자열을
      다시 쓰거나, 산술 부호처럼 글자 하나에 1.3비트 같은 정수가 아닌 길이를 줄 수 있는 방식은 더 짧아질 수 있습니다.
    </p>
    <h3>같은 무게일 때</h3>
    <p>
      무게가 같은 것이 여럿이면 어느 둘을 고르느냐에 따라 트리 모양과 부호가 달라지지만, 전체 길이는 같습니다. 그러니
      압축기와 해제기가 <strong>같은 트리</strong>를 쓰기만 하면 됩니다. 위 도구는 횟수가 같으면 글자를 묶음보다 먼저,
      글자끼리는 먼저 나온 글자를, 묶음끼리는 먼저 만든 묶음을 고르고, 먼저 고른 쪽에 0을 줍니다.
    </p>
    <h3>트리 대신 부호 길이만 저장하기</h3>
    <p>
      해제기는 트리를 알아야 하므로 압축 자료와 함께 트리도 어딘가에 있어야 합니다. 트리 모양을 통째로 저장하는 대신
      글자마다 부호 길이만 저장하는 방법이 <strong>정규 허프만 부호</strong>(canonical Huffman code)입니다. 길이만
      같으면 부호가 무엇이든 전체 길이는 같으므로, 부호를 정해진 규칙으로 다시 만들어 씁니다(RFC 1951 3.2.2).
    </p>
    <ol>
      <li>글자를 부호 길이가 짧은 순으로, 길이가 같으면 글자 순서대로 줄 세웁니다.</li>
      <li>가장 짧은 길이의 첫 부호는 모두 0입니다.</li>
      <li>다음 글자의 부호는 앞 부호에 1을 더한 값입니다.</li>
      <li>길이가 한 칸 늘어나는 곳에서는 1을 더한 뒤 끝에 0을 하나 붙입니다.</li>
    </ol>
    <p>
      RFC의 예에서 A–H의 길이가 (3, 3, 3, 3, 3, 2, 4, 4)이면, 가장 짧은 F가 <code>00</code>, 길이가 3으로 늘어나는 A는{' '}
      <code>00</code> + 1 = <code>01</code>에 0을 붙인 <code>010</code>, 그 뒤로 B <code>011</code>, C <code>100</code>,
      D <code>101</code>, E <code>110</code>, 다시 길이가 늘어나는 G <code>1110</code>, H <code>1111</code>입니다. 이
      가이드의 허프만 코드도 이 예로 테스트합니다.
    </p>
    <p>
      이렇게 하면 해제기에 필요한 것은 "길이마다 부호가 몇 개인가"와 글자 순서뿐입니다. 길이마다 첫 부호를 계산해 두고,
      읽은 비트가 그 길이의 범위 안에 들면 몇 번째 글자인지 바로 셉니다. 노드마다 두 칸씩 쓰는 트리 표보다 훨씬 작게
      저장할 수 있어서 롬 자리가 빠듯할 때 유리합니다. ZIP·PNG가 쓰는 DEFLATE도 이 방식입니다.
    </p>
    <p>
      글자가 수백·수천 개인 게임에서는 부호 길이가 20비트 가까이 길어질 수 있습니다. 해제 루틴이 다룰 수 있는 최대
      길이를 정해 두고, 그보다 긴 부호가 나오지 않도록 트리를 고쳐 만드는 형식도 있습니다(DEFLATE는 15비트).
    </p>
  </Deeper>

  <h2 id="bits">
    비트열을 한 비트씩 읽기 <span class="layer-badge layer-easy">쉽게</span>
  </h2>
  <p>
    허프만 부호로 적은 자료는 바이트 경계를 무시하고 비트가 줄줄이 이어집니다. 그래서 읽는 쪽은 "지금 몇 번째 바이트의
    몇 번째 비트"를 기억하는 <strong>비트 위치</strong>를 들고 다닙니다. 한 바이트 안에서 어느 비트부터 읽는지도 정해져
    있어야 합니다. 맨 위 비트(비트 7)부터 읽는 형식도, 맨 아래 비트(비트 0)부터 읽는 형식도 있습니다.
  </p>
  <Figure caption="제절초 일본판 대본의 비트 위치 126(0부터 셈)부터. 바이트마다 아래 비트부터 읽습니다." max={600}>
    <svg viewBox="0 0 360 200" role="img" aria-labelledby="rd-t rd-d">
      <title id="rd-t">비트를 아래부터 읽기</title>
      <desc id="rd-d">
        파일 0xAE410의 바이트 63은 2진수 0110 0011이고, 비트 6과 비트 7을 읽으면 1, 0이다. 다음 바이트 04는 0000
        0100이고 비트 0부터 읽으면 0, 0, 1, 0, 0, 0, 0, 0이다. 이어 붙인 1000100000은 夏의 부호 1000100000000010의 앞
        10비트다.
      </desc>
      <text class="dg-small" x="8" y="14">
        파일 0xAE410 = 63 (0110 0011)
      </text>
      {[0, 1, 1, 0, 0, 0, 1, 1].map((v, i) => {
        const bit = 7 - i;
        const used = bit >= 6;
        return (
          <>
            <rect class={used ? 'dg-accent' : 'dg-cell'} x={8 + i * 21} y="22" width="19" height="26" rx="3" />
            <text class="dg-mono" x={17.5 + i * 21} y="40" text-anchor="middle">
              {v}
            </text>
            <text class="dg-small" x={17.5 + i * 21} y="62" text-anchor="middle">
              {bit}
            </text>
          </>
        );
      })}
      <text class="dg-small" x="186" y="14">
        0xAE411 = 04 (0000 0100)
      </text>
      {[0, 0, 0, 0, 0, 1, 0, 0].map((v, i) => {
        const bit = 7 - i;
        return (
          <>
            <rect class="dg-accent" x={186 + i * 21} y="22" width="19" height="26" rx="3" />
            <text class="dg-mono" x={195.5 + i * 21} y="40" text-anchor="middle">
              {v}
            </text>
            <text class="dg-small" x={195.5 + i * 21} y="62" text-anchor="middle">
              {bit}
            </text>
          </>
        );
      })}
      <text class="dg-small" x="8" y="84">
        읽는 순서: 0xAE410의 비트 6, 7 → 0xAE411의 비트 0, 1, 2 … 7
      </text>
      <rect class="dg-cool" x="8" y="96" width="344" height="34" rx="4"></rect>
      <text class="dg-mono" x="18" y="118">
        1 0 | 0 0 1 0 0 0 0 0 …
      </text>
      <path class="dg-arrow" d="M180 132V150" marker-end="url(#dg-arrowhead)"></path>
      <rect class="dg-accent" x="8" y="156" width="344" height="36" rx="4"></rect>
      <text class="dg-text" x="18" y="179">
        夏 = 1000100000000010 (16비트)의 앞부분
      </text>
    </svg>
  </Figure>
  <p>
    읽는 과정은 위 도구의 ④와 같습니다. 루트에서 시작해 비트가 0이면 한쪽, 1이면 다른 쪽 가지로 내려가고, 리프에 닿으면
    글자 하나를 내놓고 루트로 돌아갑니다. 글자 하나를 읽는 데 부호 길이만큼 반복하므로, 긴 부호는 읽는 데도 오래
    걸립니다.
  </p>
  <p>
    비트열 안의 위치를 가리키는 값도 비트 단위가 됩니다. 대본에서 다른 장면으로 점프하는 제어 코드라면 점프할 곳이
    "기준점에서 몇 번째 비트"로 적힙니다. 번역해서 글자 수가 바뀌면 모든 점프 위치를 비트 단위로 다시 계산해야 합니다.
  </p>

  <h2 id="rom-tree">
    롬에 트리를 저장하는 방법과 찾는 법 <span class="layer-badge layer-easy">쉽게</span>
  </h2>
  <p>
    게임은 트리를 롬에 표로 넣어 둡니다. 가장 흔한 꼴은 노드마다 "0일 때 갈 곳"과 "1일 때 갈 곳"을 적은 표입니다. 갈
    곳이 다른 노드인지 리프(글자)인지는 값의 한 비트로 구별합니다. 제절초 일본판은 "1일 때 표"와 "0일 때 표"를 따로
    두고, 노드의 위치(오프셋)로 두 표를 같이 찾아봅니다.
  </p>
  <Deeper title="두 표로 트리를 따라가는 실제 모습">
    <Figure caption="제절초 일본판에서 「の」(01001)를 읽는 길. 값의 맨 위 비트가 1이면 리프입니다." max={600}>
      <svg viewBox="0 0 360 232" role="img" aria-labelledby="nt-t nt-d">
        <title id="nt-t">두 표로 트리 따라가기</title>
        <desc id="nt-d">
          루트 오프셋 0B6C에서 비트 0이면 0일 때 표($02:CD4F), 1이면 1일 때 표($02:C1E1)의 같은 오프셋에서 16비트 값을
          읽는다. 노드 값에 2를 곱한 것이 다음 오프셋이다. 01001을 따라 오프셋 0B6C, 0B68, 0B62, 0B54, 0B38을 거쳐
          862E를 읽으면 맨 위 비트가 1이라 리프이고, 기호는 862E와 1FFF의 AND인 062E, 곧 の다.
        </desc>
        <rect class="dg-cool" x="8" y="8" width="168" height="38" rx="6"></rect>
        <text class="dg-small" x="16" y="24">
          비트 0일 때 표
        </text>
        <text class="dg-mono" x="16" y="40">
          $02:CD4F
        </text>
        <rect class="dg-warm" x="184" y="8" width="168" height="38" rx="6"></rect>
        <text class="dg-small" x="192" y="24">
          비트 1일 때 표
        </text>
        <text class="dg-mono" x="192" y="40">
          $02:C1E1
        </text>
        <text class="dg-small" x="8" y="66">
          루트 = 오프셋 0B6C. 노드 값 × 2 = 다음 오프셋
        </text>
        {noWalk.map(([bit, at, v], i) => {
          const leaf = i === noWalk.length - 1;
          return (
            <>
              <rect
                class={leaf ? 'dg-accent' : bit === '0' ? 'dg-cool' : 'dg-warm'}
                x="8"
                y={76 + i * 30}
                width="344"
                height="26"
                rx="4"
              />
              <text class="dg-mono" x="16" y={94 + i * 30}>
                {`${bit} · ${at} → $${v}`}
              </text>
              <text class="dg-small" x="344" y={94 + i * 30} text-anchor="end">
                {leaf
                  ? '리프: 기호 $62E = の'
                  : `노드 → 오프셋 ${(parseInt(v ?? '0', 16) * 2).toString(16).toUpperCase().padStart(4, '0')}`}
              </text>
            </>
          );
        })}
      </svg>
    </Figure>
    <p>
      처음 읽은 <code>$05B4</code>는 맨 위 비트가 꺼져 있으니 노드입니다. 값은 노드 번호이고 칸 하나가 2바이트라서, 2를
      곱한 <code>$0B68</code>이 다음에 볼 오프셋입니다. 마지막의 <code>$862E</code>는 맨 위 비트가 켜져 있으므로
      리프이고, 아래 13비트 <code>$062E</code>(1582)가 폰트의 「の」 번호입니다.
    </p>
  </Deeper>

  <p>롬에서 허프만 자료를 찾는 단서는 이렇습니다.</p>
  <ul>
    <li>
      화면에 나온 대사를 <a href={TEXT}>8장</a>의 방법(글자표 만들기, 연속된 번호 찾기)으로 아무리 찾아도 나오지
      않습니다.
    </li>
    <li>
      대사를 찍는 코드를 거슬러 올라가면 <code>LSR</code>·<code>ROL</code>로 한 비트씩 밀어내고, 8번마다 다음 바이트를
      읽고, 그 비트로 두 표 가운데 하나를 고르는 반복문이 나옵니다. 이 반복문이 끝나는 곳에서 나오는 값이 글자
      번호입니다.
    </li>
    <li>
      반복문이 읽는 표는 2바이트 값이 수천 개 이어지고, 그 가운데 절반쯤은 맨 위 비트가 켜져 있습니다(리프). 리프의 아래
      비트를 모으면 글자 번호가 겹치지 않고 하나씩 나옵니다.
    </li>
    <li>
      대본 위치를 담은 WRAM 변수 옆에 "바이트 안의 비트 번호"(0–7)를 담은 변수가 하나 더 있습니다. 제절초는{' '}
      <code>$52</code>–<code>$54</code>가 위치, <code>$55</code>가 비트 번호입니다.
    </li>
  </ul>

  <h2 id="in-patch">
    실제 패치에서 <span class="layer-badge layer-patch">실제 패치에서</span>
  </h2>
  <h3>제절초 일본판: 대본 전체가 허프만 비트열</h3>
  <p>
    <a href={`${OTOGIRISOU_PATCH.path}/`}>제절초</a> 일본판은 대본 전체를 허프만 부호로 이어 붙인 비트열 하나로
    넣었습니다. 기준점은 <code>$15:E401</code>(파일 0xAE401)이고, 바이트마다 아래 비트부터 읽습니다. 크기는 약 246만
    비트, 바이트로 30만 바이트쯤입니다. 기호는 <code>$000</code>–<code>$FFF</code>가 글자(폰트 번호), <code>$1000</code>
    –<code>$1046</code>이 제어 코드입니다. 리프에는 이 밖에 <code>$1176</code>이 하나 있는데, 대본 전체를 처음부터 읽어
    보면 글자나 제어 코드로는 한 번도 나오지 않고 선택지 코드 <code>{'{1A}'}</code>의 첫 인자(보기 수와 표시 조건을 묶은
    값)로 한 번 쓰입니다. 인자도 같은 허프만 부호로 적혀 있기 때문입니다.
  </p>
  <p>
    트리는 위 「더 깊이」의 두 표이고 루트는 오프셋 <code>$0B6C</code>입니다. 이 트리를 끝까지 따라가 세어 보면 리프가
    1,464개, 갈림길인 노드가 1,463개입니다(두 갈래 트리에서 리프는 언제나 갈림길 노드보다 하나 많습니다). 표마다 갈림길
    노드 수만큼 1,463칸, 2,926바이트입니다. 부호 길이는 5비트에서 19비트까지이고, 가장 짧은 5비트 부호는 아홉 개입니다.
    줄바꿈 제어 코드 <code>{'{00}'}</code>과 글자 여덟 개(마침표 「。」, 쉼표 「、」, 「の」, 「い」, 「た」, 「っ」,
    말줄임표(…), 여는 낫표 「「」)입니다.
  </p>
  <p>대본의 첫 문장 「夏の夕暮。」와 줄바꿈은 제어 코드 넷 뒤, 비트 위치 126(0부터 셈)부터 61비트에 들어 있습니다.</p>
  <ul class="byte-strip hf-line" aria-label={firstLine.map(f => `${f.ch} ${f.code}`).join(', ')}>
    {firstLine.map(f => (
      <li class:list={{ 'is-accent': f.code.length <= 5 }}>
        <code>{f.code}</code>
        <small>
          {f.ch} · {f.code.length}비트
        </small>
      </li>
    ))}
  </ul>
  <p>
    점프 인자는 기호가 아니라 기준점에서 센 <strong>24비트 비트 위치</strong>가 비트열 안에 그대로 들어 있습니다. 읽은
    뒤 <code>$02:C0A1</code>에서 LoROM 주소로 바꿉니다. 시나리오 시작 주소 표(<code>$02:A627</code>)도 비트 위치이고,
    세이브 파일의 "어디까지 읽었나"도 바이트 주소에 바이트 안의 비트 번호를 더해 적습니다.
  </p>
  <h3>한글판 v1.0: 압축 대신 기호마다 2바이트</h3>
  <p>
    한글판 v1.0은 허프만 비트열을 버리고 기호마다 2바이트(큰 자리 먼저)로 적은 대본을 새로 넣었습니다. 읽는 루틴은{' '}
    <code>$02:C156</code>을 "허프만 트리 따라가기"에서 "2바이트 읽기"로 바꿨고, <code>$02:C087</code>·
    <code>$02:C106</code>에서 비트 위치를 주소로 바꾸던 계산을 건너뜁니다. 점프 인자도 비트 위치 대신 3바이트 LoROM
    주소(작은 자리 먼저)가 됐습니다. 같은 첫 문장 「여름의 해질녘.」과 줄바꿈은 기호 9개, 18바이트(144비트)입니다.
  </p>
  <div class="table-scroll" tabindex="0" role="region" aria-labelledby="ver-caption">
    <table>
      <caption id="ver-caption">일본판과 한글판 v1.0의 대본 비교</caption>
      <thead>
        <tr>
          <th scope="col"></th>
          <th scope="col">일본판</th>
          <th scope="col">한글판 v1.0</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">기호 하나</th>
          <td>5–19비트(허프만 부호)</td>
          <td>16비트</td>
        </tr>
        <tr>
          <th scope="row">첫 문장과 줄바꿈</th>
          <td>6기호 61비트</td>
          <td>9기호 144비트</td>
        </tr>
        <tr>
          <th scope="row">대본 전체</th>
          <td>약 246만 비트(약 30만 바이트)</td>
          <td>694,995바이트</td>
        </tr>
        <tr>
          <th scope="row">점프 위치</th>
          <td>기준점부터 비트 수(24비트)</td>
          <td>LoROM 주소(3바이트)</td>
        </tr>
        <tr>
          <th scope="row">놓인 곳</th>
          <td>$15:E401–(1MB 롬 안)</td>
          <td>$20:8000–(늘린 둘째 1MB)</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p>
    허프만 비트열을 그대로 쓰려면 한국어 대본의 글자 횟수로 트리를 새로 만들고, 트리 표 두 개를 새 글자 수에 맞게 다시
    넣고, 모든 점프 위치를 비트 단위로 다시 계산해야 합니다. 2바이트 대본은 이 일이 모두 필요 없고, 덤프·삽입 도구도
    바이트 단위로 단순해집니다. 대가는 크기입니다. 69만 바이트는 일본판 대본 자리(약 30만 바이트)에 들어가지 않아 v1.0은
    롬을 2MB로 늘리고 대본을 <code>$20:8000</code>부터 두었습니다. 롬을 늘릴 때 따져야 할 것은{' '}
    <a href={EXPANSION}>11장</a>에서 봅니다. 비워진 일본판 대본 자리(<code>$15:E401</code>–)는 나중에 v1.1·v1.2가 새
    코드와 표를 넣는 빈 공간이 됐습니다.
  </p>

  <h2 id="try">
    직접 해 보기 <span class="layer-badge layer-try">직접 해 보기</span>
  </h2>
  <p>
    kr-patch-toolkit에는 허프만 명령이 없습니다. 한 게임에만 쓰이는 형식은 툴킷이 아니라 그 게임의 패치 소스에 두기
    때문입니다. 제절초 패치 소스의 <code>tools/script.py</code>가 일본판 비트열을 읽습니다. 그 폴더에서 Python을 열고
    일본판 롬으로 첫 문장을 읽어 봅니다.
  </p>
  <pre tabindex="0"><code>&gt;&gt;&gt; import script
&gt;&gt;&gt; rom = open('otogirisou-j.sfc', 'rb').read()
&gt;&gt;&gt; r = script.JPReader(rom, 126)
&gt;&gt;&gt; [hex(r.sym()) for _ in range(6)]
['0x152', '0x62e', '0x50a', '0x5f6', '0x5c7', '0x1000']
&gt;&gt;&gt; r.pos
187
&gt;&gt;&gt; rom[0xAE410:0xAE418].hex(' ')
'63 04 90 fc aa 60 ef d3'</code></pre>
  <p>
    기호 여섯 개가 夏(<code>$152</code>), の(<code>$62E</code>), 夕, 暮, 。, 줄바꿈입니다. 위치가 126에서 187로 61비트
    나아갔습니다. <code>JPReader.sym()</code>은 위 그림처럼 비트 하나를 읽을 때마다 두 표 가운데 하나에서 16비트 값을
    읽고, 맨 위 비트가 켜진 값이 나오면 멈춥니다. 다른 게임의 허프만 대본도 트리를 두 표로 저장하는 형식이라면 비트
    순서, 표 위치, 리프 표시 비트, 루트 네 가지를 바꿔 이 코드로 읽어 볼 수 있습니다.
  </p>
</GuideChapter>

