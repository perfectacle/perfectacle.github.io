---
import Base from '../../../layouts/Base.astro';
import Comments from '../../../components/Comments.astro';
import Figure from '../../../components/romhacking/Figure.astro';
import GuideCrumbs from '../../../components/romhacking/GuideCrumbs.astro';
import '../../../styles/romhacking.css';
import { SITE } from '../../../lib/posts.ts';
import { breadcrumbs } from '../../../lib/structured-data.ts';
import {
  KR_PATCH_LIST_PATH,
  KR_PATCH_TOOLKIT_URL,
  KR_PATCH_TOOLKIT_VERSION,
  KR_PATCHES,
} from '../../../lib/kr-patches.ts';
import {
  GUIDE_CHAPTERS,
  GUIDE_PATH,
  GUIDE_TITLE,
  NOTE_GAME,
  NOTE_PATCHES,
  PLATFORM_LABEL,
  chapterBySlug,
  chapterLabel,
  chapterPath,
  chaptersForNote,
  noteGrid,
  noteHref,
  notePath,
} from '../../../components/romhacking/chapters.ts';
import { GLOSSARY, GLOSSARY_PATH } from '../../../components/romhacking/glossary.ts';

const description =
  '한글패치를 만들며 쓴 롬 해킹 지식을 처음부터 풀어 쓴 가이드입니다. 16진수와 엔디안부터 65c816 어셈블리, 뱅크와 매핑, 후킹, 타일과 폰트, 대사 형식, 압축과 롬 확장, 에뮬레이터로 확인하는 법, 사운드 구조와 게임 음악을 끊김 없이 반복하는 법까지 그림과 직접 만져 보는 도구로 배웁니다.';
const first = GUIDE_CHAPTERS.find(c => c.ready);
---

<Base
  title={GUIDE_TITLE}
  description={description}
  jsonLd={[breadcrumbs(SITE, [{ name: GUIDE_TITLE, path: GUIDE_PATH }])]}
>
  <div class="container guide">
    <GuideCrumbs here={{ kind: 'index' }} />
    <article data-pagefind-body>
      <header class="guide-head">
        <h1 data-pagefind-meta="title">{GUIDE_TITLE}</h1>
        <p class="guide-summary">
          이 블로그의 <a href={KR_PATCH_LIST_PATH}>한글패치</a>({KR_PATCHES.map(p => p.title).join(', ')})를 만들면서 쓴
          지식을 처음부터 풀어 쓴 가이드입니다. 16진수를 몰라도 그림으로 시작할 수 있고, 접어 둔 「더 깊이」를 펼치면
          실제로 롬을 고칠 수 있는 데까지 들어갑니다.
        </p>
      </header>

      <div class="prose">
        <h2 id="who">이런 분께 맞습니다</h2>
        <ul>
          <li>롬 해킹이 궁금하지만 "16진수", "뱅크", "어셈블리" 같은 말에서 막힌 사람</li>
          <li>
            아래 <a href="#notes">롬 분석 노트</a>를 읽다가 개념을 처음부터 알고 싶어진 사람
          </li>
          <li>직접 번역 패치를 만들어 보고 싶은 사람</li>
        </ul>
        <p>
          컴퓨터 구조를 미리 알 필요는 없습니다. 장마다 앞 장에서 배운 것만 씁니다. 처음이라면{' '}
          <a href={first ? chapterPath(first) : GUIDE_PATH}>0장</a>부터 차례로 읽어 주세요.
        </p>

        <h2 id="layers">한 장은 네 부분으로 되어 있습니다</h2>
        <p>
          같은 장 안에서 읽는 깊이를 고를 수 있습니다. 처음에는 「쉽게」만 읽고 넘어가도 다음 장을 따라오는 데 문제가
          없습니다.
        </p>
        <Figure caption="한 장을 이루는 네 부분. 위에서 아래로 갈수록 깊어집니다." max={520}>
          <svg viewBox="0 0 360 236" role="img" aria-labelledby="layers-t layers-d">
            <title id="layers-t">한 장의 네 부분</title>
            <desc id="layers-d">
              쉽게, 더 깊이, 실제 패치에서, 직접 해 보기 네 칸이 위에서 아래로 쌓여 있다. 쉽게는 늘 펼쳐져 있고 더
              깊이는 접혀 있다.
            </desc>
            <g>
              <rect class="dg-accent" x="8" y="8" width="344" height="50" rx="10"></rect>
              <text class="dg-text dg-bold" x="24" y="30">
                1 쉽게
              </text>
              <text class="dg-small" x="24" y="48">
                그림과 비유. 늘 펼쳐져 있습니다
              </text>
              <rect class="dg-cell" x="8" y="66" width="344" height="50" rx="10" stroke-dasharray="6 4"></rect>
              <text class="dg-text dg-bold" x="24" y="88">
                2 더 깊이
              </text>
              <text class="dg-small" x="24" y="106">
                접혀 있습니다. 공식·형식·예외까지
              </text>
              <rect class="dg-warm" x="8" y="124" width="344" height="50" rx="10"></rect>
              <text class="dg-text dg-bold" x="24" y="146">
                3 실제 패치에서
              </text>
              <text class="dg-small" x="24" y="164">
                한글패치 롬 분석 노트의 실제 주소·바이트
              </text>
              <rect class="dg-cool" x="8" y="182" width="344" height="50" rx="10"></rect>
              <text class="dg-text dg-bold" x="24" y="204">
                4 직접 해 보기
              </text>
              <text class="dg-small" x="24" y="222">
                krpatch 명령과 페이지 안 도구로 직접 해 봅니다
              </text>
            </g>
          </svg>
        </Figure>
        <ul>
          <li>
            <span class="layer-badge layer-easy">쉽게</span> 그림과 비유로 개념을 잡습니다. 늘 펼쳐져 있습니다.
          </li>
          <li>
            <span class="layer-badge layer-deep">더 깊이</span> 접혀 있습니다. 펼치면 공식, 데이터 형식, 예외 상황까지
            다룹니다.
          </li>
          <li>
            <span class="layer-badge layer-patch">실제 패치에서</span> 한글패치를 만들며 실제로 만난 주소와 바이트로
            같은 개념을 다시 봅니다.
          </li>
          <li>
            <span class="layer-badge layer-try">직접 해 보기</span> 페이지 안의 계산기·실행기를 만져 보거나,{' '}
            <a href={KR_PATCH_TOOLKIT_URL}>kr-patch-toolkit</a>의 <code>krpatch</code> 명령으로 따라 합니다.
          </li>
        </ul>

        <h2 id="chapters">차례</h2>
        <p>
          공통 장은 어느 게임기에나 해당하고, 슈퍼 패미컴 장은 그 게임기에 맞춘 내용입니다. 닌텐도 DS 장은 나중에
          붙입니다.
        </p>
        <ol class="chapter-map" start="0">
          {GUIDE_CHAPTERS.map(c => (
            <li class:list={{ 'is-ready': c.ready }}>
              <p class="chapter-meta">
                <span class="mono">{chapterLabel(c)}</span>
                <span class="chapter-platform">{PLATFORM_LABEL[c.platform]}</span>
                {!c.ready && <span class="chapter-soon">준비 중</span>}
              </p>
              <h3>{c.ready ? <a href={chapterPath(c)}>{c.title}</a> : c.title}</h3>
              <p class="chapter-summary">{c.summary}</p>
            </li>
          ))}
        </ol>

        <h2 id="notes">롬 분석 노트</h2>
        <p>
          한글패치 네 개를 만들며 롬에서 확인한 주소와 형식, 고친 코드, 확인 방법을 게임마다 적은 기록입니다. 노트의 각
          절에서 그 개념을 설명하는 장으로 건너갈 수 있습니다.
        </p>
        <ul class="note-map">
          {KR_PATCHES.map(p => (
            <li class="is-ready">
              <p class="chapter-meta">
                <span class="mono">노트</span>
                <span class="chapter-platform">{PLATFORM_LABEL.snes}</span>
                <span>한글패치 v{p.version}</span>
              </p>
              <h3>
                <a href={notePath(p)}>{p.title}</a>
              </h3>
              <p class="chapter-summary">
                이어지는 장:{' '}
                {chaptersForNote(p)
                  .map(c => chapterLabel(c))
                  .join(' · ')}
              </p>
            </li>
          ))}
        </ul>

        <h2 id="note-grid">장 × 게임 노트</h2>
        <p>
          장에서 배운 개념을 각 게임이 실제로 어떻게 썼는지, 노트의 해당 절로 바로 갑니다. 노트에 해당 절이 없는 칸에는
          그 이유를 적었습니다.
        </p>
        <table class="note-grid" role="table" aria-labelledby="note-grid">
          <thead role="rowgroup">
            <tr role="row">
              <th scope="col" role="columnheader">
                장
              </th>
              {NOTE_PATCHES.map(p => (
                <th scope="col" role="columnheader">
                  <a href={notePath(p)}>{NOTE_GAME[p.theme]}</a>
                </th>
              ))}
            </tr>
          </thead>
          <tbody role="rowgroup">
            {noteGrid().map(({ chapter, cells }) => (
              <tr role="row">
                <th scope="row" role="rowheader">
                  <a href={chapterPath(chapter)}>
                    <span class="mono">{chapterLabel(chapter)}</span> {chapter.title}
                  </a>
                </th>
                {cells.map(cell => (
                  <td role="cell" data-game={NOTE_GAME[cell.patch.theme]}>
                    {cell.notes.length > 0 ? (
                      <ul>
                        {cell.notes.map(n => (
                          <li>
                            <a href={noteHref(n)}>{n.label}</a>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <p class="note-grid-gap">
                        <span class="note-grid-none">해당 절 없음</span> {cell.gap}
                      </p>
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>

        <h2 id="glossary">용어집</h2>
        <p>
          읽다가 모르는 말이 나오면 <a href={GLOSSARY_PATH}>용어집</a>에서 찾아보세요. 가이드에 나오는 용어{' '}
          {GLOSSARY.length}개를 가나다순으로 모았고, 용어마다 그 말을 설명한 장으로 가는 링크가 있습니다.
        </p>

        <h2 id="tools">준비물</h2>
        <ul>
          <li>
            <strong>헥스 에디터</strong>: 파일을 바이트 단위로 보여 주는 프로그램입니다. 아무것이나 괜찮고,
            macOS·Linux라면 터미널의 <code>xxd</code>로도 충분합니다.
          </li>
          <li>
            <strong>kr-patch-toolkit</strong>: 이 패치들을 만들 때 쓴 명령 모음입니다. Python 3.15 이상에서{' '}
            <code>pip install git+https://github.com/perfectacle/kr-patch-toolkit@{KR_PATCH_TOOLKIT_VERSION}</code>으로
            설치합니다.
          </li>
          <li>
            <strong>에뮬레이터</strong>: 디버거가 있는 Mesen 2를 썼습니다.{' '}
            <a href={chapterPath(chapterBySlug('snes', 'emulator'))}>12장</a>에서 자세히 다룹니다.
          </li>
          <li>
            <strong>롬 파일</strong>: 이 가이드와 툴킷에는 롬이 들어 있지 않습니다. 직접 가진 카트리지에서 뽑은 롬으로
            따라 해 주세요.
          </li>
        </ul>
      </div>
    </article>
    <Comments path={GUIDE_PATH} />
  </div>
</Base>

<style>
  :is(.chapter-map, .note-map) {
    display: grid;
    gap: 10px;
    max-width: var(--measure);
    margin: 0 0 1.5em;
    padding: 0;
    list-style: none;
  }
  :is(.chapter-map, .note-map) li {
    margin: 0;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  :is(.chapter-map, .note-map) li.is-ready {
    border-left: 4px solid var(--accent);
  }
  :is(.chapter-map, .note-map) li:not(.is-ready) {
    background: var(--bg-soft);
  }
  .chapter-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin: 0;
    font-size: 0.8rem;
    color: var(--fg-muted);
  }
  .chapter-meta .mono {
    color: var(--accent);
    font-weight: 700;
  }
  .chapter-soon {
    padding: 0 8px;
    border: 1px solid var(--border);
    border-radius: 999px;
  }
  :is(.chapter-map, .note-map) h3 {
    margin: 2px 0 2px;
    font-size: 1.1rem;
  }
  :is(.chapter-map, .note-map) li:not(.is-ready) h3 {
    color: var(--fg-muted);
  }
  .chapter-summary {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.92rem;
  }

  .prose .note-grid {
    display: table;
    width: 100%;
    table-layout: fixed;
    font-size: 0.86rem;
    line-height: 1.5;
  }
  .note-grid :is(th, td) {
    vertical-align: top;
    padding: 8px 10px;
    overflow-wrap: anywhere;
  }
  .note-grid thead th:first-child {
    width: 17%;
  }
  .note-grid tbody th {
    font-weight: 600;
  }
  .note-grid .mono {
    display: block;
    color: var(--accent);
    font-weight: 700;
  }
  .note-grid ul {
    margin: 0;
    padding-left: 1.1em;
  }
  .note-grid li + li {
    margin-top: 0.35em;
  }
  .note-grid-gap {
    margin: 0;
    color: var(--fg-muted);
  }
  .note-grid-none {
    display: block;
    font-weight: 600;
  }
  /* Phones read each chapter as a card: the game names move from the header row into each cell. */
  @media (max-width: 760px) {
    .prose .note-grid,
    .note-grid :is(tbody, tr, th, td) {
      display: block;
      width: auto;
    }
    .note-grid thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .note-grid tr {
      margin-bottom: 12px;
      border: 1px solid var(--border);
      border-left: 4px solid var(--accent);
      border-radius: var(--radius);
    }
    .note-grid :is(tbody th, td) {
      border: 0;
    }
    .note-grid :is(th, td) + td {
      border-top: 1px solid var(--border);
    }
    .note-grid td::before {
      content: attr(data-game);
      display: block;
      margin-bottom: 2px;
      font-weight: 700;
      font-size: 0.8rem;
      color: var(--fg-muted);
    }
    .note-grid .mono {
      display: inline;
    }
  }
</style>
