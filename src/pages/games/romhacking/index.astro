---
import ChapterLink from '../../../components/romhacking/ChapterLink.astro';
import Base from '../../../layouts/Base.astro';
import Comments from '../../../components/Comments.astro';
import Figure from '../../../components/romhacking/Figure.astro';
import GuideCrumbs from '../../../components/romhacking/GuideCrumbs.astro';
import '../../../styles/romhacking.css';
import { SITE } from '../../../lib/posts.ts';
import { breadcrumbs } from '../../../lib/structured-data.ts';
import {
  KR_PATCH_LIST_PATH,
  KR_PATCH_TOOLKIT_URL,
  KR_PATCH_TOOLKIT_VERSION,
  PLATFORMS,
} from '../../../lib/kr-patches.ts';
import {
  GUIDE_PATH,
  GUIDE_TITLE,
  NOTE_PATCHES,
  TRACKS,
  TRACK_ORDER,
  chaptersForNote,
  notePath,
  trackChapters,
  trackPatches,
  type GuideChapter,
} from '../../../components/romhacking/chapters.ts';
import { GLOSSARY, GLOSSARY_PATH } from '../../../components/romhacking/glossary.ts';

const description =
  '한글패치를 만들며 쓴 롬 해킹 지식을 처음부터 풀어 쓴 가이드입니다. 16진수와 엔디안부터 65c816 어셈블리, 뱅크와 매핑, 후킹, 타일과 폰트, 대사 형식, 압축과 롬 확장, 에뮬레이터로 확인하는 법, 사운드 구조와 게임 음악을 끊김 없이 반복하는 법, 닌텐도 DS 롬의 파일 시스템까지 그림과 직접 만져 보는 도구로 배웁니다.';
/** 「공통 1·3장, 슈퍼 패미콤 2·4장」: one track name per run of chapters. */
const chapterRun = (chapters: GuideChapter[]) =>
  TRACK_ORDER.map(id => ({ id, numbers: chapters.filter(c => c.platform === id).map(c => c.number) }))
    .filter(run => run.numbers.length > 0)
    .map(run => `${TRACKS[run.id].short} ${run.numbers.join('·')}장`)
    .join(', ');
---

<Base
  title={GUIDE_TITLE}
  description={description}
  jsonLd={[breadcrumbs(SITE, [{ name: GUIDE_TITLE, path: GUIDE_PATH }])]}
>
  <div class="container guide">
    <GuideCrumbs here={{ kind: 'index' }} />
    <article data-pagefind-body>
      <header class="guide-head">
        <h1 data-pagefind-meta="title">{GUIDE_TITLE}</h1>
        <p class="guide-summary">
          이 블로그의 <a href={KR_PATCH_LIST_PATH}>한글패치</a>({NOTE_PATCHES.map(p => p.title).join(', ')})를 만들면서
          쓴 지식을 처음부터 풀어 쓴 가이드입니다. 16진수를 몰라도 그림으로 시작할 수 있고, 접어 둔 「더 깊이」를 펼치면
          실제로 롬을 고칠 수 있는 데까지 들어갑니다.
        </p>
      </header>

      <div class="prose">
        <h2 id="who">이런 분께 맞습니다</h2>
        <ul>
          <li>롬 해킹이 궁금하지만 "16진수", "뱅크", "어셈블리" 같은 말에서 막힌 사람</li>
          <li>
            아래 <a href="#notes">롬 분석 노트</a>를 읽다가 개념을 처음부터 알고 싶어진 사람
          </li>
          <li>직접 번역 패치를 만들어 보고 싶은 사람</li>
        </ul>
        <p>
          컴퓨터 구조를 미리 알 필요는 없습니다. 장마다 앞 장의 내용을 바탕으로 씁니다. 처음이라면{' '}
          <ChapterLink to="common/rom-patch" title />
          부터 차례로 읽어 주세요.
        </p>

        <h2 id="layers">한 장은 네 부분으로 되어 있습니다</h2>
        <p>
          같은 장 안에서 읽는 깊이를 고를 수 있습니다. 처음에는 「쉽게」만 읽고 넘어가도 다음 장을 따라오는 데 문제가
          없습니다.
        </p>
        <Figure caption="한 장을 이루는 네 부분. 위에서 아래로 갈수록 깊어집니다." max={520}>
          <svg viewBox="0 0 360 236" role="img" aria-labelledby="layers-t layers-d">
            <title id="layers-t">한 장의 네 부분</title>
            <desc id="layers-d">
              쉽게, 더 깊이, 실제 패치에서, 직접 해 보기 네 칸이 위에서 아래로 쌓여 있다. 쉽게는 늘 펼쳐져 있고 더
              깊이는 접혀 있다.
            </desc>
            <g>
              <rect class="dg-accent" x="8" y="8" width="344" height="50" rx="10"></rect>
              <text class="dg-text dg-bold" x="24" y="30">
                1 쉽게
              </text>
              <text class="dg-small" x="24" y="48">
                그림과 비유. 늘 펼쳐져 있습니다
              </text>
              <rect class="dg-cell" x="8" y="66" width="344" height="50" rx="10" stroke-dasharray="6 4"></rect>
              <text class="dg-text dg-bold" x="24" y="88">
                2 더 깊이
              </text>
              <text class="dg-small" x="24" y="106">
                접혀 있습니다. 공식·형식·예외까지
              </text>
              <rect class="dg-warm" x="8" y="124" width="344" height="50" rx="10"></rect>
              <text class="dg-text dg-bold" x="24" y="146">
                3 실제 패치에서
              </text>
              <text class="dg-small" x="24" y="164">
                한글패치 롬 분석 노트의 실제 주소·바이트
              </text>
              <rect class="dg-cool" x="8" y="182" width="344" height="50" rx="10"></rect>
              <text class="dg-text dg-bold" x="24" y="204">
                4 직접 해 보기
              </text>
              <text class="dg-small" x="24" y="222">
                krpatch 명령과 페이지 안 도구로 직접 해 봅니다
              </text>
            </g>
          </svg>
        </Figure>
        <ul>
          <li>
            <span class="layer-badge layer-easy">쉽게</span> 그림과 비유로 개념을 잡습니다. 늘 펼쳐져 있습니다.
          </li>
          <li>
            <span class="layer-badge layer-deep">더 깊이</span> 접혀 있습니다. 펼치면 공식, 데이터 형식, 예외 상황까지
            다룹니다.
          </li>
          <li>
            <span class="layer-badge layer-patch">실제 패치에서</span> 한글패치를 만들며 실제로 만난 주소와 바이트로
            같은 개념을 다시 봅니다.
          </li>
          <li>
            <span class="layer-badge layer-try">직접 해 보기</span> 페이지 안의 계산기·실행기를 만져 보거나,{' '}
            <a href={KR_PATCH_TOOLKIT_URL}>kr-patch-toolkit</a>의 <code>krpatch</code> 명령으로 따라 합니다.
          </li>
        </ul>

        <h2 id="tracks">세 갈래</h2>
        <p>
          가이드는 세 갈래로 나뉘고, 갈래마다 1장부터 셉니다. 처음이라면{' '}
          <a href={TRACKS.common.path}>{TRACKS.common.name}</a>부터 읽고, 고칠 게임기의 갈래로 넘어가세요. 다른 갈래의
          장을 가리킬 때는 「공통 3장」, 「DS 2장」처럼 갈래 이름을 붙입니다.
        </p>
        <ul class="track-map">
          {TRACK_ORDER.map(id => (
            <li class="is-ready">
              <p class="chapter-meta">
                <span class="mono">{trackChapters(id).length}장</span>
                {id === 'common' && <span class="chapter-platform">여기서 시작</span>}
              </p>
              <h3>
                <a href={TRACKS[id].path}>{TRACKS[id].name}</a>
              </h3>
              <p class="chapter-summary">{TRACKS[id].summary}</p>
            </li>
          ))}
        </ul>

        <h2 id="notes">롬 분석 노트</h2>
        <p>
          한글패치 {NOTE_PATCHES.length}개를 만들며 롬에서 확인한 주소와 형식, 고친 코드, 확인 방법을 게임마다 적은
          기록입니다. 노트의 각 절에서 그 개념을 설명하는 장으로 건너갈 수 있습니다.
        </p>
        {(['sfc', 'nds'] as const).map(platform => (
          <>
            <h3 id={`notes-${platform}`}>{PLATFORMS[platform].name}</h3>
            <ul class="note-map">
              {trackPatches(platform).map(p => (
                <li class="is-ready">
                  <p class="chapter-meta">
                    <span class="mono">노트</span>
                    <span>한글패치 v{p.version}</span>
                  </p>
                  <h4>
                    <a href={notePath(p)}>{p.title}</a>
                  </h4>
                  <p class="chapter-summary">이어지는 장: {chapterRun(chaptersForNote(p))}</p>
                </li>
              ))}
            </ul>
          </>
        ))}

        <h2 id="glossary">용어집</h2>
        <p>
          읽다가 모르는 말이 나오면 <a href={GLOSSARY_PATH}>용어집</a>에서 찾아보세요. 가이드에 나오는 용어{' '}
          {GLOSSARY.length}개를 가나다순으로 모았고, 용어마다 그 말을 설명한 장으로 가는 링크가 있습니다.
        </p>

        <h2 id="tools">준비물</h2>
        <ul>
          <li>
            <strong>헥스 에디터</strong>: 파일을 바이트 단위로 보여 주는 프로그램입니다. 아무것이나 괜찮지만,
            Windows·macOS·Linux에서 모두 돌아가고 꾸준히 업데이트되는 <a href="https://imhex.werwolv.net/">ImHex</a>를
            추천합니다. macOS·Linux라면 터미널의 <code>xxd</code>로도 충분합니다.
          </li>
          <li>
            <strong>
              <a href={KR_PATCH_TOOLKIT_URL}>kr-patch-toolkit</a>
            </strong>
            : 이 패치들을 만들 때 쓴 명령 모음입니다. Python 3.15 이상에서{' '}
            <code>pip install git+https://github.com/perfectacle/kr-patch-toolkit@{KR_PATCH_TOOLKIT_VERSION}</code>으로
            설치합니다.
          </li>
          <li>
            <strong>에뮬레이터</strong>: 게임기마다 다른 에뮬레이터를 썼습니다.
            <ul>
              <li>
                슈퍼 패미콤: 디버거가 있는 <a href="https://github.com/nesdev-org/MesenCE">MesenCE</a>.{' '}
                <ChapterLink to="sfc/emulator" />
                에서 자세히 다룹니다.
              </li>
              <li>
                닌텐도 DS: <a href="https://github.com/libretro/desmume">libretro desmume 코어</a>.{' '}
                <ChapterLink to="nds/emulator" />
                에서 자세히 다룹니다.
              </li>
            </ul>
          </li>
          <li>
            <strong>롬 파일</strong>: 이 가이드와 툴킷에는 롬이 들어 있지 않습니다. 직접 가진 카트리지에서 뽑은 롬으로
            따라 해 주세요.
          </li>
        </ul>
      </div>
    </article>
    <Comments path={GUIDE_PATH} />
  </div>
</Base>
