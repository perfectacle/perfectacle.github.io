];
const ASSEMBLY = chapterPath(chapterBySlug('sfc', 'assembly'));
const BANKS = chapterPath(chapterBySlug('sfc', 'banks'));
const HOOKING = chapterPath(chapterBySlug('sfc', 'hooking'));
const EMULATOR = chapterPath(chapterBySlug('sfc', 'emulator'));
const NUMBERS = chapterPath(chapterBySlug('common', 'numbers'));
const ENDIAN = chapterPath(chapterBySlug('common', 'endian'));
const LZSS = chapterPath(chapterBySlug('common', 'lzss'));
const MUSIC = chapterPath(chapterBySlug('common', 'music-loop'));

const aram = [
  { range: '$0000–$00EF', size: '240바이트', what: '제로 페이지: 드라이버의 변수' },
  { range: '$00F0–$00FF', size: '16바이트', what: 'SPC700 레지스터: 포트 $F4–$F7, DSP 창구 $F2·$F3, 타이머' },
  { range: '$0100–$01FF', size: '256바이트', what: '스택' },
  { range: '$0800–$1920', size: '4,385바이트', what: '사운드 드라이버(11프레임에 올림)' },
  {
    range: '$1B00–$1BFF',
    size: '256바이트',
    what: '26프레임에 올림. 샘플 목록으로 보이는 자리로, 곡을 바꿀 때 $1B50부터 4바이트씩 고쳐 씀',
  },
  { range: '$1C00–$1D7F', size: '384바이트', what: '63프레임에 올린 블록' },
  {
    range: '$1E00–$1E5D',
    size: '94바이트',
    what: '18프레임에 $1E00부터 8바이트, 19프레임에 $1E02부터 92바이트를 겹쳐 올림. 곡을 바꿀 때 $1E00–$1E01을 다시 씀',
  },
  { range: '$1F00–$2F26', size: '4,135바이트', what: '19프레임에 올린 블록' },
  { range: '$3000–$3891', size: '2,194바이트', what: '곡 데이터(곡을 바꿀 때마다 새로 올림)' },
  { range: '$4000–$9F21', size: '24,354바이트', what: '26–62프레임에 올린 큰 블록' },
  { range: '$A000–$D284', size: '12,933바이트', what: '이 곡의 악기 샘플 여섯 개(BRR)' },
  { range: '$FFC0–$FFFF', size: '64바이트', what: 'IPL 롬(켜 두면 이 자리에서는 RAM 대신 롬이 읽힘)' },
];

const probes = [
  {
    file: 'probe/apuports.lua',
    env: 'APUF, APUPORTS, MAXF',
    out: 'apuports.txt',
    text: 'S-CPU가 $2140–$2143에 쓴 값이 바뀔 때마다 프레임, 주소, 값, 프로그램 뱅크(PB)와 PC를 한 줄씩',
  },
  {
    file: 'probe/voices.lua',
    env: 'VSTEP, MAXF',
    out: 'voices.txt',
    text: 'VSTEP프레임(기본 6)마다 S-DSP 음성 여덟 개의 엔벨로프 크기',
  },
  {
    file: 'probe/calls.lua',
    env: 'CALLS, LIMIT, MAXF',
    out: 'calls.txt',
    text: 'CALLS에 적은 주소가 실행될 때마다 A, X, Y와 돌아갈 주소',
  },
