import { TOOLKIT_LUA } from '../../../../components/kr-patch/source-links.ts';

const FULLSNES = 'https://problemkaputt.de/fullsnes.htm';
const SNESDEV = 'https://snes.nesdev.org/wiki';
const references = [
  {
    href: `${FULLSNES}#snesapumemoryandiomap`,
    label: 'fullsnes, SNES APU Memory and I/O Map',
    note: 'SPC700 메모리 지도($0000–$00EF, $00F0–$00FF 레지스터, $0100–$01FF 스택, $FFC0–$FFFF IPL 롬), 포트 $2140–$2143이 SPC700 쪽 $F4–$F7과 이어진다는 것, 포트 말고는 주고받을 길이 없다는 것, DSP 레지스터 128개 목록',
