---
import GuideChapter from '../../../../layouts/GuideChapter.astro';
import Deeper from '../../../../components/romhacking/Deeper.astro';
import Figure from '../../../../components/romhacking/Figure.astro';
import { KAKUSEI_PATCH, OTOGIRISOU_PATCH, SMRPG_PATCH, TOTSUGEKI_PATCH } from '../../../../lib/kr-patches.ts';
import { chapterHref, notePath } from '../../../../components/romhacking/chapters.ts';

const references = [
  {
    href: 'https://github.com/perfectacle/kr-patches/blob/super-mario-rpg-v1.2/snes/super-mario-rpg/data/tbl/korTBL.utf8.tbl',
    label: 'kr-patches, super-mario-rpg/data/tbl/korTBL.utf8.tbl',
    note: '이 장에 옮긴 .tbl 글자표 줄(1바이트·2바이트 코드=글자)',
  },
  {
    href: 'https://www.westerndesigncenter.com/wdc/documentation/w65c816s.pdf',
    label: 'WDC, W65C816S 데이터시트',
    note: '포인터를 읽는 긴 주소 지정(LDA $A88000,X)과 간접 주소',
  },
  {
    href: 'https://problemkaputt.de/fullsnes.htm#snescartlorommappingromdividedinto32kbanksaround1500games',
    label: 'fullsnes, SNES Cart LoROM Mapping',
    note: '뱅크마다 32KB인 LoROM에서 2바이트 포인터가 닿는 범위',
  },
  {
    href: 'https://github.com/perfectacle/kr-patches/blob/main/README.ko.md',
    label: 'kr-patches, snes/*/docs/ANALYSIS.ko.md',
    note: '네 게임의 대사 형식, 포인터 표 주소, 다시 배치한 결과',
  },
];
const encodings = [
  {
    game: '돌격편',
    rule: '글자마다 2바이트, 작은 자리 먼저',
    chars: [
      ['F3 08', '$08F3', '어'],
      ['B5 06', '$06B5', '떻'],
      ['27 05', '$0527', '게'],
    ],
  },
  {
    game: '제절초 한글패치',
    rule: '글자마다 2바이트, 큰 자리 먼저(코드는 10진수로 적은 표)',
    chars: [
      ['01 D8', '472', '여'],
      ['04 85', '1157', '름'],
      ['03 C0', '960', '날'],
    ],
  },
  {
    game: '슈퍼 마리오 RPG',
    rule: '자주 쓰는 글자는 1바이트, 나머지는 1D-1F로 시작하는 2바이트',
    chars: [
      ['21', '$21', '!'],
      ['1D 07', '$1D07', '획'],
      ['1D 22', '$1D22', '득'],
    ],
  },
];
const growth = [
  {
    name: '제자리에서 고치기',
    who: '슈퍼 마리오 RPG 전투 메시지',
    text: '문자열 뒤에 남는 0 바이트 안에서만 늘립니다. 옮길 빈 곳이 없을 때 씁니다.',
  },
  {
    name: '뱅크를 처음부터 다시 채우기',
    who: '돌격편, 슈퍼 마리오 RPG 대사',
    text: '한 뱅크의 문자열을 모두 새로 쓰고, 같은 문자열은 하나만 둔 뒤 포인터 표를 새로 만듭니다.',
  },
  {
    name: '같은 뱅크의 빈 곳으로 옮기기',
    who: '각성편',
    text: '안 들어가는 줄만 같은 뱅크 끝의 빈 곳(FF)으로 옮기고 그 포인터만 고칩니다.',
  },
  {
    name: '늘린 롬으로 통째로 옮기기',
    who: '제절초',
    text: '롬을 늘려 새 뱅크에 대본 전체를 두고, 대본을 읽는 코드를 바꿉니다.',
  },
];
---

<GuideChapter platform="sfc" slug="text" references={references}>
  <h2 id="table">
    글자표: 바이트 값과 글자 대응표 <span class="layer-badge layer-easy">쉽게</span>
  </h2>
  <p>
    롬 안의 대사는 글자가 아니라 숫자입니다. 게임은 숫자를 받아 폰트의 그 번호 그림을 화면에 찍을 뿐이고, 어느 번호가
    어떤 글자인지는 게임마다 제멋대로 정합니다. 그래서 대사를 읽거나 고치려면 "이 번호는 이 글자"를 적은 사전이 먼저
    있어야 합니다. 이것을 <strong>글자표</strong>라고 하고, 롬 해킹 도구들은 흔히 <code>.tbl</code> 파일로 적습니다.
  </p>
  <pre tabindex="0"><code>21=!
76=를
8F=을
1D07=획
1D22=득</code></pre>
  <p class="muted">슈퍼 마리오 RPG 한글패치 v1.0의 대사 글자표(korTBL.utf8.tbl)에서 고른 줄입니다.</p>
  <p>
    줄마다 왼쪽이 롬의 바이트(16진수), 오른쪽이 글자입니다. 이 표가 있으면 바이트를 글자로 바꿔 읽고(덤프), 번역한
    문장을 다시 바이트로 바꿔 넣을(삽입) 수 있습니다. 원래 게임의 글자표는 없으니, 롬 해커가 화면에 나온 글자와 롬의
    바이트를 맞춰 보며 직접 만듭니다. 한글패치를 이어서 고칠 때도 앞선 패치의 표가 남아 있지 않으면 폰트 그림을 읽어
    표를 다시 만들어야 합니다.
  </p>
  <Figure caption="슈퍼 마리오 RPG 대사 $204의 바이트를 글자표로 읽으면 「<아이템 이름>」을 획득!" max={600}>
    <svg viewBox="0 0 360 180" role="img" aria-labelledby="tbl-t tbl-d">
      <title id="tbl-t">바이트를 글자표로 읽기</title>
      <desc id="tbl-d">
        바이트 1B 07, 20, 1D 07, 1D 22, 21, 00을 차례로 읽는다. 1B 07은 이름을 넣는 제어 코드, 20은 빈칸, 1D 07은 획, 1D
        22는 득, 21은 느낌표, 00은 대사 끝이다.
      </desc>
      {[
        ['1B 07', 'dg-accent', '이름 넣기'],
        ['20', 'dg-cell', '빈칸'],
        ['1D 07', 'dg-cell', '획'],
        ['1D 22', 'dg-cell', '득'],
        ['21', 'dg-cell', '!'],
        ['00', 'dg-accent', '끝'],
      ].map(([b, c, t], i) => {
        const widths = [72, 40, 72, 72, 40, 40];
        const x = 8 + widths.slice(0, i).reduce((a, w) => a + w + 4, 0);
        const w = widths[i] ?? 40;
        return (
          <>
            <rect class={c} x={x} y="20" width={w} height="36" rx="5" />
            <text class="dg-mono dg-bold" x={x + w / 2} y="43" text-anchor="middle">
              {b}
            </text>
            <path class="dg-arrow" d={`M${x + w / 2} 58V82`} marker-end="url(#dg-arrowhead)" />
            <text class="dg-text" x={x + w / 2} y="104" text-anchor="middle">
              {t}
            </text>
          </>
        );
      })}
      <text class="dg-small" x="8" y="12">
        롬 바이트($E2:041A, 파일 0x22041A)
      </text>
      <rect class="dg-accent" x="8" y="128" width="344" height="40" rx="6"></rect>
      <text class="dg-text" x="18" y="153">
        화면 예: 「버섯」을 획득! (이름은 실행 중에 채움)
      </text>
    </svg>
  </Figure>

  <h2 id="width">
    1바이트 글자, 2바이트 글자 <span class="layer-badge layer-easy">쉽게</span>
  </h2>
  <p>
    1바이트로는 256가지밖에 적지 못해서, 한자나 한글을 쓰는 게임은 대개 글자 하나에 2바이트를 씁니다. 같은 2바이트라도
    어느 쪽 바이트를 먼저 적는지(<a href={chapterHref(2)}>2장</a>의 엔디안), 1바이트 글자와 섞어 쓰는지가 게임마다
    다릅니다.
  </p>
  {encodings.map(e => (
    <>
      <p class="enc-name">
        <strong>{e.game}</strong> <span class="muted">{e.rule}</span>
      </p>
      <ul class="byte-strip" aria-label={`${e.game}: ${e.chars.map(([b, , ch]) => `${b} = ${ch}`).join(', ')}`}>
        {e.chars.map(([b, code, ch]) => (
          <li>
            <code>{b}</code>
            <small>
              {code} {ch}
            </small>
          </li>
        ))}
      </ul>
    </>
  ))}
  <p>
    슈퍼 마리오 RPG처럼 섞어 쓰는 게임은 첫 바이트를 보고 길이를 압니다. 이 게임에서 <code>$20</code>–<code>$FF</code>는
    그대로 글자 하나이고, <code>$1D</code>–<code>$1F</code>가 나오면 "다음 바이트와 합쳐 한 글자"라는 뜻입니다. 첫
    바이트가 묶음 번호, 둘째 바이트가 묶음 안 번호인 셈입니다.
  </p>
  <ul class="byte-strip" aria-label="1D 07: 묶음 1D의 07번 글자, 획">
    <li class="is-warm">
      <code>1D</code>
      <small>묶음</small>
    </li>
    <li class="is-cool">
      <code>07</code>
      <small>묶음 안 번호</small>
    </li>
    <li class="is-accent">
      <code>획</code>
      <small>글리프 $E7</small>
    </li>
  </ul>
  <p>
    폰트에서 찾을 때는 1바이트 글자 <code>c</code>가 <code>c − $20</code>번 그림이고, 2바이트 글자는{' '}
    <code>$E0 + (첫 바이트 − $1D) × $100 + 둘째 바이트</code>번 그림입니다. <code>1D 07</code>이면 <code>$E7</code>번,
    1바이트 글자 224개 바로 뒤입니다.
  </p>

  <h2 id="control">
    제어 코드: 글자가 아닌 명령 <span class="layer-badge layer-easy">쉽게</span>
  </h2>
  <p>
    대사에는 글자만 있지 않습니다. 줄을 바꾸거나, 버튼을 누를 때까지 기다리거나, 주인공 이름을 끼워 넣거나, 음악을 트는
    명령도 섞여 있습니다. 이런 바이트를 <strong>제어 코드</strong>라고 합니다. 이 가이드의 도구는 덤프한 대본에 제어
    코드를 <code>{'{16}'}</code> 같은 중괄호 표시로 적어 글자와 구별합니다. 제어 코드 뒤에 인자가 몇 바이트 붙는지도
    코드마다 정해져 있어서, 이것을 모르면 인자를 글자로 읽어 그 뒤가 전부 어긋납니다.
  </p>
  <Figure caption="제절초 한글패치 대본의 첫머리. 제어 코드 넷 다음에 첫 문장이 나옵니다." max={600}>
    <svg viewBox="0 0 360 250" role="img" aria-labelledby="ctl-t ctl-d">
      <title id="ctl-t">제어 코드와 인자</title>
      <desc id="ctl-d">
        파일 0x100000부터 10 3A 00 0F 00 27은 소리 페이드 인 코드 3A와 인자 15, 39다. 10 32 00 10 00 01은 장면 코드 32와
        인자 16, 1, 10 22 00 00 00 07과 10 22 00 01 00 01은 변수를 정하는 코드 22다. 그 뒤 01 D8은 여, 04 85는 름이다.
      </desc>
      {[
        ['10 3A', '00 0F 00 27', '{3A:15,39}', '소리 페이드 인'],
        ['10 32', '00 10 00 01', '{32:16,1}', '장면(배경)'],
        ['10 22', '00 00 00 07', '{22:0,7}', '변수 0을 7로'],
        ['10 22', '00 01 00 01', '{22:1,1}', '변수 1을 1로'],
      ].map(([code, args, name, what], i) => (
        <>
          <rect class="dg-warm" x="8" y={8 + i * 44} width="58" height="34" rx="5" />
          <text class="dg-mono dg-bold" x="37" y={30 + i * 44} text-anchor="middle">
            {code}
          </text>
          <rect class="dg-cell" x="70" y={8 + i * 44} width="112" height="34" rx="5" />
          <text class="dg-mono" x="126" y={30 + i * 44} text-anchor="middle">
            {args}
          </text>
          <text class="dg-mono" x="192" y={24 + i * 44}>
            {name}
          </text>
          <text class="dg-small" x="192" y={38 + i * 44}>
            {what}
          </text>
        </>
      ))}
      <rect class="dg-cool" x="8" y="184" width="58" height="34" rx="5"></rect>
      <text class="dg-mono dg-bold" x="37" y="206" text-anchor="middle">
        01 D8
      </text>
      <rect class="dg-cool" x="70" y="184" width="58" height="34" rx="5"></rect>
      <text class="dg-mono dg-bold" x="99" y="206" text-anchor="middle">
        04 85
      </text>
      <text class="dg-text" x="140" y="206">
        … 여름날 해 질 녘.
      </text>
      <text class="dg-small" x="8" y="240">
        10으로 시작하는 2바이트 = 제어 코드, 그 뒤 = 인자
      </text>
    </svg>
  </Figure>
  <p>
    제절초는 기호 값 <code>$1000</code>–<code>$1046</code>을 제어 코드로 씁니다. <code>{'{3A:15,39}'}</code>는 코드{' '}
    <code>$3A</code>에 인자 둘이 붙은 것이고, 인자도 대개 2바이트씩입니다. 점프할 곳만 3바이트 주소입니다. 슈퍼 마리오
    RPG는 <code>00</code>이 대사 끝, <code>01</code>이 줄바꿈, <code>02</code>–<code>04</code>가 창 넘김,{' '}
    <code>1A</code>가 아이템 이름 넣기입니다. 돌격편은 <code>$000A</code>가 줄바꿈, <code>$0000</code>이 끝입니다.
  </p>
  <p>
    한국어 번역에 특히 중요한 것은 <strong>이름 넣기</strong> 코드입니다. 아이템 이름이 들어갈 자리 뒤에 붙을 조사가
    이름의 받침에 따라 「을」·「를」로 바뀌어야 하기 때문입니다. 슈퍼 마리오 RPG 한글패치는 쓰이지 않던 코드{' '}
    <code>$1B</code>를 이름을 넣는 코드로 바꾸고, 뒤의 플래그 바이트에 따라 「」, 가운데 정렬, 받침에 맞는 을/를을
    붙이게 했습니다(위 그림의 <code>1B 07</code>은 셋 다 켠 것).
  </p>

  <h2 id="pointers">
    포인터 표: 대사 번호로 위치 찾기 <span class="layer-badge layer-easy">쉽게</span>
  </h2>
  <p>
    대사는 길이가 제각각이라 "6번 대사는 몇 번째 바이트부터"를 계산으로 알 수 없습니다. 그래서 대사마다 시작 주소를 적어
    둔 <strong>포인터 표</strong>를 따로 둡니다. 책의 목차처럼, 대사 번호로 표를 찾아 주소를 읽고 그 주소로 갑니다.
  </p>
  <Figure caption="돌격편 대사 $006: 번호 → 뱅크 → 포인터 → 문자열" max={600}>
    <svg viewBox="0 0 360 280" role="img" aria-labelledby="ptr-t ptr-d">
      <title id="ptr-t">포인터 표 따라가기</title>
      <desc id="ptr-d">
        대사 $006은 $000-$25B 범위라 뱅크 $A8의 표 $A8:8000을 쓴다. $A8:8000 + $006 × 2 = $A8:800C에 FE 85가 있어 주소
        $85FE다. 같은 뱅크의 $A8:85FE부터 F3 08 어, B5 06 떻, 27 05 게, 0A 00 줄바꿈, … 00 00 끝이 이어진다.
      </desc>
      <rect class="dg-cell" x="8" y="8" width="112" height="40" rx="6"></rect>
      <text class="dg-small" x="16" y="24">
        대사 번호
      </text>
      <text class="dg-mono dg-bold" x="16" y="42">
        $006
      </text>
      <path class="dg-arrow" d="M120 28H144" marker-end="url(#dg-arrowhead)"></path>
      <rect class="dg-warm" x="150" y="8" width="202" height="40" rx="6"></rect>
      <text class="dg-small" x="158" y="24">
        $000-$25B는 뱅크 $A8
      </text>
      <text class="dg-mono" x="158" y="42">
        표 $A8:8000
      </text>
      <path class="dg-arrow" d="M250 48V66" marker-end="url(#dg-arrowhead)"></path>
      <text class="dg-small" x="8" y="84">
        $A8:8000 + $006 × 2 = $A8:800C
      </text>
      {['8000', '8002', '8004', '8006', '8008', '800A', '800C'].map((a, i) => (
        <>
          <rect class={i === 6 ? 'dg-cool' : 'dg-cell'} x={8 + i * 49} y="92" width="46" height="40" rx="4" />
          <text class="dg-small" x={31 + i * 49} y="108" text-anchor="middle">
            {a}
          </text>
          <text class={i === 6 ? 'dg-mono dg-bold' : 'dg-mono'} x={31 + i * 49} y="126" text-anchor="middle">
            {i === 6 ? 'FE 85' : '…'}
          </text>
        </>
      ))}
      <path class="dg-arrow" d="M325 132V152" marker-end="url(#dg-arrowhead)"></path>
      <text class="dg-small" x="8" y="166">
        FE 85 = $85FE → 같은 뱅크의 $A8:85FE (파일 0x1405FE)
      </text>
      {[
        ['F3 08', '어'],
        ['B5 06', '떻'],
        ['27 05', '게'],
        ['0A 00', '줄'],
        ['A1 09', '잡'],
        ['C6 08', '아'],
      ].map(([b, t], i) => (
        <>
          <rect class={t === '줄' ? 'dg-warm' : 'dg-cell'} x={8 + i * 58} y="176" width="54" height="40" rx="4" />
          <text class="dg-mono" x={35 + i * 58} y="200" text-anchor="middle">
            {b}
          </text>
          <text class="dg-text" x={35 + i * 58} y="236" text-anchor="middle">
            {t === '줄' ? '줄바꿈' : t}
          </text>
        </>
      ))}
      <rect class="dg-accent" x="8" y="248" width="344" height="28" rx="6"></rect>
      <text class="dg-text" x="18" y="267">
        어떻게 / 잡아 볼까‥ (00 00에서 끝)
      </text>
    </svg>
  </Figure>
  <p>
    포인터 <code>FE 85</code>는 작은 자리가 먼저라 <code>$85FE</code>입니다. 포인터가 2바이트뿐이라 뱅크 번호가 없고,
    표가 있는 뱅크 <code>$A8</code>을 그대로 붙여 읽습니다. 그래서 이 대사는{' '}
    <strong>뱅크 $A8 밖으로 옮길 수 없습니다.</strong> 이 한계가 번역문을 넣을 자리를 정합니다(아래 「번역이
    길어지면」).
  </p>
  <p>
    포인터 표를 찾는 가장 확실한 방법은 대사를 읽는 코드를 찾는 것입니다. 돌격편은 <code>$81:AC4C</code>가 대사 번호를{' '}
    <code>CMP #$14AD</code>, <code>CMP #$121F</code>… 차례로 비교해 뱅크를 고르고, <code>LDA $A88000,X</code>처럼 그
    뱅크의 표를 읽습니다. 코드를 모를 때는 2바이트마다 점점 커지는 값이 이어진 곳(문자열 시작 주소들을 리틀 엔디안으로
    적은 표)을 롬에서 찾아봅니다.
  </p>

  <h2 id="stream">
    번호 없이 한 줄로 이어진 대사 <span class="layer-badge layer-easy">쉽게</span>
  </h2>
  <p>
    모든 게임이 대사를 번호로 부르지는 않습니다. 사운드 노벨인 제절초는 게임 전체가 하나로 이어진 <strong>대본</strong>{' '}
    입니다. 엔진은 지금 읽는 위치(WRAM <code>$52</code>–<code>$54</code>, 24비트)부터 글자를 하나씩 읽어 찍고, 선택지나
    조건 점프 코드를 만나면 대본 안의 다른 위치로 건너뜁니다. 점프할 곳은 제어 코드의 인자로 대본 안에 3바이트 주소로
    들어 있습니다.
  </p>
  <Figure caption="제절초 한글패치 대본. 시작 주소 표와 점프 인자가 대본 안 위치를 직접 가리킵니다." max={600}>
