---
import GuideChapter from '../../../../layouts/GuideChapter.astro';
import Deeper from '../../../../components/romhacking/Deeper.astro';
import Figure from '../../../../components/romhacking/Figure.astro';
import CpuStep from '../../../../components/romhacking/CpuStep.astro';
import { SMRPG_PATCH, TOTSUGEKI_PATCH } from '../../../../lib/kr-patches.ts';

const sections = [
  { id: 'names', label: '어셈블리는 바이트에 붙인 이름' },
  { id: 'cards', label: '자주 쓰는 명령 열두 개' },
  { id: 'modes', label: '값과 주소 구별하기' },
  { id: 'branch', label: '분기와 반복' },
  { id: 'subroutine', label: '서브루틴: JSR과 RTS' },
  { id: 'copy', label: '패치에 들어간 코드 실행해 보기' },
  { id: 'in-patch', label: '실제 패치에서' },
  { id: 'try', label: '직접 해 보기' },
];
const references = [
  {
    href: 'https://www.westerndesigncenter.com/wdc/documentation/w65c816s.pdf',
    label: 'WDC, W65C816S 데이터시트',
    note: '명령 표, 주소 지정 방식 24가지, 사이클 수, 인터럽트 순서와 벡터',
  },
  {
    href: 'https://problemkaputt.de/fullsnes.htm#cpumemoryaddressing',
    label: 'fullsnes, CPU Memory Addressing',
    note: '주소 지정 방식과 어셈블러 표기',
  },
  {
    href: 'https://snes.nesdev.org/wiki/65C816',
    label: 'SNESdev Wiki, 65C816',
    note: '명령 요약',
  },
  {
    href: 'https://snes.nesdev.org/wiki/CPU_vectors',
    label: 'SNESdev Wiki, CPU vectors',
    note: 'NMI·IRQ·리셋 벡터 위치',
  },
  {
    href: 'https://wiki.superfamicom.org/65816-reference',
    label: 'SFC Development Wiki, 65816 Reference',
    note: '명령별 바이트 수와 플래그 변화',
  },
];
const cards = [
  { op: 'LDA', verb: 'A에 넣기', ex: 'LDA #$05', text: 'A에 값을 넣습니다. LDX·LDY는 X·Y에 넣습니다.' },
  { op: 'STA', verb: '메모리에 쓰기', ex: 'STA $0A00', text: 'A의 값을 메모리에 적습니다. STX·STY도 있습니다.' },
  { op: 'ADC', verb: '더하기', ex: 'ADC #$05', text: 'A에 더합니다. 올림(C)까지 더하므로 앞에 CLC를 씁니다.' },
  { op: 'INX', verb: '1 늘리기', ex: 'INX', text: 'X를 1 늘립니다. DEX는 1 줄입니다.' },
  { op: 'CMP', verb: '비교하기', ex: 'CMP #$10', text: 'A에서 빼 보기만 하고 결과는 버립니다. 플래그만 바뀝니다.' },
  { op: 'BEQ', verb: '같으면 이동', ex: 'BEQ $8011', text: 'Z가 1이면(0이었거나 같았으면) 그 주소로 갑니다.' },
  { op: 'BNE', verb: '다르면 이동', ex: 'BNE $8006', text: 'Z가 0이면 그 주소로 갑니다. 반복에 씁니다.' },
  { op: 'BRA', verb: '무조건 이동', ex: 'BRA $8005', text: '플래그와 상관없이 갑니다.' },
  { op: 'JSR', verb: '서브루틴 부르기', ex: 'JSR $8012', text: '돌아올 곳을 스택에 적고 서브루틴으로 갑니다.' },
  { op: 'RTS', verb: '서브루틴에서 돌아오기', ex: 'RTS', text: '스택에 적어 둔 곳으로 돌아갑니다.' },
  { op: 'REP', verb: '16비트로 바꾸기', ex: 'REP #$30', text: 'P의 칸을 끕니다. #$20은 A, #$10은 X·Y.' },
  { op: 'SEP', verb: '8비트로 바꾸기', ex: 'SEP #$30', text: 'P의 칸을 켭니다.' },
];
const modes = [
  { name: '즉시값', syntax: 'LDA #$12', bytes: 'A9 12', meaning: '값 $12 자체' },
  { name: '절대', syntax: 'LDA $1234', bytes: 'AD 34 12', meaning: 'DB:$1234에 있는 값' },
  { name: '절대 긴', syntax: 'LDA $7E1234', bytes: 'AF 34 12 7E', meaning: '$7E:1234에 있는 값' },
  { name: '다이렉트 페이지', syntax: 'LDA $12', bytes: 'A5 12', meaning: '$00:(D+$12)에 있는 값' },
  { name: '절대 + X', syntax: 'LDA $1234,X', bytes: 'BD 34 12', meaning: 'DB:$1234 + X' },
  { name: '긴 주소 + X', syntax: 'LDA $7E1234,X', bytes: 'BF 34 12 7E', meaning: '$7E:1234 + X' },
  { name: '간접', syntax: 'LDA ($12)', bytes: 'B2 12', meaning: '$00:(D+$12)에 적힌 2바이트 주소(뱅크는 DB)의 값' },
  { name: '긴 간접', syntax: 'LDA [$12]', bytes: 'A7 12', meaning: '$00:(D+$12)에 적힌 3바이트 주소의 값' },
  { name: '간접 + Y', syntax: 'LDA ($12),Y', bytes: 'B1 12', meaning: '$00:(D+$12)의 2바이트 주소(뱅크는 DB) + Y' },
  { name: '스택 상대', syntax: 'LDA $03,S', bytes: 'A3 03', meaning: 'S + 3에 있는 값' },
  { name: '상대', syntax: 'BNE $8006', bytes: 'D0 FA', meaning: '다음 명령 위치 + 부호 있는 1바이트' },
  {
    name: '블록 이동',
    syntax: 'MVN $80,$7E',
    bytes: '54 7E 80',
    meaning: '뱅크 $80의 X 위치에서 뱅크 $7E의 Y 위치로 C+1바이트 복사',
  },
];
---

<GuideChapter platform="snes" slug="assembly" sections={sections} references={references}>
  <h2 id="names">
    어셈블리는 바이트에 붙인 이름 <span class="layer-badge layer-easy">쉽게</span>
  </h2>
  <p>
    롬 안의 프로그램은 바이트일 뿐입니다. <code>A9 34 12</code>를 보고 바로 뜻을 알기는 어렵습니다. 그래서 바이트마다
    사람이 읽을 이름을 붙여 <code>LDA #$1234</code>처럼 적습니다. 이것이 <strong>어셈블리</strong>입니다. 바이트를
    어셈블리로 바꾸는 도구가 <strong>역어셈블러</strong>, 그 반대가 <strong>어셈블러</strong>입니다.
  </p>
  <Figure caption="명령 하나 = 무엇을 할지(1바이트) + 무엇으로 할지(0-3바이트)" max={600}>
    <svg viewBox="0 0 360 170" role="img" aria-labelledby="op-t op-d">
      <title id="op-t">명령의 구조</title>
      <desc id="op-d">
        A9 34 12에서 A9는 LDA 즉시값 명령, 34 12는 값 $1234를 작은 자리부터 적은 피연산자다. 합쳐서 LDA #$1234다.
      </desc>
      <rect class="dg-accent" x="20" y="16" width="70" height="46" rx="8"></rect>
      <rect class="dg-cool" x="98" y="16" width="70" height="46" rx="8"></rect>
      <rect class="dg-warm" x="176" y="16" width="70" height="46" rx="8"></rect>
      <text class="dg-mono dg-bold" x="55" y="45" text-anchor="middle">
        A9
      </text>
      <text class="dg-mono dg-bold" x="133" y="45" text-anchor="middle">
        34
      </text>
      <text class="dg-mono dg-bold" x="211" y="45" text-anchor="middle">
        12
      </text>
      <text class="dg-small" x="55" y="82" text-anchor="middle">
        명령 바이트
      </text>
      <text class="dg-small" x="55" y="98" text-anchor="middle">
        (옵코드)
      </text>
      <text class="dg-small" x="172" y="82" text-anchor="middle">
        피연산자 $1234
      </text>
      <text class="dg-small" x="172" y="98" text-anchor="middle">
        (작은 자리 먼저)
      </text>
      <path class="dg-arrow" d="M55 104 55 116" marker-end="url(#dg-arrowhead)"></path>
      <path class="dg-arrow" d="M172 104 172 116" marker-end="url(#dg-arrowhead)"></path>
      <text class="dg-mono dg-bold" x="55" y="138" text-anchor="middle">
        LDA
      </text>
      <text class="dg-mono dg-bold" x="172" y="138" text-anchor="middle">
        #$1234
      </text>
      <text class="dg-small" x="55" y="160" text-anchor="middle">
        A에 넣어라
      </text>
      <text class="dg-small" x="172" y="160" text-anchor="middle">
        이 값을
      </text>
      <text class="dg-small" x="268" y="45">
        16비트 A일 때
      </text>
    </svg>
  </Figure>
  <p>
    3장에서 본 것처럼 피연산자 길이는 M·X 설정에 따라 달라지고, 주소는 작은 자리부터 적힙니다(2장). 이 두 가지만
    기억하면 바이트를 손으로도 어셈블리로 바꿀 수 있습니다.
  </p>

  <h2 id="cards">
    자주 쓰는 명령 열두 개 <span class="layer-badge layer-easy">쉽게</span>
  </h2>
  <p>65c816 명령은 90여 개지만, 패치 노트에 나오는 코드 대부분은 아래 열두 개로 읽을 수 있습니다.</p>
  <ul class="op-cards">
    {cards.map(c => (
      <li>
        <p class="op-name">
          <span class="mono">{c.op}</span> <span>{c.verb}</span>
        </p>
        <p class="op-ex mono">{c.ex}</p>
        <p class="op-text">{c.text}</p>
      </li>
    ))}
  </ul>

  <h2 id="modes">
    값과 주소 구별하기 <span class="layer-badge layer-easy">쉽게</span>
  </h2>
  <p>
    같은 <code>LDA</code>라도 뒤에 무엇이 붙느냐에 따라 뜻이 완전히 다릅니다. 이 차이를 <strong>주소 지정 방식</strong>
    이라고 하고, 옵코드 바이트가 방식마다 다릅니다.
  </p>
  <Figure caption="#은 '이 값', #이 없으면 '이 주소에 있는 값', ,X는 '이 주소에서 X만큼 더 간 곳'" max={600}>
    <svg viewBox="0 0 360 250" role="img" aria-labelledby="md-t md-d">
      <title id="md-t">세 가지 주소 지정 방식</title>
      <desc id="md-d">
        LDA #$12는 숫자 $12를 A에 넣는다. LDA $12는 메모리 $12 칸에 있는 값 $7F를 넣는다. LDA $0A00,X는 X가 2일 때 $0A02
        칸의 값을 넣는다.
      </desc>
      <text class="dg-mono dg-bold" x="8" y="26">
        LDA #$12
      </text>
      <path class="dg-arrow" d="M120 21h40" marker-end="url(#dg-arrowhead)"></path>
      <rect class="dg-accent" x="168" y="4" width="70" height="32" rx="6"></rect>
      <text class="dg-mono" x="203" y="25" text-anchor="middle">
        A=$12
      </text>
      <text class="dg-small" x="248" y="25">
        값 그대로
      </text>

      <text class="dg-mono dg-bold" x="8" y="92">
        LDA $12
      </text>
      <rect class="dg-cell" x="120" y="60" width="54" height="50" rx="6"></rect>
      <text class="dg-small" x="147" y="76" text-anchor="middle">
        $12 칸
      </text>
      <text class="dg-mono" x="147" y="99" text-anchor="middle">
        7F
      </text>
      <path class="dg-arrow" d="M178 87h18" marker-end="url(#dg-arrowhead)"></path>
      <rect class="dg-accent" x="200" y="70" width="70" height="32" rx="6"></rect>
      <text class="dg-mono" x="235" y="91" text-anchor="middle">
        A=$7F
      </text>
      <text class="dg-small" x="280" y="91">
        칸 안의 값
      </text>

      <text class="dg-mono dg-bold" x="8" y="166">
        LDA $0A00,X
      </text>
      <text class="dg-small" x="8" y="186">
        X = 2일 때
      </text>
      {['$0A00', '$0A01', '$0A02', '$0A03'].map((a, i) => (
        <>
          <rect class={i === 2 ? 'dg-warm' : 'dg-cell'} x={120 + i * 58} y="150" width="54" height="50" rx="6" />
          <text class="dg-small" x={147 + i * 58} y="166" text-anchor="middle">
            {a}
          </text>
          <text class="dg-mono" x={147 + i * 58} y="190" text-anchor="middle">
            {['F3', '08', 'B5', '06'][i]}
          </text>
        </>
      ))}
      <path class="dg-arrow dg-dash" d="M147 214 Q205 236 263 206" marker-end="url(#dg-arrowhead)"></path>
      <text class="dg-small" x="205" y="246" text-anchor="middle">
        +X(2칸)
      </text>
    </svg>
  </Figure>
  <p>
    <code>#</code> 하나 차이로 "숫자 $12"와 "$12번 칸에 든 것"이 갈립니다. <code>#</code> 뒤의 값을 즉시값이라고 합니다.
    어셈블리를 읽을 때 가장 먼저 확인할 것이 이 <code>#</code>입니다. <code>,X</code>는 표의 몇 번째 칸을 읽을 때
    씁니다. X를 늘려 가며 같은 명령을 되풀이하면 표를 차례로 훑을 수 있습니다.
  </p>

  <h2 id="branch">
    분기와 반복 <span class="layer-badge layer-easy">쉽게</span>
  </h2>
  <p>
    CPU는 "만약"을 직접 묻지 못합니다. 대신 명령을 실행할 때마다 결과를 P의 플래그에 남기고, 분기 명령이 그 플래그를
    보고 갈 곳을 정합니다. <code>DEX</code>가 X를 0으로 만들면 Z 플래그가 켜지고, 바로 뒤의 <code>BNE</code>는 Z가 꺼져
    있을 때만 앞쪽 명령으로 되돌아갑니다. 이렇게 "세 번 반복"이 만들어집니다.
  </p>
  <Figure caption="DEX와 BNE로 만드는 반복. 분기는 바로 앞 명령이 남긴 플래그를 봅니다." max={520}>
    <svg viewBox="0 0 360 290" role="img" aria-labelledby="lp-t lp-d">
      <title id="lp-t">반복 흐름</title>
      <desc id="lp-d">
        X에 3을 넣고 A에 5를 더한 뒤 X를 1 줄인다. X가 0이 아니면 더하기로 돌아가고, 0이면 아래로 내려가 결과를 적는다.
      </desc>
      <rect class="dg-cell" x="90" y="8" width="180" height="36" rx="8"></rect>
      <text class="dg-mono" x="180" y="31" text-anchor="middle">
        LDX #$03
      </text>
      <path class="dg-arrow" d="M180 44v18" marker-end="url(#dg-arrowhead)"></path>
      <rect class="dg-cool" x="90" y="66" width="180" height="36" rx="8"></rect>
      <text class="dg-mono" x="180" y="89" text-anchor="middle">
        CLC / ADC #$05
      </text>
      <path class="dg-arrow" d="M180 102v18" marker-end="url(#dg-arrowhead)"></path>
      <rect class="dg-cool" x="90" y="124" width="180" height="36" rx="8"></rect>
      <text class="dg-mono" x="180" y="147" text-anchor="middle">
        DEX
      </text>
      <path class="dg-arrow" d="M180 160v18" marker-end="url(#dg-arrowhead)"></path>
      <path class="dg-warm" d="M180 182 250 208 180 234 110 208Z"></path>
      <text class="dg-mono" x="180" y="213" text-anchor="middle">
        BNE
      </text>
      <path class="dg-arrow" d="M250 208H300V84H274" marker-end="url(#dg-arrowhead)"></path>
      <text class="dg-small" x="306" y="150">
        X≠0
      </text>
      <text class="dg-small" x="306" y="166">
        (Z=0)
      </text>
      <path class="dg-arrow" d="M180 234v18" marker-end="url(#dg-arrowhead)"></path>
      <text class="dg-small" x="190" y="250">
        X=0 (Z=1)
      </text>
      <rect class="dg-accent" x="90" y="256" width="180" height="30" rx="8"></rect>
      <text class="dg-mono" x="180" y="276" text-anchor="middle">
        STA $10
      </text>
    </svg>
  </Figure>

  <h2 id="subroutine">
    서브루틴: JSR과 RTS <span class="layer-badge layer-easy">쉽게</span>
  </h2>
  <p>
    여러 곳에서 쓰는 코드는 한 군데에 두고 불러 씁니다. 이것이 <strong>서브루틴</strong>입니다. <code>JSR</code>은
    "다녀올 테니 돌아올 곳을 적어 둬"라며 PC 값을 <strong>스택</strong>에 쌓고 서브루틴으로 갑니다. 서브루틴 끝의{' '}
    <code>RTS</code>는 스택 맨 위에 적힌 곳을 꺼내 돌아갑니다.
  </p>
  <Figure caption="스택은 접시 더미입니다. 나중에 올린 것을 먼저 꺼냅니다." max={560}>
    <svg viewBox="0 0 360 200" role="img" aria-labelledby="st-t st-d">
      <title id="st-t">JSR과 RTS의 스택</title>
      <desc id="st-d">
        JSR $8012를 실행하면 돌아올 곳 $8010의 위 바이트 80과 아래 바이트 10이 차례로 스택에 쌓이고 S가 $1FFD로
        내려간다. RTS는 두 바이트를 꺼내 1을 더한 $8011로 돌아간다.
      </desc>
      <text class="dg-small" x="8" y="16">
        JSR $8012 실행 뒤 스택
      </text>
      <rect class="dg-cell" x="8" y="26" width="120" height="34" rx="4"></rect>
      <text class="dg-mono" x="20" y="48">
        $1FFF
      </text>
      <text class="dg-mono dg-bold" x="104" y="48" text-anchor="middle">
        80
      </text>
      <rect class="dg-cell" x="8" y="62" width="120" height="34" rx="4"></rect>
      <text class="dg-mono" x="20" y="84">
        $1FFE
      </text>
      <text class="dg-mono dg-bold" x="104" y="84" text-anchor="middle">
        10
      </text>
      <rect class="dg-paper" x="8" y="98" width="120" height="34" rx="4" stroke-dasharray="4 3"></rect>
      <text class="dg-mono" x="20" y="120">
        $1FFD
      </text>
      <text class="dg-small" x="140" y="120">
        ← S (다음에 쌓을 자리)
      </text>
      <text class="dg-small" x="140" y="48">
        먼저 쌓은 위 바이트
      </text>
      <text class="dg-small" x="140" y="84">
        나중에 쌓은 아래 바이트
      </text>
      <rect class="dg-accent" x="8" y="150" width="344" height="40" rx="8"></rect>
      <text class="dg-text" x="18" y="175">
        RTS: 10, 80을 꺼내 $8010 + 1 = $8011로
      </text>
    </svg>
  </Figure>
  <p>
    스택은 주소가 큰 쪽에서 작은 쪽으로 쌓이고, 쌓을 때마다 S가 줄어듭니다. 돌아올 곳으로 JSR 명령 자신의 마지막 바이트
    주소($8010)를 적어 두고, RTS가 1을 더해 다음 명령($8011)으로 가는 것이 65c816의 방식입니다. 아래 「명령 한 줄씩
    실행하기」에서 JSR 전후로 메모리 <code>$7E:1FFE</code>·<code>$7E:1FFF</code>와 S가 바뀌는 것을 확인해 보세요.
  </p>
  <CpuStep program="loop" />

  <h2 id="copy">
    패치에 들어간 코드 실행해 보기 <span class="layer-badge layer-easy">쉽게</span>
  </h2>
  <p>
    이제 실제 패치에 들어간 코드를 읽을 수 있습니다. 돌격편 v1.2는 엔딩 화면에 글자를 띄우려고 "롬의 문자열을 0이 나올
    때까지 WRAM으로 복사하는" 짧은 루프를 넣었습니다. 아래는 그 루프를 줄인 것입니다. 16비트 모드라 한 번에 글자
    하나(2바이트)를 옮기고, X를 두 번 늘려 다음 글자로 갑니다.
  </p>
  <CpuStep program="copy" />

  <Deeper title="주소 지정 방식 전부, 스택과 인터럽트, 사이클">
    <h3>주소 지정 방식</h3>
    <p>
      데이터시트는 24가지로 나누지만, 실제로 자주 만나는 것은 아래와 같습니다. 바이트는 16비트 A가 아닌 경우의 예입니다.
    </p>
    <div class="table-scroll" tabindex="0">
      <table>
        <thead>
          <tr>
            <th scope="col">방식</th>
            <th scope="col">표기</th>
            <th scope="col">바이트</th>
            <th scope="col">읽는 곳</th>
          </tr>
        </thead>
        <tbody>
          {modes.map(m => (
            <tr>
              <th scope="row">{m.name}</th>
              <td>
                <code>{m.syntax}</code>
              </td>
              <td>
                <code>{m.bytes}</code>
              </td>
              <td>{m.meaning}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>
      "긴"(long) 방식은 3바이트 주소라 DB와 상관없이 어느 뱅크든 가리킵니다. 분기 명령의 상대 주소는 1바이트 2의 보수라
      −128–+127바이트까지만 갈 수 있고, <code>BRL</code>은 2바이트로 뱅크 안 어디든 갑니다.
    </p>
    <h3>간접 주소: 메모리에 적힌 주소 따라가기</h3>
    <p>
      <code>LDA ($12)</code>는 다이렉트 페이지 <code>$00:(D+$12)</code>와 그다음 칸에서 2바이트 주소를 꺼내고, 그 주소에
      DB를 뱅크로 붙인 곳의 값을 읽습니다. 대사 포인터처럼 "표에서 꺼낸 주소의 내용"을 읽을 때 씁니다.{' '}
      <code>[$12]</code>는 뱅크까지 3바이트를 꺼내고, <code>($12),Y</code>는 꺼낸 주소에 Y를 더합니다.
    </p>
    <Figure caption="LDA ($12): D=0, DB=$7E일 때 $12·$13에 적힌 주소를 따라가 값을 읽습니다." max={560}>
      <svg viewBox="0 0 360 170" role="img" aria-labelledby="ind-t ind-d">
        <title id="ind-t">간접 주소</title>
        <desc id="ind-d">
          $00:0012와 $00:0013에 00, 90이 있어 주소 $9000이 된다. 뱅크 DB $7E를 붙인 $7E:9000에 있는 값 42가 A에
          들어간다.
        </desc>
        <rect class="dg-cool" x="8" y="12" width="70" height="44" rx="6"></rect>
        <rect class="dg-warm" x="82" y="12" width="70" height="44" rx="6"></rect>
        <text class="dg-small" x="43" y="28" text-anchor="middle">
          $00:0012
        </text>
        <text class="dg-mono dg-bold" x="43" y="48" text-anchor="middle">
          00
        </text>
        <text class="dg-small" x="117" y="28" text-anchor="middle">
          $00:0013
        </text>
        <text class="dg-mono dg-bold" x="117" y="48" text-anchor="middle">
          90
        </text>
        <path class="dg-arrow" d="M160 34h32" marker-end="url(#dg-arrowhead)"></path>
        <rect class="dg-cell" x="200" y="12" width="152" height="44" rx="6"></rect>
        <text class="dg-text" x="276" y="40" text-anchor="middle">
          주소 $9000
        </text>
        <path class="dg-arrow" d="M276 58v26" marker-end="url(#dg-arrowhead)"></path>
        <text class="dg-small" x="268" y="76" text-anchor="end">
          DB $7E를 붙임
        </text>
        <rect class="dg-accent" x="200" y="90" width="152" height="44" rx="6"></rect>
        <text class="dg-small" x="276" y="106" text-anchor="middle">
          $7E:9000
        </text>
        <text class="dg-mono dg-bold" x="276" y="126" text-anchor="middle">
          42
        </text>
        <text class="dg-text" x="8" y="118">
          → A = $42
        </text>
        <text class="dg-small" x="8" y="160">
          포인터도 작은 자리 먼저(2장): 00 90 → $9000
        </text>
      </svg>
    </Figure>
    <h3>블록 이동 MVN·MVP</h3>
    <p>
      <code>MVN</code>은 X가 가리키는 곳에서 Y가 가리키는 곳으로 C(16비트 A) + 1바이트를 한꺼번에 복사합니다.
      어셈블리로는 <code>MVN $80,$7E</code>처럼 "보내는 뱅크, 받는 뱅크" 순서로 적지만, 바이트로는 <code>54 7E 80</code>
      처럼 받는 뱅크가 먼저 옵니다. 끝나면 DB가 받는 뱅크로 바뀌어 있으니 뒤 코드가 DB에 기대고 있다면 조심해야 합니다.{' '}
      <code>MVP</code>는 뒤에서부터 복사합니다.
    </p>
    <h3>BCC·BCS는 부호 없는 비교</h3>
    <p>
      <code>CMP</code> 뒤의 <code>BCC</code>("작으면")·<code>BCS</code>("크거나 같으면")는 값을 0–255(16비트면
      0–65535)의 부호 없는 수로 비교합니다. <code>$FF</code>는 −1이 아니라 255로 취급되어 <code>$01</code>보다 큽니다.
      부호 있는 수로 비교하려면 N·V 플래그를 함께 봐야 합니다.
    </p>
    <h3>스택 더 보기</h3>
    <ul>
      <li>
        <code>PHA</code>/<code>PLA</code>, <code>PHX</code>/<code>PLX</code>는 레지스터를 잠깐 맡기고 되찾습니다.
      </li>
      <li>
        <code>PHP</code>/<code>PLP</code>는 P를 맡깁니다. 서브루틴이 REP·SEP로 폭을 바꾼 뒤 원래대로 돌려놓을 때 씁니다.
      </li>
      <li>
        <code>JSL</code>/<code>RTL</code>은 다른 뱅크로 다녀오는 쌍입니다. PB까지 3바이트를 쌓습니다. JSR로 간 곳에서
        RTL로 돌아오면 스택이 어긋나 게임이 멈춥니다.
      </li>
      <li>
        <code>PHK</code>/<code>PLB</code>는 "지금 프로그램 뱅크(PB)를 데이터 뱅크(DB)로" 맞출 때 자주 짝지어 나옵니다.
      </li>
    </ul>
    <h3>인터럽트와 NMI</h3>
    <p>
      인터럽트는 CPU가 하던 일을 잠깐 멈추고 정해진 루틴을 실행하게 하는 신호입니다. 슈퍼 패미컴에서 가장 중요한 것은
      화면을 다 그리고 다음 화면을 그리기 전(수직 귀선 기간)에 오는 <strong>NMI</strong>입니다. CPU는 PB, PC, P를 스택에
      쌓고 네이티브 모드 벡터 <code>$00:FFEA</code>에 적힌 주소로 갑니다. 단, 게임이 레지스터 <code>$4200</code>의 비트
      7을 켜 두었을 때만 NMI가 옵니다. 루틴은 <code>RTI</code>로 끝나 원래 자리로 돌아갑니다. 화면 데이터는 이 짧은
      시간에만 안전하게 바꿀 수 있어서, 글자 그림을 VRAM에 올리는 코드를 여기에 끼워 넣는 일이 많습니다(6·7장).
    </p>
    <h3>사이클</h3>
    <p>
      명령마다 걸리는 사이클 수가 다릅니다. 예를 들어 <code>LDA #</code>는 2사이클이고 16비트 A면 1사이클이 더 듭니다.
      다만 슈퍼 패미컴에서는 한 사이클의 길이가 읽는 곳에 따라 기준 클록(21.477MHz)의 6·8·12배로 달라서, 사이클 수만으로
      시간이 정해지지는 않습니다. 같은 코드도 FastROM 영역에서 더 빨리 돕니다. NMI 안처럼 시간이 빠듯한 곳에 코드를
      더하면 화면이 깨질 수 있으니, 데이터시트의 사이클 표와 영역별 속도로 대략의 비용을 셈해 둡니다.
    </p>
  </Deeper>

  <h2 id="in-patch">
    실제 패치에서 <span class="layer-badge layer-patch">실제 패치에서</span>
  </h2>
  <h3>두 바이트로 디버그 메뉴 열기(돌격편)</h3>
  <p>
    <a href={`${TOTSUGEKI_PATCH.path}/`}>돌격편</a>은 전원을 켜면 도는 루프 안에 개발자용 디버그 메뉴를 부르는 코드가
    남아 있고, 바로 앞의 <code>BRA</code>가 늘 그것을 건너뜁니다.
  </p>
  <pre tabindex="0"><code>$80:8061  80 04        BRA $8067     ; 다음 명령에서 4바이트 앞으로 건너뜀
$80:8063  22 B0 86 82  JSL $8286B0   ; 디버그 메뉴 (늘 건너뜀)
$80:8067  22 00 80 82  JSL $828000   ; 제품판이 가는 곳</code></pre>
  <p>
    <code>80 04</code>를 아무것도 안 하는 명령 <code>EA EA</code>(NOP NOP)로 바꾸면 건너뛰지 않고 메뉴가 열립니다. BRA의
    04는 "다음 명령 위치($8063)에서 4바이트 더"라서 $8067입니다. 이 메뉴의 시나리오 선택 기능이 패치를 확인하는 바탕이
    됐습니다.
  </p>
  <h3>한 바이트로 전투 디버그 메뉴 열기(슈퍼 마리오 RPG)</h3>
  <pre tabindex="0"><code>$C1:06A9  AF AE FF 00  LDA $00FFAE   ; 어떤 값을 읽어
$C1:06AD  05 80        ORA $80       ; $80 칸과 합친 결과가
$C1:06AF  F0 01        BEQ $C106B2   ; 0이면 RTS를 건너뛰어 메뉴로
$C1:06B1  60           RTS           ; 아니면 그냥 돌아감</code></pre>
  <p>
    제품판에서는 결과가 0이 아니라 늘 <code>RTS</code>로 돌아갑니다. <code>F0</code>(BEQ)을 <code>80</code>(BRA)으로
    바꾸면 조건 없이 RTS를 건너뛰어 <a href={`${SMRPG_PATCH.path}/`}>슈퍼 마리오 RPG</a>의 전투 중 Start로 메뉴가
    열립니다. 롬 해킹의 많은 일이 이렇게 "분기 하나 바꾸기"입니다.
  </p>
  <h3>줄바꿈 판단(돌격편)</h3>
  <pre tabindex="0"><code>$B7:9846  CLC / ADC $0208     ; 이번 글자 폭 + 지금 x 위치
$B7:984A  CMP $020A           ; 창 폭과 비교
$B7:984D  BEQ / BCC $B79890   ; 같거나 작으면 그대로 그림
$B7:9851  INC $32 ×2          ; 크면 다음 줄로</code></pre>
  <p>
    <code>CMP</code> 뒤의 <code>BCC</code>는 "C가 0이면", 곧 "A가 비교한 값보다 작으면" 갑니다. 그래서 글자 폭 합이 창
    폭과 같은 줄까지는 한 줄에 들어갑니다. 한글 번역은 이 규칙대로 모든 줄의 폭을 미리 계산해 넘치는 줄이 없게 했습니다.
  </p>

  <h2 id="try">
    직접 해 보기 <span class="layer-badge layer-try">직접 해 보기</span>
  </h2>
  <p>위의 두 코드는 툴킷 역어셈블러로 그대로 볼 수 있습니다. 분기 주소는 뱅크까지 붙여 24비트로 나옵니다.</p>
  <pre tabindex="0"><code>$ krpatch snes dis totsugeki.sfc 808061 3 --mapper lorom
80:8061  80 04        BRA $808067
80:8063  22 b0 86 82  JSL $8286B0
80:8067  22 00 80 82  JSL $828000

$ krpatch snes dis smrpg.sfc C106A9 4 --mapper sa1
C1:06A9  af ae ff 00  LDA $00FFAE
C1:06AD  05 80        ORA $80
C1:06AF  f0 01        BEQ $C106B2
C1:06B1  60           RTS</code></pre>
  <p>
    아는 명령이 나오는 곳에서 시작해 몇십 줄씩 읽어 보세요. 모르는 옵코드가 연달아 나오면 폭(M·X)이 틀렸거나 코드가 아닌
    데이터를 읽고 있는 것입니다.
  </p>
</GuideChapter>

