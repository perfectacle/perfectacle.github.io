      </text>
      <rect class="dg-cell" x="8" y="186" width="150" height="30" rx="6"></rect>
      <text class="dg-mono" x="16" y="206">
        A77B NOP
      </text>
      <rect class="dg-cell" x="8" y="220" width="150" height="30" rx="6"></rect>
      <text class="dg-mono" x="16" y="240">
