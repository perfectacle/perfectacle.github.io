import { KAKUSEI_PATCH, OTOGIRISOU_PATCH, SMRPG_PATCH, TOTSUGEKI_PATCH } from '../../../../lib/kr-patches.ts';

const sections = [
  { id: 'why', label: '코드 사이에 끼워 넣을 수는 없다' },
  { id: 'jump', label: '다른 뱅크의 코드를 불렀다 돌아오기: JSL과 RTL' },
  { id: 'restore', label: '덮어쓴 명령 다시 실행하기' },
  { id: 'preserve', label: '레지스터와 플래그를 그대로 돌려주기' },
  { id: 'space', label: '새 코드를 둘 빈 공간' },
  { id: 'in-patch', label: '실제 패치에서' },
  { id: 'try', label: '직접 해 보기' },
];
const references = [
  {
    href: 'https://www.westerndesigncenter.com/wdc/documentation/w65c816s.pdf',
    label: 'WDC, W65C816S 데이터시트',
    note: 'JSL·RTL·JML·JSR·RTS가 스택에 쌓는 바이트와 돌아오는 주소, NOP',
  },
  {
    href: 'https://problemkaputt.de/fullsnes.htm#cpumemoryaddressing',
    label: 'fullsnes, CPU Memory Addressing',
    note: '같은 뱅크 안 주소와 긴 주소(뱅크 포함) 표기',
  },
  {
    href: 'https://snes.nesdev.org/wiki/65C816',
    label: 'SNESdev Wiki, 65C816',
    note: '명령 요약과 레지스터 폭(M·X)',
  },
  {
    href: 'https://github.com/RPGHacker/asar',
    label: 'asar',
    note: '네 패치가 쓴 65c816 어셈블러. org로 덮어쓸 주소를 정하고 assert로 범위를 확인합니다',
