---
import ListPage from '../components/ListPage.astro';
import { getPosts, paginate, SITE, ymd } from '../lib/posts.ts';

const posts = await getPosts();
const pages = paginate(posts);
const oldest = posts.at(-1);
const since = oldest && ymd(oldest.data.date).y;
---

<ListPage posts={pages[0]} base="/" current={1} total={pages.length}>
  <header class="intro">
    <h1>{SITE.title}</h1>
    <p class="lede">{SITE.subtitle}</p>
    <p class="stats">
      글 {posts.length}개{since && ` · ${since}년부터`}
    </p>
  </header>
  <p class="section-label recent">최근 글</p>
</ListPage>

<style>
  .intro {
    position: relative;
    padding: 8px 0 28px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }
  h1 {
    margin: 0;
    font-size: 2rem;
    line-height: 1.25;
    letter-spacing: -0.03em;
  }
  .lede {
    margin: 8px 0 2px;
    color: var(--fg);
    font-size: 1.02rem;
  }
  .stats {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.9rem;
  }
  .recent {
    margin: 24px 0 0;
  }
  @media (max-width: 640px) {
    h1 {
      font-size: 1.6rem;
    }
    .intro {
      padding: 0 0 20px;
    }
    .recent {
      margin-top: 18px;
    }
  }
</style>
