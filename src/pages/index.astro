---
import ListPage from '../components/ListPage.astro';
import { categoryPath, getCategoryTree, getPosts, paginate, SITE, ymd } from '../lib/posts.ts';

const posts = await getPosts();
const pages = paginate(posts);
const oldest = posts.at(-1);
const since = oldest && ymd(oldest.data.date).y;
const categories = (await getCategoryTree()).toSorted((a, b) => b.posts.length - a.posts.length);
---

<ListPage posts={pages[0]} base="/" current={1} total={pages.length}>
  <header class="intro">
    <h1>{SITE.title}</h1>
    <p class="lede">{SITE.subtitle}</p>
    <p class="stats">
      글 {posts.length}개{since && ` · ${since}년부터`}
    </p>
    <nav aria-label="카테고리 바로가기">
      <ul class="chips">
        {categories.map(c => (
          <li>
            <a class="chip" href={categoryPath(c.path)}>
              {c.name} <span class="count">{c.posts.length}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </header>
  <p class="section-label recent">최근 글</p>
</ListPage>

<style>
  .intro {
    position: relative;
    padding: 8px 0 28px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }
  h1 {
    margin: 0;
    font-size: 2rem;
    line-height: 1.25;
    letter-spacing: -0.03em;
  }
  .lede {
    margin: 8px 0 2px;
    color: var(--fg);
    font-size: 1.02rem;
  }
  .stats {
    margin: 0 0 16px;
    color: var(--fg-muted);
  }
  .count {
    margin-left: 4px;
    font-family: var(--font-mono);
    font-size: 0.92em;
  }
  .stats {
    font-size: 0.9rem;
  }
  .recent {
    margin: 24px 0 0;
  }
  @media (max-width: 640px) {
    h1 {
      font-size: 1.6rem;
    }
    .intro {
      padding: 0 0 20px;
    }
    .recent {
      margin-top: 18px;
    }
    /* One swipeable row instead of four wrapped rows pushing the posts below the fold. */
    .intro .chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: -16px;
      /* Room for the focus ring, which the scroll container would otherwise clip. */
      padding: 3px 16px;
    }
    .intro .chips li {
      flex: none;
    }
  }
</style>
