---
import Base from '../layouts/Base.astro';
---

<Base title="검색">
  <div class="container">
    <h1>검색</h1>
    <template data-pagefind>
      <!-- Separate from the header modal's "default" instance, which would otherwise receive the results. -->
      <pagefind-input instance="page"></pagefind-input>
      <pagefind-summary instance="page"></pagefind-summary>
      <pagefind-results instance="page"></pagefind-results>
    </template>
    <noscript>
      <p class="muted">검색하려면 JavaScript를 켜 주세요.</p>
    </noscript>
  </div>
  <script is:inline type="module">
    // Shareable result links: /search/?q=...
    const q = new URLSearchParams(location.search).get('q');
    document.addEventListener('pagefind:ready', () => {
      if (q) window.PagefindComponents.getInstanceManager().getInstance('page').triggerSearch(q);
    });
  </script>
</Base>

<style>
  h1 {
    margin: 0 0 20px;
    font-size: 1.9rem;
  }
</style>
